<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>IP 관리 대시보드</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>
<body>
  <nav class="navbar navbar-dark bg-dark">
    <div class="container">
      <span class="navbar-brand">관리자 대시보드</span>
      <div>
        <a href="/admin/agreed-ips" class="btn btn-sm btn-outline-light">약관 동의 IP</a>
        <a href="/admin/voted-ips" class="btn btn-sm btn-outline-light">투표 IP</a>
        <a href="/" class="btn btn-sm btn-light">홈으로</a>
      </div>
    </div>
  </nav>

  <div class="container mt-4">
    <h1>IP 수집 통계</h1>
    
    <!-- 전체 통계 카드 -->
    <div class="row mt-4">
      <div class="col-md-3">
        <div class="card text-center">
          <div class="card-body">
            <h5 class="card-title">약관 동의 IP</h5>
            <h2 class="text-primary"><%= agreeIPCount %></h2>
            <small class="text-muted">고유 IP</small>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card text-center">
          <div class="card-body">
            <h5 class="card-title">총 동의 수</h5>
            <h2 class="text-info"><%= totalAgrees %></h2>
            <small class="text-muted">중복 포함</small>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card text-center">
          <div class="card-body">
            <h5 class="card-title">투표 IP</h5>
            <h2 class="text-success"><%= voteIPCount %></h2>
            <small class="text-muted">고유 IP</small>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card text-center">
          <div class="card-body">
            <h5 class="card-title">총 투표 수</h5>
            <h2 class="text-warning"><%= totalVotes %></h2>
            <small class="text-muted">중복 포함</small>
          </div>
        </div>
      </div>
    </div>

    <!-- IP별 활동 통계 -->
    <div class="card mt-4">
      <div class="card-header">
        <h3>IP별 활동 통계</h3>
      </div>
      <div class="card-body">
        <table class="table table-striped">
          <thead>
            <tr>
              <th>IP 주소</th>
              <th>약관 동의</th>
              <th>투표</th>
              <th>마지막 활동</th>
              <th>상세</th>
            </tr>
          </thead>
          <tbody>
            <% ipStats.forEach(stat => { %>
              <tr>
                <td><%= stat._id %></td>
                <td><%= stat.agreeCount %>회</td>
                <td><%= stat.voteCount %>회</td>
                <td><%= new Date(stat.lastActivity).toLocaleString('ko-KR') %></td>
                <td>
                  <a href="/admin/ip/<%= stat._id %>" class="btn btn-sm btn-primary">보기</a>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- 최근 활동 -->
    <div class="card mt-4">
      <div class="card-header">
        <h3>최근 활동 (100개)</h3>
      </div>
      <div class="card-body">
        <table class="table table-sm">
          <thead>
            <tr>
              <th>시간</th>
              <th>IP</th>
              <th>활동</th>
              <th>여론조사</th>
            </tr>
          </thead>
          <tbody>
            <% recentActivities.forEach(activity => { %>
              <tr>
                <td><%= new Date(activity.timestamp).toLocaleString('ko-KR') %></td>
                <td>
                  <a href="/admin/ip/<%= activity.ip %>"><%= activity.ip %></a>
                </td>
                <td>
                  <% if (activity.action === 'agree_terms') { %>
                    <span class="badge bg-info">약관 동의</span>
                  <% } else { %>
                    <span class="badge bg-success">투표</span>
                  <% } %>
                </td>
                <td>
                  <% if (activity.pollId) { %>
                    <a href="/polls/<%= activity.pollId._id %>"><%= activity.pollId.title %></a>
                  <% } else { %>
                    -
                  <% } %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</body>
</html>