<style>
  .consents-container {
    max-width: 1200px;
    margin: 0 auto;
  }
  
  .page-header {
    background: var(--card-bg);
    border-radius: 20px;
    padding: 30px 40px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.2);
    margin-bottom: 30px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  
  .page-title {
    font-size: 2rem;
    font-weight: 800;
    color: var(--text-color);
    margin: 0;
  }
  
  .back-btn {
    padding: 12px 25px;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    border: none;
    border-radius: 50px;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.3s ease;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  
  .back-btn:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 20px rgba(102, 126, 234, 0.4);
    color: white;
  }
  
  .consents-card {
    background: var(--card-bg);
    border-radius: 20px;
    padding: 40px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.2);
  }
  
  .consents-table {
    width: 100%;
    border-collapse: collapse;
  }
  
  .consents-table thead {
    background: linear-gradient(135deg, rgba(102, 126, 234, 0.1) 0%, rgba(118, 75, 162, 0.1) 100%);
  }
  
  .consents-table th {
    padding: 20px;
    text-align: left;
    font-weight: 700;
    color: var(--text-color);
    font-size: 1rem;
    border-bottom: 2px solid var(--border-color);
  }
  
  .consents-table td {
    padding: 20px;
    border-bottom: 1px solid var(--border-color);
    color: var(--text-color);
  }
  
  .consents-table tr:hover {
    background: rgba(102, 126, 234, 0.05);
  }
  
  .ip-badge {
    display: inline-block;
    padding: 6px 15px;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    border-radius: 20px;
    font-weight: 600;
    font-size: 0.9rem;
  }
  
  .region-info {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  
  .country-flag {
    font-size: 1.5rem;
  }
  
  .empty-state {
    text-align: center;
    padding: 60px 20px;
    color: var(--secondary-text);
  }
  
  .empty-icon {
    font-size: 4rem;
    margin-bottom: 20px;
  }
  
  @media (max-width: 768px) {
    .consents-table {
      display: block;
      overflow-x: auto;
    }
    
    .page-header {
      flex-direction: column;
      gap: 15px;
    }
  }
</style>

<div class="consents-container">
  <div class="page-header">
    <h1 class="page-title">🔒 IP 동의 목록</h1>
    <a href="/admin" class="back-btn">
      <span>←</span>
      <span>대시보드로 돌아가기</span>
    </a>
  </div>

  <div class="consents-card">
    <% if (consents.length > 0) { %>
      <table class="consents-table">
        <thead>
          <tr>
            <th>번호</th>
            <th>IP 주소</th>
            <th>지역</th>
            <th>동의 날짜</th>
          </tr>
        </thead>
        <tbody>
          <% consents.forEach((consent, index) => { %>
            <tr>
              <td><%= index + 1 %></td>
              <td>
                <span class="ip-badge"><%= consent.ip %></span>
              </td>
              <td>
                <div class="region-info">
                  <span class="country-flag">
                    <%= consent.region.country === 'KR' ? '🇰🇷' : '🌍' %>
                  </span>
                  <span>
                    <%= consent.region.country %> 
                    <% if (consent.region.city !== 'Unknown') { %>
                      - <%= consent.region.city %>
                    <% } %>
                  </span>
                </div>
              </td>
              <td>
                <%= new Date(consent.consentDate).toLocaleString('ko-KR', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                  hour: '2-digit',
                  minute: '2-digit'
                }) %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    <% } else { %>
      <div class="empty-state">
        <div class="empty-icon">📭</div>
        <h3>아직 동의한 IP가 없습니다</h3>
        <p>사용자가 약관에 동의하면 여기에 표시됩니다.</p>
      </div>
    <% } %>
  </div>
</div>