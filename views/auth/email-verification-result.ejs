<!DOCTYPE html>
<html>
<head>
    <title><%= title %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        .verification-container {
            max-width: 500px;
            margin: 100px auto;
            text-align: center;
        }
        .success-icon {
            font-size: 64px;
            color: #28a745;
            margin-bottom: 20px;
        }
        .fail-icon {
            font-size: 64px;
            color: #dc3545;
            margin-bottom: 20px;
        }
    </style>
    
    <% if (success && autoRedirect) { %>
    <script>
        // 3초 후 자동 이동
        setTimeout(() => {
            window.location.href = '/polls';
        }, 3000);
    </script>
    <% } %>
</head>
<body>
    <div class="verification-container">
        <% if (success) { %>
            <div class="success-icon">✅</div>
            <h2 class="mb-3">이메일 인증 완료!</h2>
            <p class="text-muted"><%= message %></p>
            <% if (username) { %>
                <p><strong><%= username %></strong>님, 환영합니다!</p>
            <% } %>
            <div class="mt-4">
                <a href="/polls" class="btn btn-primary">여론조사 보러가기</a>
            </div>
            <p class="text-muted mt-3" style="font-size: 14px;">
                3초 후 자동으로 이동합니다...
            </p>
        <% } else { %>
            <div class="fail-icon">❌</div>
            <h2 class="mb-3">인증 실패</h2>
            <p class="text-danger"><%= message %></p>
            <div class="mt-4">
                <a href="/auth/register" class="btn btn-secondary">다시 가입하기</a>
                <a href="/auth/login" class="btn btn-primary">로그인</a>
            </div>
        <% } %>
    </div>
</body>
</html>