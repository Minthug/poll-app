<div class="container">
    <div class="verification-container" style="max-width: 500px; margin: 100px auto; text-align: center;">
        <% if (locals.success) { %>
            <div class="success-icon" style="font-size: 64px; color: #28a745; margin-bottom: 20px;">✅</div>
            <h2 class="mb-3">이메일 인증 완료!</h2>
            <p class="text-muted"><%= message %></p>
            <% if (locals.username) { %>
                <p><strong><%= username %></strong>님, 환영합니다!</p>
            <% } %>
            <div class="mt-4">
                <a href="/polls" class="btn btn-primary">여론조사 보러가기</a>
            </div>
            <p class="text-muted mt-3" style="font-size: 14px;">
                3초 후 자동으로 이동합니다...
            </p>
            
            <% if (locals.autoRedirect) { %>
            <script>
                setTimeout(() => {
                    window.location.href = '/polls';
                }, 3000);
            </script>
            <% } %>
            
        <% } else { %>
            <div class="fail-icon" style="font-size: 64px; color: #dc3545; margin-bottom: 20px;">❌</div>
            <h2 class="mb-3">인증 실패</h2>
            <p class="text-danger"><%= message %></p>
            <div class="mt-4">
                <a href="/auth/register" class="btn btn-secondary">다시 가입하기</a>
                <a href="/auth/login" class="btn btn-primary">로그인</a>
            </div>
        <% } %>
    </div>
</div>