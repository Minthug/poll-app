<style>
  /* 회원가입 페이지 전용 스타일 */
  .layout-full-width {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: calc(100vh - 100px);
  }
  
  .auth-container {
    max-width: 450px;
    width: 100%;
    margin: 0 auto;
  }
  
  .auth-card {
    background: var(--card-bg);
    border-radius: 30px;
    padding: 50px 40px;
    box-shadow: 0 20px 60px rgba(0,0,0,0.3);
  }
  
  .auth-title {
    font-size: 2rem;
    font-weight: 800;
    color: var(--text-color);
    text-align: center;
    margin-bottom: 10px;
  }
  
  .auth-subtitle {
    text-align: center;
    color: var(--secondary-text);
    margin-bottom: 30px;
    font-size: 1rem;
  }
  
  .form-group {
    margin-bottom: 20px;
  }
  
  .form-label {
    display: block;
    font-weight: 600;
    color: var(--text-color);
    margin-bottom: 8px;
    font-size: 0.95rem;
  }
  
  .form-control {
    background: var(--border-color, #e0e0e0);
    border: 2px solid var(--border-color, #e0e0e0);
    color: var(--text-color);
    border-radius: 12px;
    padding: 12px 15px;
    transition: all 0.3s ease;
    width: 100%;
    font-size: 1rem;
  }
  
  .form-control:focus {
    background: var(--card-bg);
    border-color: #667eea;
    box-shadow: 0 0 0 4px rgba(102, 126, 234, 0.1);
    color: var(--text-color);
    outline: none;
  }
  
  [data-theme="dark"] .form-control {
    background: #3a3a3a;
    border-color: #3a3a3a;
  }
  
  [data-theme="dark"] .form-control:focus {
    background: #3a3a3a;
    border-color: #667eea;
  }
  
  .btn-submit {
    width: 100%;
    padding: 15px;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    border: none;
    border-radius: 50px;
    font-size: 1.1rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.3s ease;
    margin-top: 10px;
  }
  
  .btn-submit:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 25px rgba(102, 126, 234, 0.4);
  }
  
  /* ========================================
     OAuth 아이콘 버튼 스타일 (상단 배치)
     ======================================== */
  .oauth-section-top {
    margin-bottom: 30px;
  }
  
  .oauth-icons {
    display: flex;
    justify-content: center;
    gap: 20px;
    margin-bottom: 25px;
  }
  
  .oauth-icon-btn {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: all 0.3s ease;
    cursor: pointer;
  }
  
  .oauth-icon-btn:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 20px rgba(0,0,0,0.2);
  }
  
  .oauth-icon-btn svg {
    width: 28px;
    height: 28px;
  }
  
  .google-icon-btn {
    background: white;
    border: 2px solid #e0e0e0;
  }
  
  [data-theme="dark"] .google-icon-btn {
    background: #3a3a3a;
    border-color: #555;
  }
  
  .naver-icon-btn {
    background: #03C75A;
    border: 2px solid #03C75A;
  }

  .oauth-maintenance {
    text-align: center;
    padding: 12px 16px;
    background: rgba(255, 193, 7, 0.12);
    border: 1px solid rgba(255, 193, 7, 0.4);
    border-radius: 12px;
    color: var(--secondary-text);
    font-size: 0.9rem;
    font-weight: 600;
    margin-bottom: 20px;
  }
  
  .oauth-divider {
    display: flex;
    align-items: center;
    text-align: center;
    color: var(--secondary-text);
    font-size: 0.9rem;
  }
  
  .oauth-divider::before,
  .oauth-divider::after {
    content: '';
    flex: 1;
    border-bottom: 1px solid var(--border-color, #e0e0e0);
  }
  
  .oauth-divider span {
    padding: 0 15px;
  }
  
  .error-message {
    background: #fee;
    color: #c00;
    padding: 12px;
    border-radius: 10px;
    margin-bottom: 20px;
    text-align: center;
    font-weight: 600;
  }
  
  .auth-links {
    text-align: center;
    margin-top: 20px;
    color: var(--secondary-text);
    font-size: 0.95rem;
  }
  
  .auth-links a {
    color: #667eea;
    text-decoration: none;
    font-weight: 600;
  }
  
  .auth-links a:hover {
    text-decoration: underline;
  }

  .password-requirements {
    margin-top: 8px;
    font-size: 0.85rem;
  }

  .password-requirements div {
    margin-bottom: 4px;
  }

  .requirement-item {
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .requirement-icon {
    font-weight: bold;
  }

  .password-strength {
    margin-top: 8px;
    font-weight: bold;
    font-size: 0.9rem;
  }

  .password-match {
    margin-top: 8px;
    font-size: 0.9rem;
    font-weight: 600;
  }

  /* 이메일 자동완성 */
  .email-wrapper {
    position: relative;
  }

  .email-dropdown {
    display: none;
    position: absolute;
    top: calc(100% + 4px);
    left: 0;
    right: 0;
    background: var(--card-bg);
    border: 2px solid #667eea;
    border-radius: 12px;
    list-style: none;
    margin: 0;
    padding: 6px 0;
    z-index: 100;
    box-shadow: 0 8px 25px rgba(0,0,0,0.15);
    overflow: hidden;
  }

  .email-dropdown.show {
    display: block;
  }

  .email-dropdown li {
    padding: 10px 16px;
    cursor: pointer;
    color: var(--text-color);
    font-size: 0.95rem;
    transition: background 0.15s;
  }

  .email-dropdown li:hover,
  .email-dropdown li.active {
    background: linear-gradient(135deg, rgba(102,126,234,0.12) 0%, rgba(118,75,162,0.12) 100%);
    color: #667eea;
    font-weight: 600;
  }

  .email-dropdown li span.domain-highlight {
    font-weight: 700;
    color: #667eea;
  }
</style>

<div class="auth-container">
  <div class="auth-card">
    <h1 class="auth-title">회원가입</h1>
    <p class="auth-subtitle">Poll-APP With</p>
    
    <!-- 에러 메시지 -->
    <% if (error) { %>
      <div class="error-message">
        <%= error %>
      </div>
    <% } %>
    
    <!-- ========================================
         OAuth 간편 가입 (상단 배치)
         ======================================== -->
    <div class="oauth-section-top">
      <div class="oauth-maintenance">
        🔧 소셜 로그인은 현재 업데이트 중입니다
      </div>
      <div class="oauth-divider">
        <span>또는</span>
      </div>
    </div>
    
    <!-- 회원가입 폼 -->
    <form action="/auth/register" method="POST">
      <!-- CSRF 토큰 -->
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      
      <div class="form-group">
        <label for="username" class="form-label">사용자명</label>
        <input 
          type="text" 
          class="form-control" 
          id="username" 
          name="username"
          placeholder="2-20자 이내"
          required
        >
      </div>
      
      <div class="form-group">
        <label for="email" class="form-label">이메일</label>
        <div class="email-wrapper">
          <input
            type="email"
            class="form-control"
            id="email"
            name="email"
            placeholder="example@email.com"
            autocomplete="off"
            required
          >
          <ul class="email-dropdown" id="email-dropdown"></ul>
        </div>
      </div>
      
      <div class="form-group">
        <label for="password" class="form-label">비밀번호</label>
        <input 
          type="password" 
          class="form-control" 
          id="password" 
          name="password"
          placeholder="8자 이상, 영문+숫자+특수문자"
          onkeyup="checkPasswordStrength()"
          required
        >
      
      <!-- 비밀번호 강도 표시-->
       <div id="password-strength" class="password-strength"></div>
      
      <!-- 요구사항 체크리스트-->
       <div class="password-requirements">
        <div class="requirement-item">
          <span id="req-length" class="requirement-icon" style="color: red;">x</span>
          <span>최소 8자 이상</span>
        </div>
        <div class="requirement-item">
          <span id="req-letter" class="requirement-icon" style="color: red;">x</span>
          <span>영문 포함</span>
        </div>
        <div class="requirement-item">
          <span id="req-number" class="requirement-icon" style="color: red;">x</span>
          <span>숫자 포함</span>
        </div>
        <div class="requirement-item">
          <span id="req-special" class="requirement-icon" style="color: red;">x</span>
          <span>특수문자 포함(@$!%*#?&)</span>
        </div>
       </div>
      </div>

      <div class="form-group">
        <label for="passwordConfirm" class="form-label">비밀번호 확인</label>
        <input 
          type="password" 
          class="form-control" 
          id="passwordConfirm" 
          name="passwordConfirm"
          placeholder="비밀번호를 다시 입력하세요"
          onkeyup="checkPasswordStrength()"
          required
        >
        <!-- 비밀번호 일치 표시-->
         <div id="password-match" class="password-match"></div>
      </div>
      
      <button type="submit" class="btn-submit">
        가입하기
      </button>
    </form>
    
    <div class="auth-links">
      이미 계정이 있으신가요? <a href="/auth/login">로그인</a>
    </div>
  </div>
</div>
<script>
<!-- 비밀번호 강도 체크 스크립트-->
function checkPasswordStrength() {
  const password = document.getElementById('password').value;
  const strengthDiv = document.getElementById('password-strength');

  const hasLetter = /[A-Za-z]/.test(password);
  const hasNumber = /\d/.test(password);
  const hasSpecial = /[@$!%*#?&]/.test(password);
  const isLongEnough = password.length >= 8;

  if (password.length === 0) {
    strengthDiv.innerHTML = '';
    updateRequirements(false, false, false, false);
    return;
  }

  let strength = 0;
  if (hasLetter) strength++;
  if (hasNumber) strength++;
  if (hasSpecial) strength++;
  if (isLongEnough) strength++;

  let message = '';
  let color = '';

  if (strength <= 2) {
    message = '약함';
    color = '#dc3545';
  } else if (strength === 3) {
    message = '보통';
    color = '#ffc107';
  } else {
    message = '강함';
    color = '#28a745';
  }

  strengthDiv.innerHTML = `<span style="color: ${color};">비밀번호 강도: ${message}</span>`;
  updateRequirements(isLongEnough, hasLetter, hasNumber, hasSpecial);
}

function updateRequirements(length, letter, number, special) {
    document.getElementById('req-length').style.color = length ? '#28a745' : '#dc3545';
    document.getElementById('req-length').textContent = length ? '✓' : '✗';
    
    document.getElementById('req-letter').style.color = letter ? '#28a745' : '#dc3545';
    document.getElementById('req-letter').textContent = letter ? '✓' : '✗';
    
    document.getElementById('req-number').style.color = number ? '#28a745' : '#dc3545';
    document.getElementById('req-number').textContent = number ? '✓' : '✗';
    
    document.getElementById('req-special').style.color = special ? '#28a745' : '#dc3545';
    document.getElementById('req-special').textContent = special ? '✓' : '✗';
}

// 이메일 도메인 자동완성
(function() {
  const EMAIL_DOMAINS = [
    'gmail.com', 'naver.com', 'daum.net', 'kakao.com',
    'hanmail.net', 'nate.com', 'hotmail.com', 'outlook.com',
    'yahoo.com', 'icloud.com'
  ];

  const input = document.getElementById('email');
  const dropdown = document.getElementById('email-dropdown');
  let activeIndex = -1;

  function showDropdown(local, typed) {
    const filtered = typed
      ? EMAIL_DOMAINS.filter(d => d.startsWith(typed))
      : EMAIL_DOMAINS;

    if (!filtered.length) { hideDropdown(); return; }

    activeIndex = -1;
    dropdown.innerHTML = filtered.map(domain =>
      `<li data-domain="${domain}">
        ${local}@<span class="domain-highlight">${domain}</span>
      </li>`
    ).join('');
    dropdown.classList.add('show');
  }

  function hideDropdown() {
    dropdown.classList.remove('show');
    activeIndex = -1;
  }

  function selectItem(domain) {
    const local = input.value.split('@')[0];
    input.value = local + '@' + domain;
    hideDropdown();
    input.focus();
  }

  input.addEventListener('input', function() {
    const val = this.value;
    const atIdx = val.indexOf('@');
    if (atIdx === -1) { hideDropdown(); return; }
    const local = val.slice(0, atIdx);
    const typed = val.slice(atIdx + 1);
    showDropdown(local, typed);
  });

  input.addEventListener('keydown', function(e) {
    const items = dropdown.querySelectorAll('li');
    if (!items.length) return;

    if (e.key === 'ArrowDown') {
      e.preventDefault();
      activeIndex = (activeIndex + 1) % items.length;
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      activeIndex = (activeIndex - 1 + items.length) % items.length;
    } else if (e.key === 'Enter' && activeIndex >= 0) {
      e.preventDefault();
      selectItem(items[activeIndex].dataset.domain);
      return;
    } else if (e.key === 'Escape') {
      hideDropdown(); return;
    } else { return; }

    items.forEach((li, i) => li.classList.toggle('active', i === activeIndex));
  });

  dropdown.addEventListener('mousedown', function(e) {
    const li = e.target.closest('li');
    if (li) selectItem(li.dataset.domain);
  });

  document.addEventListener('click', function(e) {
    if (!input.contains(e.target) && !dropdown.contains(e.target)) hideDropdown();
  });
})();

function checkPasswordMatch() {
  const password = document.getElementById('password').value;
  const passwordConfirm = document.getElementById('passwordConfirm').value;
  const matchDiv = document.getElementById('password-match');

  if (passwordConfirm.length === 0) {
    matchDiv.innerHTML = '';
    return;
  }

  if (password === passwordConfirm) {
    matchDiv.innerHTML = '<span style="color: #28a745;">✓ 비밀번호가 일치합니다</span>';
  } else {
    matchDiv.innerHTML = '<span style="color: #dc3545;">✗ 비밀번호가 일치하지 않습니다</span>';
  }
}
</script>
 