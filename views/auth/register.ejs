<style>
  /* 회원가입 페이지 전용 스타일 */
  .layout-full-width {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: calc(100vh - 100px);
  }
  
  .auth-container {
    max-width: 450px;
    width: 100%;
    margin: 0 auto;
  }
  
  .auth-card {
    background: var(--card-bg);
    border-radius: 30px;
    padding: 50px 40px;
    box-shadow: 0 20px 60px rgba(0,0,0,0.3);
  }
  
  .auth-title {
    font-size: 2rem;
    font-weight: 800;
    color: var(--text-color);
    text-align: center;
    margin-bottom: 10px;
  }
  
  .auth-subtitle {
    text-align: center;
    color: var(--secondary-text);
    margin-bottom: 30px;
    font-size: 1rem;
  }
  
  .form-group {
    margin-bottom: 20px;
  }
  
  .form-label {
    display: block;
    font-weight: 600;
    color: var(--text-color);
    margin-bottom: 8px;
    font-size: 0.95rem;
  }
  
  .form-control {
    background: var(--border-color, #e0e0e0);
    border: 2px solid var(--border-color, #e0e0e0);
    color: var(--text-color);
    border-radius: 12px;
    padding: 12px 15px;
    transition: all 0.3s ease;
    width: 100%;
    font-size: 1rem;
  }
  
  .form-control:focus {
    background: var(--card-bg);
    border-color: #667eea;
    box-shadow: 0 0 0 4px rgba(102, 126, 234, 0.1);
    color: var(--text-color);
    outline: none;
  }
  
  [data-theme="dark"] .form-control {
    background: #3a3a3a;
    border-color: #3a3a3a;
  }
  
  [data-theme="dark"] .form-control:focus {
    background: #3a3a3a;
    border-color: #667eea;
  }
  
  .btn-submit {
    width: 100%;
    padding: 15px;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    border: none;
    border-radius: 50px;
    font-size: 1.1rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.3s ease;
    margin-top: 10px;
  }
  
  .btn-submit:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 25px rgba(102, 126, 234, 0.4);
  }
  
  /* ========================================
     OAuth 아이콘 버튼 스타일 (상단 배치)
     ======================================== */
  .oauth-section-top {
    margin-bottom: 30px;
  }
  
  .oauth-icons {
    display: flex;
    justify-content: center;
    gap: 20px;
    margin-bottom: 25px;
  }
  
  .oauth-icon-btn {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: all 0.3s ease;
    cursor: pointer;
  }
  
  .oauth-icon-btn:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 20px rgba(0,0,0,0.2);
  }
  
  .oauth-icon-btn svg {
    width: 28px;
    height: 28px;
  }
  
  .google-icon-btn {
    background: white;
    border: 2px solid #e0e0e0;
  }
  
  [data-theme="dark"] .google-icon-btn {
    background: #3a3a3a;
    border-color: #555;
  }
  
  .naver-icon-btn {
    background: #03C75A;
    border: 2px solid #03C75A;
  }
  
  .oauth-divider {
    display: flex;
    align-items: center;
    text-align: center;
    color: var(--secondary-text);
    font-size: 0.9rem;
  }
  
  .oauth-divider::before,
  .oauth-divider::after {
    content: '';
    flex: 1;
    border-bottom: 1px solid var(--border-color, #e0e0e0);
  }
  
  .oauth-divider span {
    padding: 0 15px;
  }
  
  .error-message {
    background: #fee;
    color: #c00;
    padding: 12px;
    border-radius: 10px;
    margin-bottom: 20px;
    text-align: center;
    font-weight: 600;
  }
  
  .auth-links {
    text-align: center;
    margin-top: 20px;
    color: var(--secondary-text);
    font-size: 0.95rem;
  }
  
  .auth-links a {
    color: #667eea;
    text-decoration: none;
    font-weight: 600;
  }
  
  .auth-links a:hover {
    text-decoration: underline;
  }

  .password-requirements {
    margin-top: 8px;
    font-size: 0.85rem;
  }

  .password-requirements div {
    margin-bottom: 4px;
  }

  .requirement-item {
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .requirement-icon {
    font-weight: bold;
  }

  .password-strength {
    margin-top: 8px;
    font-weight: bold;
    font-size: 0.9rem;
  }

  .password-match {
    margin-top: 8px;
    font-size: 0.9rem;
    font-weight: 600;
  }
</style>

<div class="auth-container">
  <div class="auth-card">
    <h1 class="auth-title">회원가입</h1>
    <p class="auth-subtitle">Poll-APP With</p>
    
    <!-- 에러 메시지 -->
    <% if (error) { %>
      <div class="error-message">
        <%= error %>
      </div>
    <% } %>
    
    <!-- ========================================
         OAuth 간편 가입 (상단 배치)
         ======================================== -->
    <div class="oauth-section-top">
      <div class="oauth-icons">
        <!-- Google 아이콘 -->
        <a href="/oauth/google" class="oauth-icon-btn google-icon-btn" title="Google로 계속하기">
          <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
          </svg>
        </a>
        
        <!-- Naver 아이콘 -->
        <a href="/oauth/naver" class="oauth-icon-btn naver-icon-btn" title="네이버로 계속하기">
          <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path fill="white" d="M16.273 12.845L7.376 0H0v24h7.726V11.156L16.624 24H24V0h-7.727v12.845z"/>
          </svg>
        </a>
      </div>
      
      <!-- 구분선 -->
      <div class="oauth-divider">
        <span>또는</span>
      </div>
    </div>
    
    <!-- 회원가입 폼 -->
    <form action="/auth/register" method="POST">
      <!-- CSRF 토큰 -->
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      
      <div class="form-group">
        <label for="username" class="form-label">사용자명</label>
        <input 
          type="text" 
          class="form-control" 
          id="username" 
          name="username"
          placeholder="2-20자 이내"
          required
        >
      </div>
      
      <div class="form-group">
        <label for="email" class="form-label">이메일</label>
        <input 
          type="email" 
          class="form-control" 
          id="email" 
          name="email"
          placeholder="example@email.com"
          required
        >
      </div>
      
      <div class="form-group">
        <label for="password" class="form-label">비밀번호</label>
        <input 
          type="password" 
          class="form-control" 
          id="password" 
          name="password"
          placeholder="8자 이상, 영문+숫자+특수문자"
          onkeyup="checkPasswordStrength()"
          required
        >
      
      <!-- 비밀번호 강도 표시-->
       <div id="password-strength" class="password-strength"></div>
      
      <!-- 요구사항 체크리스트-->
       <div class="password-requirements">
        <div class="requirement-item">
          <span id="req-length" class="requirement-icon" style="color: red;">x</span>
          <span>최소 8자 이상</span>
        </div>
        <div class="requirement-item">
          <span id="req-letter" class="requirement-icon" style="color: red;">x</span>
          <span>영문 포함</span>
        </div>
        <div class="requirement-item">
          <span id="req-number" class="requirement-icon" style="color: red;">x</span>
          <span>숫자 포함</span>
        </div>
        <div class="requirement-item">
          <span id="req-special" class="requirement-icon" style="color: red;">x</span>
          <span>특수문자 포함(@$!%*#?&)</span>
        </div>
       </div>
      </div>

      <div class="form-group">
        <label for="passwordConfirm" class="form-label">비밀번호 확인</label>
        <input 
          type="password" 
          class="form-control" 
          id="passwordConfirm" 
          name="passwordConfirm"
          placeholder="비밀번호를 다시 입력하세요"
          onkeyup="checkPasswordStrength()"
          required
        >
        <!-- 비밀번호 일치 표시-->
         <div id="password-match" class="password-match"></div>
      </div>
      
      <button type="submit" class="btn-submit">
        가입하기
      </button>
    </form>
    
    <div class="auth-links">
      이미 계정이 있으신가요? <a href="/auth/login">로그인</a>
    </div>
  </div>
</div>
<script>
<!-- 비밀번호 강도 체크 스크립트-->
function checkPasswordStrength() {
  const password = document.getElementById('password').value;
  const strengthDiv = document.getElementById('password-strength');

  const hasLetter = /[A-Za-z]/.test(password);
  const hasNumber = /\d/.test(password);
  const hasSpecial = /[@$!%*#?&]/.test(password);
  const isLongEnough = password.length >= 8;

  if (password.length === 0) {
    strengthDiv.innerHTML = '';
    updateRequirements(false, false, false, false);
    return;
  }

  let strength = 0;
  if (hasLetter) strength++;
  if (hasNumber) strength++;
  if (hasSpecial) strength++;
  if (isLongEnough) strength++;

  let message = '';
  let color = '';

  if (strength <= 2) {
    message = '약함';
    color = '#dc3545';
  } else if (strength === 3) {
    message = '보통';
    color = '#ffc107';
  } else {
    message = '강함';
    color = '#28a745';
  }

  strengthDiv.innerHTML = `<span style="color: ${color};">비밀번호 강도: ${message}</span>`;
  updateRequirements(isLongEnough, hasLetter, hasNumber, hasSpecial);
}

function updateRequirements(length, letter, number, special) {
    document.getElementById('req-length').style.color = length ? '#28a745' : '#dc3545';
    document.getElementById('req-length').textContent = length ? '✓' : '✗';
    
    document.getElementById('req-letter').style.color = letter ? '#28a745' : '#dc3545';
    document.getElementById('req-letter').textContent = letter ? '✓' : '✗';
    
    document.getElementById('req-number').style.color = number ? '#28a745' : '#dc3545';
    document.getElementById('req-number').textContent = number ? '✓' : '✗';
    
    document.getElementById('req-special').style.color = special ? '#28a745' : '#dc3545';
    document.getElementById('req-special').textContent = special ? '✓' : '✗';
}

function checkPasswordMatch() {
  const password = document.getElementById('password').value;
  const passwordConfirm = document.getElementById('passwordConfirm').value;
  const matchDiv = document.getElementById('password-match');

  if (passwordConfirm.length === 0) {
    matchDiv.innerHTML = '';
    return;
  }

  if (password === passwordConfirm) {
    matchDiv.innerHTML = '<span style="color: #28a745;">✓ 비밀번호가 일치합니다</span>';
  } else {
    matchDiv.innerHTML = '<span style="color: #dc3545;">✗ 비밀번호가 일치하지 않습니다</span>';
  }
}
</script>
 