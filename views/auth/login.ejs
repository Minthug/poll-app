<style>
  /* 로그인 페이지 전용 스타일 */
  .layout-full-width {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: calc(100vh - 100px);
  }
  
  .auth-container {
    max-width: 450px;
    width: 100%;
    margin: 0 auto;
  }
  
  .auth-card {
    background: var(--card-bg);
    border-radius: 30px;
    padding: 50px 40px;
    box-shadow: 0 20px 60px rgba(0,0,0,0.3);
  }
  
  .auth-title {
    font-size: 2rem;
    font-weight: 800;
    color: var(--text-color);
    text-align: center;
    margin-bottom: 10px;
  }
  
  .auth-subtitle {
    text-align: center;
    color: var(--secondary-text);
    margin-bottom: 30px;
    font-size: 1rem;
  }
  
  .form-group {
    margin-bottom: 20px;
  }
  
  .form-label {
    display: block;
    font-weight: 600;
    color: var(--text-color);
    margin-bottom: 8px;
    font-size: 0.95rem;
  }
  
  .form-control {
    background: var(--border-color, #e0e0e0);
    border: 2px solid var(--border-color, #e0e0e0);
    color: var(--text-color);
    border-radius: 12px;
    padding: 12px 15px;
    transition: all 0.3s ease;
    width: 100%;
    font-size: 1rem;
  }
  
  .form-control:focus {
    background: var(--card-bg);
    border-color: #667eea;
    box-shadow: 0 0 0 4px rgba(102, 126, 234, 0.1);
    color: var(--text-color);
    outline: none;
  }
  
  [data-theme="dark"] .form-control {
    background: #3a3a3a;
    border-color: #3a3a3a;
  }
  
  [data-theme="dark"] .form-control:focus {
    background: #3a3a3a;
    border-color: #667eea;
  }
  
  .btn-submit {
    width: 100%;
    padding: 15px;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    border: none;
    border-radius: 50px;
    font-size: 1.1rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.3s ease;
    margin-top: 10px;
  }
  
  .btn-submit:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 25px rgba(102, 126, 234, 0.4);
  }
  
  /* ========================================
     OAuth 아이콘 버튼 스타일
     ======================================== */
  .oauth-section {
    margin-top: 30px;
  }
  
  .oauth-divider {
    display: flex;
    align-items: center;
    text-align: center;
    margin-bottom: 20px;
    color: var(--secondary-text);
    font-size: 0.9rem;
  }
  
  .oauth-divider::before,
  .oauth-divider::after {
    content: '';
    flex: 1;
    border-bottom: 1px solid var(--border-color, #e0e0e0);
  }
  
  .oauth-divider span {
    padding: 0 15px;
  }
  
  .oauth-icons {
    display: flex;
    justify-content: center;
    gap: 20px;
  }
  
  .oauth-icon-btn { 
    width: 56px;
    height: 56px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: all 0.3s ease;
    cursor: pointer;
  }
  
  .oauth-icon-btn:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 20px rgba(0,0,0,0.2);
  }
  
  .oauth-icon-btn svg {
    width: 28px;
    height: 28px;
  }
  
  .google-icon-btn {
    background: white;
    border: 2px solid #e0e0e0;
  }
  
  [data-theme="dark"] .google-icon-btn {
    background: #3a3a3a;
    border-color: #555;
  }
  
  .naver-icon-btn {
    background: #03C75A;
    border: 2px solid #03C75A;
  }

  .oauth-maintenance {
    text-align: center;
    padding: 12px 16px;
    background: rgba(255, 193, 7, 0.12);
    border: 1px solid rgba(255, 193, 7, 0.4);
    border-radius: 12px;
    color: var(--secondary-text);
    font-size: 0.9rem;
    font-weight: 600;
  }
  
  .error-message {
    background: #fee;
    color: #c00;
    padding: 12px;
    border-radius: 10px;
    margin-bottom: 20px;
    text-align: center;
    font-weight: 600;
  }
  
  .info-message {
    background: #e3f2fd;
    color: #1565c0;
    padding: 12px;
    border-radius: 10px;
    margin-bottom: 20px;
    text-align: center;
    font-weight: 600;
  }
  
  [data-theme="dark"] .info-message {
    background: #1e3a5f;
    color: #90caf9;
  }
  
  .auth-links {
    text-align: center;
    margin-top: 20px;
    color: var(--secondary-text);
    font-size: 0.95rem;
  }
  
  .auth-links a {
    color: #667eea;
    text-decoration: none;
    font-weight: 600;
  }
  
  .auth-links a:hover {
    text-decoration: underline;
  }

  .remember-me {
    margin-bottom: 16px;
  }

  .remember-me label {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--secondary-text);
    font-size: 0.9rem;
    cursor: pointer;
    user-select: none;
  }

  .remember-me input[type="checkbox"] {
    width: 16px;
    height: 16px;
    accent-color: #667eea;
    cursor: pointer;
  }
  
  /* Toast 알림 스타일 */
  .toast-notification {
    position: fixed;
    top: 80px;
    right: 20px;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    padding: 18px 25px;
    border-radius: 12px;
    box-shadow: 0 8px 25px rgba(0,0,0,0.4);
    z-index: 10000;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 300px;
    animation: slideIn 0.4s ease;
  }
  
  @keyframes slideIn {
    from {
      transform: translateX(400px);
      opacity: 0;
    }
    to {
      transform: translateX(0);
      opacity: 1;
    }
  }
  
  .toast-notification.fade-out {
    animation: slideOut 0.4s ease forwards;
  }
  
  @keyframes slideOut {
    from {
      transform: translateX(0);
      opacity: 1;
    }
    to {
      transform: translateX(400px);
      opacity: 0;
    }
  }
  
  .toast-icon {
    font-size: 1.8rem;
    flex-shrink: 0;
  }
  
  .toast-message {
    flex: 1;
    font-size: 1rem;
  }
</style>

<div class="auth-container">
  <div class="auth-card">
    <h1 class="auth-title">로그인</h1>
    <p class="auth-subtitle">여론조사에 참여하세요</p>
    
    <!-- 세션 타임아웃 메시지 -->
    <% if (typeof timeout !== 'undefined' && timeout) { %>
      <div class="info-message">
        ⏰ 1시간 동안 활동이 없어 자동 로그아웃되었습니다.
      </div>
    <% } %>
    
    <!-- 일반 메시지 (로그인 필요 등) -->
    <% if (typeof message !== 'undefined' && message) { %>
      <div class="info-message">
        ℹ️ <%= message %>
      </div>
    <% } %>
    
    <!-- 에러 메시지 -->
    <% if (error) { %>
      <div class="error-message">
        <%= error %>
      </div>
    <% } %>
    
    <!-- 로그인 폼 -->
    <form action="/auth/login" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      
      <div class="form-group">
        <label for="email" class="form-label">이메일</label>
        <input 
          type="email" 
          class="form-control" 
          id="email" 
          name="email"
          placeholder="example@email.com"
          required
        >
      </div>
      
      <div class="form-group">
        <label for="password" class="form-label">비밀번호</label>
        <input 
          type="password" 
          class="form-control" 
          id="password" 
          name="password"
          placeholder="비밀번호를 입력하세요"
          required
        >
      </div>
      
      <div class="remember-me">
        <label>
          <input type="checkbox" id="remember-me">
          아이디 기억하기
        </label>
      </div>

      <button type="submit" class="btn-submit">
        로그인
      </button>
    </form>
    
    <!-- ========================================
         OAuth 간편 로그인 (로그인 버튼 아래)
         ======================================== -->
    <div class="oauth-section">
      <div class="oauth-divider">
        <span>또는</span>
      </div>
      <div class="oauth-maintenance">
        🔧 소셜 로그인은 현재 업데이트 중입니다
      </div>
    </div>
    
    <div class="auth-links">
      계정이 없으신가요? <a href="/auth/register">회원가입</a>
    </div>
  </div>
</div>

<script>
  // 아이디 기억하기
  (function() {
    const emailInput = document.getElementById('email');
    const checkbox = document.getElementById('remember-me');
    const saved = localStorage.getItem('rememberedEmail');

    if (saved) {
      emailInput.value = saved;
      checkbox.checked = true;
    }

    document.querySelector('form').addEventListener('submit', function() {
      if (checkbox.checked) {
        localStorage.setItem('rememberedEmail', emailInput.value);
      } else {
        localStorage.removeItem('rememberedEmail');
      }
    });
  })();

  // Toast 알림 표시 함수
  function showToast(message) {
    const toast = document.createElement('div');
    toast.className = 'toast-notification';
    toast.innerHTML = `
      <span class="toast-icon">🔒</span>
      <span class="toast-message">${message}</span>
    `;
    
    document.body.appendChild(toast);
    
    // 3초 후 페이드아웃
    setTimeout(() => {
      toast.classList.add('fade-out');
      setTimeout(() => {
        toast.remove();
      }, 400);
    }, 3000);
  }
  
  // 페이지 로드 시 Toast 표시
  <% if (typeof message !== 'undefined' && message) { %>
    setTimeout(() => {
      showToast('<%= message %>');
    }, 100);
  <% } %>
</script>