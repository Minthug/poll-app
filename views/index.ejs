<style>
  .landing-container {
    max-width: 700px;
    margin: 0 auto;
  }
  
  .hero-section {
    text-align: center;
    background: var(--card-bg);
    border-radius: 30px;
    padding: 60px 40px;
    box-shadow: 0 20px 60px rgba(0,0,0,0.3);
    margin-bottom: 30px;
    transition: all 0.3s ease;
  }
  
  .hero-badge {
    display: inline-block;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    padding: 8px 20px;
    border-radius: 50px;
    font-size: 0.9rem;
    font-weight: 600;
    margin-bottom: 20px;
    box-shadow: 0 4px 15px rgba(102, 126, 234, 0.3);
  }
  
  .hero-title {
    font-size: 3rem;
    font-weight: 800;
    color: #1a1a2e;  /* ⬅️ 매우 진한 색 */
    margin-bottom: 20px;
    line-height: 1.2;
    letter-spacing: -1px;
  }

  [data-theme="dark"] .hero-title {
    color: var(--text-color);
  }
  
  .hero-subtitle {
    font-size: 1.3rem;
    color: #2c3e50;  /* ⬅️ 진한 색 */
    margin-bottom: 40px;
    line-height: 1.6;
    font-weight: 600;
  }

  [data-theme="dark"] .hero-subtitle {
    color: var(--secondary-text);
  }
  
  .cta-button {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 18px 45px;
    font-size: 1.2rem;
    font-weight: 700;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    border: none;
    border-radius: 50px;
    cursor: pointer;
    transition: all 0.3s ease;
    text-decoration: none;
    box-shadow: 0 8px 25px rgba(102, 126, 234, 0.4);
  }
  
  .cta-button:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 40px rgba(102, 126, 234, 0.4);
    color: white;
  }
  
  .cta-icon {
    font-size: 1.5rem;
    animation: bounce 2s infinite;
  }
  
  @keyframes bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-5px); }
  }
  
  .auth-buttons {
    margin-top: 20px;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 15px;
  }

  .auth-link {
    color: #2c3e50;  /* ⬅️ 진한 색 */
    text-decoration: none;
    font-weight: 700;
    transition: all 0.3s ease;
    padding: 8px 20px;
    border-radius: 20px;
  }

  [data-theme="dark"] .auth-link {
    color: var(--text-color);
  }

  .auth-link:hover {
    color: #667eea;
    background: rgba(102, 126, 234, 0.1);
  }

  .separator {
    color: #34495e;  /* ⬅️ 진한 색 */
    font-weight: 600;
  }

  [data-theme="dark"] .separator {
    color: var(--secondary-text);
  }
  
  .user-info {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin-top: 20px;
    padding: 12px 25px;
    background: var(--feature-bg, #f8f9fa);
    border-radius: 50px;
  }
  
  [data-theme="dark"] .user-info {
    background: #3a3a3a;
  }
  
  .user-welcome {
    color: #1a1a2e;  /* ⬅️ 매우 진한 색 */
    font-weight: 700;
  }

  [data-theme="dark"] .user-welcome {
    color: var(--text-color);
  }
  
  .btn-logout-small {
    padding: 6px 15px;
    background: #dc3545;
    color: white;
    border-radius: 20px;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 600;
    transition: all 0.3s ease;
  }
  
  .btn-logout-small:hover {
    background: #c82333;
    color: white;
    transform: translateY(-2px);
  }
  
  .features-section {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 20px;
    margin-top: 30px;
  }
  
  .feature-card {
    background: var(--card-bg);
    border-radius: 20px;
    padding: 35px 30px;
    text-align: center;
    transition: all 0.3s ease;
    box-shadow: 0 10px 30px rgba(0,0,0,0.2);
  }
  
  .feature-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 15px 40px rgba(0,0,0,0.3);
  }
  
  .feature-icon {
    font-size: 3rem;
    margin-bottom: 15px;
    display: block;
  }
  
  .feature-title {
    font-size: 1.3rem;
    font-weight: 700;
    color: #1a1a2e;  /* ⬅️ 매우 진한 색 */
    margin-bottom: 10px;
  }

  [data-theme="dark"] .feature-title {
    color: var(--text-color);
  }
  
  .feature-desc {
    font-size: 1rem;
    color: #2c3e50;  /* ⬅️ 진한 색 */
    line-height: 1.6;
    font-weight: 500;
  }

  [data-theme="dark"] .feature-desc {
    color: var(--secondary-text);
  }
  
  .secondary-actions {
    text-align: center;
    margin-top: 30px;
  }
  
  .secondary-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 30px;
    font-size: 1rem;
    font-weight: 700;
    background: white;
    color: #667eea;
    border: 2px solid white;
    border-radius: 50px;
    cursor: pointer;
    transition: all 0.3s ease;
    text-decoration: none;
    margin: 0 10px;
    box-shadow: 0 4px 15px rgba(255, 255, 255, 0);
  }
  
  [data-theme="dark"] .secondary-btn {
    background: transparent;  /* ⬅️ 다크모드에서는 투명 */
    color: white;  /* ⬅️ 다크모드에서는 흰색 */
  }
  

  .secondary-btn:hover {
    background: rgba(255, 255, 255, 0.95);  /* ⬅️ 호버 시 약간 투명 */
    color: #764ba2;  /* ⬅️ 호버 시 더 진한 보라색 */
    transform: translateY(-3px);
    box-shadow: 0 8px 25px rgba(255, 255, 255, 0.4);  /* ⬅️ 호버 그림자 강화 */
  }
  
  [data-theme="dark"] .secondary-btn:hover {
    background: white;  /* ⬅️ 다크모드 호버 시 흰색 */
    color: #667eea;  /* ⬅️ 다크모드 호버 시 보라색 */
  }
  /* ========================================
     모달 스타일
     ======================================== */
  
  /* 커스텀 모달 오버레이 (로그인 필요) */
  .modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.7);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 9999;
    animation: fadeIn 0.3s ease;
  }
  
  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  
  .modal-content {
    background: var(--card-bg, white);
    border-radius: 20px;
    padding: 40px 35px;
    max-width: 400px;
    width: 90%;
    text-align: center;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
    animation: slideUp 0.3s ease;
  }
  
  @keyframes slideUp {
    from {
      transform: translateY(50px);
      opacity: 0;
    }
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }
  
  [data-theme="dark"] .modal-content {
    background: #2d2d2d;
  }
  
  .modal-icon {
    font-size: 4rem;
    margin-bottom: 20px;
  }
  
  /* 로그인 모달 제목 */
  .modal-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: #1a1a2e;  /* ⬅️ 매우 진한 색 */
    margin-bottom: 15px;
  }
  
  [data-theme="dark"] .modal-title {
    color: #e0e0e0;
  }
  
  /* 로그인 모달 메시지 */
  .modal-message {
    font-size: 1rem;
    color: #2c3e50;  /* ⬅️ 진한 색 */
    margin-bottom: 30px;
    line-height: 1.6;
    font-weight: 600;
  }
  
  [data-theme="dark"] .modal-message {
    color: #aaa;
  }
  
  .modal-buttons {
    display: flex;
    gap: 10px;
  }
  
  /* 주 버튼 (로그인하기) */
  .btn-modal-primary {
    flex: 1;
    padding: 15px 25px;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white !important;  /* ⬅️ 흰색 강제 */
    border: none;
    border-radius: 50px;
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.3s ease;
  }
  
  .btn-modal-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(102, 126, 234, 0.4);
  }
  
  /* 보조 버튼 (취소) */
  .btn-modal-secondary {
    flex: 1;
    padding: 15px 25px;
    background: transparent;
    color: #2c3e50;  /* ⬅️ 진한 색 */
    border: 2px solid #2c3e50;  /* ⬅️ 진한 테두리 */
    border-radius: 50px;
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.3s ease;
  }
  
  [data-theme="dark"] .btn-modal-secondary {
    color: #e0e0e0;
    border-color: #e0e0e0;
  }
  
  .btn-modal-secondary:hover {
    background: rgba(44, 62, 80, 0.1);
    transform: translateY(-2px);
  }
  
  [data-theme="dark"] .btn-modal-secondary:hover {
    background: rgba(224, 224, 224, 0.1);
  }
  
  /* ========================================
     Bootstrap IP 동의 모달 스타일
     ======================================== */
  
  /* Bootstrap 모달 헤더 */
  .modal-header {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    border-radius: 20px 20px 0 0;
    border-bottom: none;
    padding: 20px 25px;
  }
  
  .modal-header .modal-title {
    color: white !important;  /* ⬅️ 흰색 강제 */
    font-weight: 700;
  }
  
  /* Bootstrap 모달 본문 */
  .modal-body {
    padding: 30px;
    color: #2c3e50;  /* ⬅️ 진한 색 */
  }
  
  [data-theme="dark"] .modal-body {
    color: #e0e0e0;
  }
  
  .modal-body h6 {
    font-weight: 700;
    color: #1a1a2e;  /* ⬅️ 매우 진한 색 */
    margin-top: 15px;
    margin-bottom: 10px;
  }
  
  [data-theme="dark"] .modal-body h6 {
    color: #e0e0e0;
  }
  
  .modal-body p {
    color: #2c3e50;  /* ⬅️ 진한 색 */
    font-weight: 500;
    line-height: 1.6;
  }
  
  [data-theme="dark"] .modal-body p {
    color: #aaa;
  }
  
  /* Bootstrap 모달 푸터 */
  .modal-footer {
    border-top: 1px solid var(--border-color);
    padding: 20px 25px;
  }
  
  .modal-footer .btn-primary {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    border: none;
    font-weight: 700;
    color: white !important;  /* ⬅️ 흰색 강제 */
    padding: 12px 30px;
    border-radius: 50px;
    transition: all 0.3s ease;
  }

  .modal-footer .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(102, 126, 234, 0.4);
  }
  
  /* ========================================
     반응형
     ======================================== */
  @media (max-width: 768px) {
    .hero-title {
      font-size: 2.2rem;
    }
    
    .hero-subtitle {
      font-size: 1.1rem;
    }
    
    .hero-section {
      padding: 40px 25px;
    }
    
    .cta-button {
      padding: 15px 35px;
      font-size: 1.1rem;
    }
    
    .features-section {
      grid-template-columns: 1fr;
    }
    
    .secondary-btn {
      display: flex;
      margin: 10px 0;
    }
    
    .auth-buttons {
      flex-direction: column;
      gap: 10px;
    }
  }
</style>

<div class="landing-container">
  <div class="hero-section">
    <div class="hero-badge">🎯 실시간 투표 시스템</div>
    <h1 class="hero-title">빠르고 쉬운<br>여론조사</h1>
    <p class="hero-subtitle">
      누구나 쉽게 만들고, 실시간으로 결과를 확인할 수 있는<br>
      스마트한 여론조사 플랫폼
    </p>
    
    <a href="/polls" class="cta-button">
      <span class="cta-icon">📋</span>
      <span>여론조사 둘러보기</span>
    </a>
    
    <div class="secondary-actions" style="margin-top: 20px;">
      <% if (user) { %>
        <a href="/polls/new" class="secondary-btn">
          <span>➕</span>
          <span>투표 만들기</span>
        </a>
      <% } else { %>
        <button class="secondary-btn" onclick="showLoginModal()">
          <span>🔒</span>
          <span>투표 만들기</span>
        </button>
      <% } %>
    </div>
    
    <% if (user) { %>
      <div class="user-info">
        <span class="user-welcome">👤 <strong><%= user.username %></strong>님 환영합니다!</span>
        <a href="/auth/logout" class="btn-logout-small">로그아웃</a>
      </div>
    <% } else { %>
      <div class="auth-buttons">
        <a href="/auth/login" class="auth-link">로그인</a>
        <span class="separator">|</span>
        <a href="/auth/register" class="auth-link">회원가입</a>
      </div>
    <% } %>
  </div>

  <div class="features-section">
    <div class="feature-card">
      <span class="feature-icon">⚡</span>
      <h3 class="feature-title">실시간 결과</h3>
      <p class="feature-desc">투표 결과가 실시간으로 업데이트되어 즉각적인 피드백을 받을 수 있어요</p>
    </div>
    
    <div class="feature-card">
      <span class="feature-icon">🔒</span>
      <h3 class="feature-title">중복 방지</h3>
      <p class="feature-desc">IP 기반 중복 투표 방지로 공정하고 정확한 투표 결과를 보장해요</p>
    </div>
    
    <div class="feature-card">
      <span class="feature-icon">📊</span>
      <h3 class="feature-title">지역별 통계</h3>
      <p class="feature-desc">투표자의 지역 정보를 자동으로 수집하여 상세한 통계를 제공해요</p>
    </div>
  </div>

  <div class="secondary-actions">
    <a href="/polls" class="secondary-btn">
      <span>📋</span>
      <span>여론조사 둘러보기</span>
    </a>
  </div>
</div>

<!-- 로그인 모달 -->
<div id="loginModal" class="modal-overlay" style="display: none;">
  <div class="modal-content">
    <div class="modal-icon">🔒</div>
    <h3 class="modal-title">로그인이 필요합니다</h3>
    <p class="modal-message">투표를 만들려면 로그인이 필요합니다.</p>
    <div class="modal-buttons">
      <button class="btn-modal-primary" onclick="goToLogin()">로그인하기</button>
      <button class="btn-modal-secondary" onclick="closeModal()">취소</button>
    </div>
  </div>
</div>

<!-- IP 동의 모달 -->
<div class="modal fade" id="ipConsentModal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">🔒 개인정보 수집 및 이용 동의</h5>
      </div>
      <div class="modal-body">
        <h6>1. 수집 목적</h6>
        <p>투표의 공정성 확보 및 중복 투표 방지</p>
        
        <h6>2. 수집 항목</h6>
        <p>IP 주소, 지역 정보 (국가, 도시)</p>
        
        <h6>3. 보유 기간</h6>
        <p>투표 종료 후 1년</p>
        
        <h6>4. 거부 권리</h6>
        <p>동의를 거부할 권리가 있으며, 거부 시 투표 서비스 이용이 제한됩니다.</p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-primary" data-bs-dismiss="modal" onclick="acceptConsent()">동의합니다</button>
      </div>
    </div>
  </div>
</div>

<script>
  // 로그인 모달 함수들
  function showLoginModal() {
    document.getElementById('loginModal').style.display = 'flex';
    document.body.style.overflow = 'hidden';
  }
  
  function closeModal() {
    document.getElementById('loginModal').style.display = 'none';
    document.body.style.overflow = 'auto';
  }
  
  function goToLogin() {
    window.location.href = '/auth/login?message=' + encodeURIComponent('투표를 만들려면 로그인이 필요합니다');
  }
  
  // IP 동의 모달 함수들
  async function checkIPConsent() {
    try {
      const response = await fetch('/admin/consent/check');
      const data = await response.json();
      
      console.log('IP 동의 확인:', data);
      
      if (!data.hasConsent) {
        setTimeout(() => {
          const ipModal = new bootstrap.Modal(document.getElementById('ipConsentModal'));
          ipModal.show();
        }, 1000);
      }
    } catch (error) {
      console.error('동의 확인 오류:', error);
    }
  }
  
  async function acceptConsent() {
    try {
      const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content ||
                        document.querySelector('input[name="_csrf"]')?.value;

      const response = await fetch('/admin/consent/accept', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'CSRF-Token': csrfToken
        }
      });
      
      const data = await response.json();
      console.log('✅ 동의 완료:', data);

      if (data.success) {
        window.location.reload();
      }
    } catch (error) {
      console.error('동의 저장 오류:', error);
      alert('오류가 발생했습니다. 다시 시도해주세요.');
    }
  }
  
  // 페이지 로드 시 실행
  document.addEventListener('DOMContentLoaded', function() {
    const loginModal = document.getElementById('loginModal');
    if (loginModal) {
      loginModal.addEventListener('click', function(e) {
        if (e.target === loginModal) {
          closeModal();
        }
      });
    }
    
    checkIPConsent();
  });
</script>