<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="/css/style.css">
  
  <style>
    :root {
      --body-bg: #ffffff;
      --card-bg: white;
      --text-color: #212529;
      --border-color: #dee2e6;
      --footer-bg: #f8f9fa;
      --navbar-bg: #0d6efd;
    }
    
    [data-theme="dark"] {
      --body-bg: #1a1a1a;
      --card-bg: #2d2d2d;
      --text-color: #e0e0e0;
      --border-color: #404040;
      --footer-bg: #2d2d2d;
      --navbar-bg: #0b5ed7;
    }
    
    body {
      background-color: var(--body-bg);
      color: var(--text-color);
      transition: all 0.3s ease;
    }
    
    .card {
      background-color: var(--card-bg);
      color: var(--text-color);
      border-color: var(--border-color);
      transition: all 0.3s ease;
    }
    
    [data-theme="dark"] .card:hover {
      background-color: #3a3a3a;
    }
    
    [data-theme="dark"] .text-muted {
      color: #aaa !important;
    }
    
    [data-theme="dark"] .lead {
      color: #d0d0d0;
    }
    
    footer {
      background-color: var(--footer-bg) !important;
      border-top: 1px solid var(--border-color);
    }
    
    .navbar {
      background-color: var(--navbar-bg) !important;
    }
    
    [data-theme="dark"] .modal-content {
      background-color: var(--card-bg);
      color: var(--text-color);
      border-color: var(--border-color);
    }
    
    [data-theme="dark"] .modal-header {
      border-bottom-color: var(--border-color);
    }
    
    [data-theme="dark"] .modal-footer {
      border-top-color: var(--border-color);
    }
    
    [data-theme="dark"] .btn-close {
      filter: invert(1);
    }
    
    [data-theme="dark"] .form-check-input {
      background-color: #3a3a3a;
      border-color: #505050;
    }
    
    [data-theme="dark"] .form-check-label {
      color: var(--text-color);
    }
    
    .dark-mode-toggle {
      position: fixed;
      top: 20px;
      right: 20px;
      z-index: 1050;
    }
    
    .toggle-btn {
      background-color: var(--card-bg);
      border: 2px solid var(--border-color);
      border-radius: 50px;
      padding: 8px 15px;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 8px;
      box-shadow: 0 2px 5px rgba(0,0,0,0.2);
      color: var(--text-color);
      transition: all 0.3s ease;
    }
    
    .toggle-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 4px 8px rgba(0,0,0,0.3);
    }
    
    .toggle-icon {
      font-size: 20px;
    }
  </style>
</head>
<body class="d-flex flex-column min-vh-100">
  <!-- 다크모드 토글 버튼 -->
  <div class="dark-mode-toggle">
    <button class="toggle-btn" onclick="toggleDarkMode()">
      <span class="toggle-icon" id="themeIcon">🌙</span>
      <span id="themeText">다크</span>
    </button>
  </div>

  <!-- 공지사항 모달 -->
  <% if (notice && notice.isActive) { %>
  <div class="modal fade" id="noticeModal" tabindex="-1" aria-labelledby="noticeModalLabel" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="noticeModalLabel"><%= notice.title %></h5>
        </div>
        <div class="modal-body">
          <%- notice.content %>
          
          <!-- 체크박스 -->
          <div class="form-check mt-3">
            <input class="form-check-input" type="checkbox" id="agreeCheckbox" required>
            <label class="form-check-label" for="agreeCheckbox">
              <strong class="text-danger">위 내용에 동의해야 여론조사에 참여할 수 있습니다</strong>
            </label>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" id="agreeButton" class="btn btn-primary" disabled>동의하고 시작하기</button>
        </div>
      </div>
    </div>
  </div>
  <% } %>

  <!-- 간단한 네비게이션 바 -->
  <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
    <div class="container">
      <a class="navbar-brand" href="/">여론조사</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav ms-auto">
          <li class="nav-item">
            <a class="nav-link" href="/polls">모든 여론조사</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/polls/new">새 여론조사 만들기</a>
          </li>
        </ul>
      </div>
    </div>
  </nav>

  <!-- 메인 콘텐츠 -->
  <div class="container my-4 flex-grow-1">
    <div class="row align-items-center">
      <!-- 왼쪽: 소개 텍스트 -->
      <div class="col-md-6">
        <h1 class="display-4 mb-3">쉽고 빠른 여론조사</h1>
        <p class="lead mb-4">간편하게 여론조사를 만들고, 실시간으로 결과를 확인하세요. 로그인이 필요 없는 간단한 서비스입니다.</p>
        <div class="d-flex gap-3">
          <a href="/polls" class="btn btn-primary btn-lg">여론조사 보기</a>
          <a href="/polls/new" class="btn btn-outline-primary btn-lg">새 여론조사 만들기</a>
        </div>
      </div>
      
      <!-- 오른쪽: 핵심 기능 카드 -->
      <div class="col-md-6 mt-4 mt-md-0">
        <div class="row g-3">
          <div class="col-md-6">
            <div class="card h-100 shadow-sm">
              <div class="card-body text-center">
                <h5 class="card-title">📊 투표하기</h5>
                <p class="card-text">다양한 주제의 여론조사에 참여해보세요.</p>
                <a href="/polls" class="stretched-link"></a>
              </div>
            </div>
          </div>
          <div class="col-md-6">
            <div class="card h-100 shadow-sm">
              <div class="card-body text-center">
                <h5 class="card-title">✨ 만들기</h5>
                <p class="card-text">나만의 여론조사를 만들어 공유해보세요.</p>
                <a href="/polls/new" class="stretched-link"></a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- 최근 여론조사 미리보기 (선택적) -->
    <div class="mt-5">
      <h2 class="mb-4">최신 여론조사</h2>
      <div id="recent-polls" class="row row-cols-1 row-cols-md-3 g-4">
        <% if (typeof recentPolls !== 'undefined' && recentPolls.length > 0) { %>
          <% recentPolls.slice(0, 3).forEach(poll => { %>
            <div class="col">
              <div class="card h-100">
                <div class="card-body">
                  <h5 class="card-title"><%= poll.title %></h5>
                  <% if (poll.description) { %>
                    <p class="card-text"><%= poll.description.length > 60 ? poll.description.substring(0, 60) + '...' : poll.description %></p>
                  <% } %>
                </div>
                <div class="card-footer bg-transparent">
                  <a href="/polls/<%= poll._id %>" class="btn btn-sm btn-outline-primary w-100">투표하기</a>
                </div>
              </div>
            </div>
          <% }); %>
        <% } else { %>
          <div class="col-12 text-center">
            <p class="text-muted">아직 생성된 여론조사가 없습니다. 첫 번째 여론조사를 만들어보세요!</p>
          </div>
        <% } %>
      </div>
    </div>
  </div>

  <!-- 간단한 푸터 -->
  <footer class="bg-light py-3 mt-auto">
    <div class="container text-center text-muted">
      <small>© 2025 여론조사 서비스</small>
    </div>
  </footer>

  <!-- JavaScript -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  
  <script>
    // 다크모드 함수들 (맨 위에 배치)
    function initDarkMode() {
      const savedTheme = localStorage.getItem('theme') || 'light';
      document.documentElement.setAttribute('data-theme', savedTheme);
      updateThemeIcon(savedTheme);
    }

    function toggleDarkMode() {
      const currentTheme = document.documentElement.getAttribute('data-theme');
      const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
      
      document.documentElement.setAttribute('data-theme', newTheme);
      localStorage.setItem('theme', newTheme);
      updateThemeIcon(newTheme);
    }

    function updateThemeIcon(theme) {
      const icon = document.getElementById('themeIcon');
      const text = document.getElementById('themeText');
      
      if (icon && text) {
        if (theme === 'dark') {
          icon.textContent = '☀️';
          text.textContent = '라이트';
        } else {
          icon.textContent = '🌙';
          text.textContent = '다크';
        }
      }
    }

    // 즉시 다크모드 초기화
    initDarkMode();
  </script>
  
  <!-- 모달 자동 띄우기 + 동의 체크 필수 -->
  <% if (notice && notice.isActive) { %>
  <script>
    window.addEventListener('DOMContentLoaded', () => {
      const hideNotice = localStorage.getItem('hideHomeNoticeUntil');
      const now = new Date().getTime();

      if (!hideNotice || now > parseInt(hideNotice)) {
        const noticeModal = new bootstrap.Modal(document.getElementById('noticeModal'));
        const agreeCheckbox = document.getElementById('agreeCheckbox');
        const agreeButton = document.getElementById('agreeButton');
        
        // 모달 표시
        noticeModal.show();

        // 체크박스 상태에 따라 버튼 활성화/비활성화
        agreeCheckbox.addEventListener('change', () => {
          agreeButton.disabled = !agreeCheckbox.checked;
        });

        // 동의 버튼 클릭 시
        agreeButton.addEventListener('click', async () => {
          console.log('동의 버튼 클릭, 체크박스:', agreeCheckbox.checked);

          if (agreeCheckbox.checked) {
            try {
              const response = await fetch('/api/agree-terms', {
                method: 'POST',
                headers: {
                  'Content-Type': 'application/json'
                }
              });

              const data = await response.json();
              console.log('약관 동의 기록됨:', data);

              // 24시간 동안 다시 안 보기
              const tomorrow = now + (24 * 60 * 60 * 1000);
              localStorage.setItem('hideHomeNoticeUntil', tomorrow.toString());
              console.log('✅ 동의 완료. 24시간 동안 숨김');

             // 모달 닫기
            noticeModal.hide();
          } catch (error) {
            console.error('약관 동의 기록 실패:', error);
            // 에러가 나도 모달은 닫기
            const tomorrow = now + (24 * 60 * 60 * 1000);
            localStorage.setItem('hideHomeNoticeUntil', tomorrow.toString());
            noticeModal.hide();
        }
        } else {
          alert('약관에 동의해야 여론조사에 참여할 수 있습니다.');
        }
    });
  }
});
  </script>
  <% } %>
</body>
</html>