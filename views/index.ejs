<style>
  .landing-container {
    max-width: 700px;
    margin: 0 auto;
  }
  
  .hero-section {
    text-align: center;
    background: var(--card-bg);
    border-radius: 30px;
    padding: 60px 40px;
    box-shadow: 0 20px 60px rgba(0,0,0,0.3);
    margin-bottom: 30px;
    transition: all 0.3s ease;
  }
  
  .hero-badge {
    display: inline-block;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    padding: 8px 20px;
    border-radius: 50px;
    font-size: 0.9rem;
    font-weight: 600;
    margin-bottom: 20px;
    box-shadow: 0 4px 15px rgba(102, 126, 234, 0.3);
  }
  
  .hero-title {
    font-size: 3rem;
    font-weight: 800;
    color: var(--text-color);
    margin-bottom: 20px;
    line-height: 1.2;
    letter-spacing: -1px;
  }
  
  .hero-subtitle {
    font-size: 1.3rem;
    color: var(--secondary-text);
    margin-bottom: 40px;
    line-height: 1.6;
  }
  
  .cta-button {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 18px 45px;
    font-size: 1.2rem;
    font-weight: 700;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    border: none;
    border-radius: 50px;
    cursor: pointer;
    transition: all 0.3s ease;
    text-decoration: none;
    box-shadow: 0 8px 25px rgba(102, 126, 234, 0.4);
  }
  
  .cta-button:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 40px rgba(102, 126, 234, 0.4);
    color: white;
  }
  
  .cta-icon {
    font-size: 1.5rem;
    animation: bounce 2s infinite;
  }
  
  @keyframes bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-5px); }
  }
  
  .auth-buttons {
    margin-top: 20px;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 15px;
  }

  .auth-link {
    color: var(--text-color);
    text-decoration: none;
    font-weight: 600;
    transition: all 0.3s ease;
    padding: 8px 20px;
    border-radius: 20px;
  }

  .auth-link:hover {
    color: #667eea;
    background: rgba(102, 126, 234, 0.1);
  }

  .separator {
    color: var(--secondary-text);
  }
  
  .user-info {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin-top: 20px;
    padding: 12px 25px;
    background: var(--feature-bg, #f8f9fa);
    border-radius: 50px;
  }
  
  [data-theme="dark"] .user-info {
    background: #3a3a3a;
  }
  
  .user-welcome {
    color: var(--text-color);
    font-weight: 600;
  }
  
  .btn-logout-small {
    padding: 6px 15px;
    background: #dc3545;
    color: white;
    border-radius: 20px;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 600;
    transition: all 0.3s ease;
  }
  
  .btn-logout-small:hover {
    background: #c82333;
    color: white;
    transform: translateY(-2px);
  }
  
  .features-section {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 20px;
    margin-top: 30px;
  }
  
  .feature-card {
    background: var(--card-bg);
    border-radius: 20px;
    padding: 35px 30px;
    text-align: center;
    transition: all 0.3s ease;
    box-shadow: 0 10px 30px rgba(0,0,0,0.2);
  }
  
  .feature-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 15px 40px rgba(0,0,0,0.3);
  }
  
  .feature-icon {
    font-size: 3rem;
    margin-bottom: 15px;
    display: block;
  }
  
  .feature-title {
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--text-color);
    margin-bottom: 10px;
  }
  
  .feature-desc {
    font-size: 1rem;
    color: var(--secondary-text);
    line-height: 1.6;
  }
  
  .secondary-actions {
    text-align: center;
    margin-top: 30px;
  }
  
  .secondary-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 30px;
    font-size: 1rem;
    font-weight: 600;
    background: transparent;
    color: white;
    border: 2px solid white;
    border-radius: 50px;
    cursor: pointer;
    transition: all 0.3s ease;
    text-decoration: none;
    margin: 0 10px;
  }
  
  .secondary-btn:hover {
    background: white;
    color: #667eea;
    transform: translateY(-3px);
  }
  
  /* 모달 스타일 */
  .modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.7);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 9999;
    animation: fadeIn 0.3s ease;
  }
  
  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  
  .modal-content {
    background: var(--card-bg, white);
    border-radius: 20px;
    padding: 40px 35px;
    max-width: 400px;
    width: 90%;
    text-align: center;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
    animation: slideUp 0.3s ease;
  }
  
  @keyframes slideUp {
    from {
      transform: translateY(50px);
      opacity: 0;
    }
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }
  
  [data-theme="dark"] .modal-content {
    background: #2d2d2d;
  }
  
  .modal-icon {
    font-size: 4rem;
    margin-bottom: 20px;
  }
  
  .modal-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-color, #333);
    margin-bottom: 15px;
  }
  
  [data-theme="dark"] .modal-title {
    color: #e0e0e0;
  }
  
  .modal-message {
    font-size: 1rem;
    color: var(--secondary-text, #666);
    margin-bottom: 30px;
    line-height: 1.6;
  }
  
  [data-theme="dark"] .modal-message {
    color: #aaa;
  }
  
  .modal-buttons {
    display: flex;
    gap: 10px;
  }
  
  .btn-modal-primary {
    flex: 1;
    padding: 15px 25px;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    border: none;
    border-radius: 50px;
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.3s ease;
  }
  
  .btn-modal-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(102, 126, 234, 0.4);
  }
  
  .btn-modal-secondary {
    flex: 1;
    padding: 15px 25px;
    background: transparent;
    color: var(--text-color, #333);
    border: 2px solid var(--border-color, #e0e0e0);
    border-radius: 50px;
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.3s ease;
  }
  
  [data-theme="dark"] .btn-modal-secondary {
    color: #e0e0e0;
    border-color: #555;
  }
  
  .btn-modal-secondary:hover {
    background: var(--border-color, #f0f0f0);
    transform: translateY(-2px);
  }
  
  [data-theme="dark"] .btn-modal-secondary:hover {
    background: #3a3a3a;
  }
  
  @media (max-width: 768px) {
    .hero-title {
      font-size: 2.2rem;
    }
    
    .hero-subtitle {
      font-size: 1.1rem;
    }
    
    .hero-section {
      padding: 40px 25px;
    }
    
    .cta-button {
      padding: 15px 35px;
      font-size: 1.1rem;
    }
    
    .features-section {
      grid-template-columns: 1fr;
    }
    
    .secondary-btn {
      display: flex;
      margin: 10px 0;
    }
    
    .auth-buttons {
      flex-direction: column;
      gap: 10px;
    }
  }
</style>

<div class="landing-container">
  <div class="hero-section">
    <div class="hero-badge">🎯 실시간 투표 시스템</div>
    <h1 class="hero-title">빠르고 쉬운<br>여론조사</h1>
    <p class="hero-subtitle">
      누구나 쉽게 만들고, 실시간으로 결과를 확인할 수 있는<br>
      스마트한 여론조사 플랫폼
    </p>
    
    <a href="/polls" class="cta-button">
      <span class="cta-icon">📋</span>
      <span>여론조사 둘러보기</span>
    </a>
    
    <div class="secondary-actions" style="margin-top: 20px;">
      <% if (user) { %>
        <a href="/polls/new" class="secondary-btn">
          <span>➕</span>
          <span>투표 만들기</span>
        </a>
      <% } else { %>
        <button class="secondary-btn" onclick="showLoginModal()">
          <span>🔒</span>
          <span>투표 만들기</span>
        </button>
      <% } %>
    </div>
    
    <% if (user) { %>
      <div class="user-info">
        <span class="user-welcome">👤 <strong><%= user.username %></strong>님 환영합니다!</span>
        <a href="/auth/logout" class="btn-logout-small">로그아웃</a>
      </div>
    <% } else { %>
      <div class="auth-buttons">
        <a href="/auth/login" class="auth-link">로그인</a>
        <span class="separator">|</span>
        <a href="/auth/register" class="auth-link">회원가입</a>
      </div>
    <% } %>
  </div>

  <div class="features-section">
    <div class="feature-card">
      <span class="feature-icon">⚡</span>
      <h3 class="feature-title">실시간 결과</h3>
      <p class="feature-desc">투표 결과가 실시간으로 업데이트되어 즉각적인 피드백을 받을 수 있어요</p>
    </div>
    
    <div class="feature-card">
      <span class="feature-icon">🔒</span>
      <h3 class="feature-title">중복 방지</h3>
      <p class="feature-desc">IP 기반 중복 투표 방지로 공정하고 정확한 투표 결과를 보장해요</p>
    </div>
    
    <div class="feature-card">
      <span class="feature-icon">📊</span>
      <h3 class="feature-title">지역별 통계</h3>
      <p class="feature-desc">투표자의 지역 정보를 자동으로 수집하여 상세한 통계를 제공해요</p>
    </div>
  </div>

  <div class="secondary-actions">
    <a href="/polls" class="secondary-btn">
      <span>📋</span>
      <span>여론조사 둘러보기</span>
    </a>
  </div>
</div>

<!-- 모달 팝업 -->
<div id="loginModal" class="modal-overlay" style="display: none;">
  <div class="modal-content">
    <div class="modal-icon">🔒</div>
    <h3 class="modal-title">로그인이 필요합니다</h3>
    <p class="modal-message">투표를 만들려면 로그인이 필요합니다.</p>
    <div class="modal-buttons">
      <button class="btn-modal-primary" onclick="goToLogin()">로그인하기</button>
      <button class="btn-modal-secondary" onclick="closeModal()">취소</button>
    </div>
  </div>
</div>

<script>
  // 모달 표시
  function showLoginModal() {
    document.getElementById('loginModal').style.display = 'flex';
    document.body.style.overflow = 'hidden';
  }
  
  // 모달 닫기
  function closeModal() {
    document.getElementById('loginModal').style.display = 'none';
    document.body.style.overflow = 'auto';
  }
  
  // 로그인 페이지로 이동
  function goToLogin() {
    window.location.href = '/auth/login?message=' + encodeURIComponent('투표를 만들려면 로그인이 필요합니다');
  }
  
  // 오버레이 클릭 시 닫기
  document.addEventListener('DOMContentLoaded', function() {
    const modal = document.getElementById('loginModal');
    if (modal) {
      modal.addEventListener('click', function(e) {
        if (e.target === modal) {
          closeModal();
        }
      });
    }
  });
</script>