<style>
  /* 기존 스타일 전부 유지 */
</style>

<div class="landing-container">
  <!-- 기존 HTML 전부 유지 -->
</div>

<!-- 로그인 모달 -->
<div id="loginModal" class="modal-overlay" style="display: none;">
  <div class="modal-content">
    <div class="modal-icon">🔒</div>
    <h3 class="modal-title">로그인이 필요합니다</h3>
    <p class="modal-message">투표를 만들려면 로그인이 필요합니다.</p>
    <div class="modal-buttons">
      <button class="btn-modal-primary" onclick="goToLogin()">로그인하기</button>
      <button class="btn-modal-secondary" onclick="closeModal()">취소</button>
    </div>
  </div>
</div>

<!-- IP 동의 모달 (Bootstrap) -->
<div class="modal fade" id="ipConsentModal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">🔒 개인정보 수집 및 이용 동의</h5>
      </div>
      <div class="modal-body">
        <h6>1. 수집 목적</h6>
        <p>투표의 공정성 확보 및 중복 투표 방지</p>
        
        <h6>2. 수집 항목</h6>
        <p>IP 주소, 지역 정보 (국가, 도시)</p>
        
        <h6>3. 보유 기간</h6>
        <p>투표 종료 후 1년</p>
        
        <h6>4. 거부 권리</h6>
        <p>동의를 거부할 권리가 있으며, 거부 시 투표 서비스 이용이 제한됩니다.</p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-primary" onclick="acceptConsent()">동의합니다</button>
      </div>
    </div>
  </div>
</div>

<script>
  // ========================================
  // 로그인 모달 관련
  // ========================================
  function showLoginModal() {
    document.getElementById('loginModal').style.display = 'flex';
    document.body.style.overflow = 'hidden';
  }
  
  function closeModal() {
    document.getElementById('loginModal').style.display = 'none';
    document.body.style.overflow = 'auto';
  }
  
  function goToLogin() {
    window.location.href = '/auth/login?message=' + encodeURIComponent('투표를 만들려면 로그인이 필요합니다');
  }
  
  // ========================================
  // IP 동의 모달 관련
  // ========================================
  async function checkIPConsent() {
    try {
      const response = await fetch('/admin/consent/check');
      const data = await response.json();
      
      console.log('IP 동의 확인:', data);
      
      if (!data.hasConsent) {
        setTimeout(() => {
          const ipModal = new bootstrap.Modal(document.getElementById('ipConsentModal'));
          ipModal.show();
        }, 1000);
      }
    } catch (error) {
      console.error('동의 확인 오류:', error);
    }
  }
  
  async function acceptConsent() {
    try {
      const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content ||
                        document.querySelector('input[name="_csrf"]')?.value;

      const response = await fetch('/admin/consent/accept', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'CSRF-Token': csrfToken
        }
      });
      
      const data = await response.json();
      console.log('동의 응답:', data);
      
      if (data.success) {
        console.log('✅ 동의 완료');
        const modalElement = document.getElementById('ipConsentModal');
        const modalInstance = bootstrap.Modal.getInstance(modalElement);
        if (modalInstance) {
          modalInstance.hide();
        }
      }
    } catch (error) {
      console.error('동의 저장 오류:', error);
      alert('오류가 발생했습니다. 다시 시도해주세요.');
    }
  }
  
  // ========================================
  // 페이지 로드 시 실행
  // ========================================
  document.addEventListener('DOMContentLoaded', function() {
    // 로그인 모달 오버레이 클릭 시 닫기
    const loginModal = document.getElementById('loginModal');
    if (loginModal) {
      loginModal.addEventListener('click', function(e) {
        if (e.target === loginModal) {
          closeModal();
        }
      });
    }
    
    // IP 동의 확인
    checkIPConsent();
  });
</script>