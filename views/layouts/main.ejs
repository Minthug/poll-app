<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : '여론조사 플랫폼' %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="/css/style.css">
  
  <style>
    :root {
      --bg-gradient-start: #667eea;
      --bg-gradient-end: #764ba2;
      --card-bg: white;
      --text-color: #333;
      --secondary-text: #666;
      --border-color: #e0e0e0;
    }
    
    [data-theme="dark"] {
      --bg-gradient-start: #1a1a2e;
      --bg-gradient-end: #16213e;
      --card-bg: #2d2d2d;
      --text-color: #e0e0e0;
      --secondary-text: #aaa;
      --border-color: #404040;
    }
    
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: linear-gradient(135deg, var(--bg-gradient-start) 0%, var(--bg-gradient-end) 100%);
      min-height: 100vh;
      padding: 40px 20px;
      transition: background 0.3s ease;
    }
    
    /* 홈 버튼 */
    .home-button {
      position: fixed;
      top: 20px;
      left: 20px;
      z-index: 1040;
      background-color: var(--card-bg);
      border: 2px solid var(--border-color);
      border-radius: 50px;
      padding: 10px 20px;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 8px;
      box-shadow: 0 2px 5px rgba(0,0,0,0.2);
      color: var(--text-color);
      text-decoration: none;
      transition: all 0.3s ease;
      font-weight: 500;
    }

    .home-button:hover {
      transform: translateY(-2px);
      box-shadow: 0 4px 8px rgba(0,0,0,0.3);
      color: var(--text-color);
    }

    .home-icon {
      font-size: 20px;
    }
    
    .dark-mode-toggle {
      position: fixed;
      top: 20px;
      right: 20px;
      z-index: 1050;
    }
    
    .toggle-btn {
      background-color: var(--card-bg);
      border: 2px solid var(--border-color);
      border-radius: 50px;
      padding: 10px 20px;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 8px;
      box-shadow: 0 2px 5px rgba(0,0,0,0.2);
      color: var(--text-color);
      transition: all 0.3s ease;
    }
    
    .toggle-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 4px 8px rgba(0,0,0,0.3);
    }
    
    .toggle-icon {
      font-size: 20px;
    }
    
    /* ⭐ 레이아웃 그리드 */
    .layout-with-sidebar {
      max-width: 1400px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 1fr 350px;
      gap: 30px;
      align-items: start;
      padding: 0 20px;
    }
    
    .main-content {
      min-width: 0;
    }
    
    .layout-sidebar {
      position: sticky;
      top: 80px;
    }
    
    /* 랭킹이 필요 없는 페이지용 */
    .layout-full-width {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 20px;
    }
    
    @media (max-width: 992px) {
      .layout-with-sidebar {
        grid-template-columns: 1fr;
      }
      
      .layout-sidebar {
        order: -1;
        position: static;
      }
    }
  </style>
  
  <%- style %>
</head>
<body>
  <!-- 홈 버튼 -->
  <a href="/" class="home-button">
    <span class="home-icon">🏠</span>
    <span>홈</span>
  </a>

  <!-- 다크모드 토글 -->
  <div class="dark-mode-toggle">
    <button class="toggle-btn" onclick="toggleDarkMode()">
      <span class="toggle-icon" id="themeIcon">🌙</span>
      <span id="themeText">다크</span>
    </button>
  </div>
  
  <!-- ⭐ 레이아웃 선택 -->
  <% if (typeof showRanking !== 'undefined' && showRanking) { %>
    <div class="layout-with-sidebar">
      <div class="main-content">
        <%- body %>
      </div>
      <aside class="layout-sidebar">
        <%- include('../partials/ranking-widget') %>
      </aside>
    </div>
  <% } else { %>
    <div class="layout-full-width">
      <%- body %>
    </div>
  <% } %>

  <script src="/js/common.js"></script>
  
  <script>
    function initDarkMode() {
      const savedTheme = localStorage.getItem('theme') || 'light';
      document.documentElement.setAttribute('data-theme', savedTheme);
      updateThemeIcon(savedTheme);
    }

    function toggleDarkMode() {
      const currentTheme = document.documentElement.getAttribute('data-theme');
      const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
      
      document.documentElement.setAttribute('data-theme', newTheme);
      localStorage.setItem('theme', newTheme);
      updateThemeIcon(newTheme);
    }

    function updateThemeIcon(theme) {
      const icon = document.getElementById('themeIcon');
      const text = document.getElementById('themeText');
      
      if (icon && text) {
        if (theme === 'dark') {
          icon.textContent = '☀️';
          text.textContent = '라이트';
        } else {
          icon.textContent = '🌙';
          text.textContent = '다크';
        }
      }
    }

    initDarkMode();
  </script>
  
  <%- script %>
</body>
</html>