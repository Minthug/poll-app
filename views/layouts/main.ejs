<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  
  <!-- ⭐ 기본 메타 태그 -->
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle : (typeof title !== 'undefined' ? title : '여론조사 플랫폼') %></title>
  <meta name="description" content="<%= typeof pageDescription !== 'undefined' ? pageDescription : '실시간 여론조사 투표 플랫폼. 간편하게 투표를 만들고 참여하세요.' %>">
  <meta name="keywords" content="여론조사, 투표, 설문조사, 온라인투표, 실시간투표">
  <meta name="author" content="한국 여론조사">
  
  <!-- ⭐ Open Graph (Facebook, 카카오톡, LinkedIn 등) -->
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="한국 여론조사">
  <meta property="og:title" content="<%= typeof ogTitle !== 'undefined' ? ogTitle : '한국 여론조사 플랫폼' %>">
  <meta property="og:description" content="<%= typeof ogDescription !== 'undefined' ? ogDescription : '실시간 여론조사 투표 플랫폼. 간편하게 투표를 만들고 참여하세요.' %>">
  <meta property="og:url" content="<%= typeof ogUrl !== 'undefined' ? ogUrl : 'http://localhost:3000' %>">
  <% if (typeof ogImage !== 'undefined' && ogImage) { %>
  <meta property="og:image" content="<%= ogImage %>">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <% } %>
  
  <!-- ⭐ Twitter Card (트위터, X) -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= typeof ogTitle !== 'undefined' ? ogTitle : '한국 여론조사 플랫폼' %>">
  <meta name="twitter:description" content="<%= typeof ogDescription !== 'undefined' ? ogDescription : '실시간 여론조사 투표 플랫폼' %>">
  <% if (typeof ogImage !== 'undefined' && ogImage) { %>
  <meta name="twitter:image" content="<%= ogImage %>">
  <% } %>
  
  <!-- ⭐ 네이버 블로그/카페 -->
  <meta property="og:article:author" content="한국 여론조사">
  
  <!-- ⭐ 디스코드 Embed -->
  <meta name="theme-color" content="#667eea">
  
  <!-- ⭐ 카카오톡 특화 -->
  <meta property="og:locale" content="ko_KR">
  
  <!-- ⭐ 커뮤니티 사이트 -->
  <link rel="canonical" href="<%= typeof ogUrl !== 'undefined' ? ogUrl : 'http://localhost:3000' %>">
  
  <!-- CSS -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="/css/style.css">
  
  <style>
    :root {
      --bg-gradient-start: #667eea;
      --bg-gradient-end: #764ba2;
      --card-bg: white;
      --text-color: #2c3e50;
      --secondary-text: #34495e;
      --border-color: #e0e0e0;
    }
    
    [data-theme="dark"] {
      --bg-gradient-start: #1a1a2e;
      --bg-gradient-end: #16213e;
      --card-bg: #2d2d2d;
      --text-color: #e0e0e0;
      --secondary-text: #aaa;
      --border-color: #404040;
    }
    
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: linear-gradient(135deg, var(--bg-gradient-start) 0%, var(--bg-gradient-end) 100%);
      min-height: 100vh;
      padding: 40px 20px;
      transition: background 0.3s ease;
      color: var(--text-color);
    }
    
    /* 홈 버튼 */
    .home-button {
      position: fixed;
      top: 20px;
      left: 20px;
      z-index: 1040;
      background-color: var(--card-bg);
      border: 2px solid var(--border-color);
      border-radius: 50px;
      padding: 10px 20px;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 8px;
      box-shadow: 0 2px 5px rgba(0,0,0,0.2);
      color: #2c3e50;
      text-decoration: none;
      transition: all 0.3s ease;
      font-weight: 700;
    }

    .home-button:hover {
      transform: translateY(-2px);
      box-shadow: 0 4px 8px rgba(0,0,0,0.3);
      color: #2c3e50;
    }

    [data-theme="dark"] .home-button {
      color: #e0e0e0;
    }

    [data-theme="dark"] .home-button:hover {
      color: #e0e0e0;
    }

    .home-icon {
      font-size: 20px;
    }
    
    .dark-mode-toggle {
      position: fixed;
      top: 20px;
      right: 20px;
      z-index: 1050;
    }

    .profile-button {
      position: fixed;
      top: 20px;
      left: 140px;
      z-index: 1040;
      background-color: var(--card-bg);
      border: 2px solid var(--border-color);
      border-radius: 50px;
      padding: 10px 20px;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 8px;
      box-shadow: 0 2px 5px rgba(0,0,0,0.2);
      color: #2c3e50;
      text-decoration: none;
      transition: all 0.3s ease;
      font-weight: 700;
    }    

    .profile-button:hover {
      transform: translateY(-2px);
      box-shadow: 0 4px 8px rgba(0,0,0,0.3);
      color: #2c3e50;
    }

    [data-theme="dark"] .profile-button {
      color: #e0e0e0;
    }

    [data-theme="dark"] .profile-button:hover {
      color: #e0e0e0;
    }

    .profile-icon {
      font-size: 20px;
    }
    
    .toggle-btn {
      background-color: var(--card-bg);
      border: 2px solid var(--border-color);
      border-radius: 50px;
      padding: 10px 20px;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 8px;
      box-shadow: 0 2px 5px rgba(0,0,0,0.2);
      color: #2c3e50;
      transition: all 0.3s ease;
      font-weight: 700;
    }
    
    [data-theme="dark"] .toggle-btn {
      color: #e0e0e0;
    }
    
    .toggle-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 4px 8px rgba(0,0,0,0.3);
    }
    
    .toggle-icon {
      font-size: 20px;
    }
    
    /* 레이아웃 그리드 */
    .layout-with-sidebar {
      max-width: 1400px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 1fr 350px;
      gap: 30px;
      align-items: start;
      padding: 0 20px;
    }
    
    .main-content {
      min-width: 0;
    }
    
    .layout-sidebar {
      position: sticky;
      top: 80px;
    }
    
    /* 랭킹이 필요 없는 페이지용 */
    .layout-full-width {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 20px;
    }
    
    @media (max-width: 992px) {
      .layout-with-sidebar {
        grid-template-columns: 1fr;
      }
      
      .layout-sidebar {
        order: -1;
        position: static;
      }
    }
  </style>
  
  <%- style %>
</head>
<body>
  <!-- 홈 버튼 -->
  <a href="/" class="home-button">
    <span class="home-icon">🏠</span>
    <span>홈</span>
  </a>

  <!-- 다크모드 토글 -->
  <div class="dark-mode-toggle">
    <button class="toggle-btn" onclick="toggleDarkMode()">
      <span class="toggle-icon" id="themeIcon">🌙</span>
      <span id="themeText">다크</span>
    </button>
  </div>
  
  <!-- 프로필 버튼 (로그인 한 경우만)-->
   <% if (typeof user !== 'undefined' && user) { %>
    <a href="/profile" class="profile-button">
      <span class="profile-icon">👤</span>
      <span>프로필</span>
    </a>
    <% } %>

  <!-- 레이아웃 선택 -->
  <% if (typeof showRanking !== 'undefined' && showRanking) { %>
    <div class="layout-with-sidebar">
      <div class="main-content">
        <%- body %>
      </div>
      <aside class="layout-sidebar">
        <%- include('../partials/ranking-widget') %>
      </aside>
    </div>
  <% } else { %>
    <div class="layout-full-width">
      <%- body %>
    </div>
  <% } %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/common.js"></script>
  
  <script>
    function initDarkMode() {
      const savedTheme = localStorage.getItem('theme') || 'light';
      document.documentElement.setAttribute('data-theme', savedTheme);
      updateThemeIcon(savedTheme);
    }

    function toggleDarkMode() {
      const currentTheme = document.documentElement.getAttribute('data-theme');
      const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
      
      document.documentElement.setAttribute('data-theme', newTheme);
      localStorage.setItem('theme', newTheme);
      updateThemeIcon(newTheme);
    }

    function updateThemeIcon(theme) {
      const icon = document.getElementById('themeIcon');
      const text = document.getElementById('themeText');
      
      if (icon && text) {
        if (theme === 'dark') {
          icon.textContent = '☀️';
          text.textContent = '라이트';
        } else {
          icon.textContent = '🌙';
          text.textContent = '다크';
        }
      }
    }

    initDarkMode();
  </script>
  
  <%- script %>
</body>
</html>