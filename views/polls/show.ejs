<% layout = false %>

<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= poll.title %> | 여론조사</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="/css/style.css">
  
  <style>
    :root {
      --bg-gradient-start: #667eea;
      --bg-gradient-end: #764ba2;
      --card-bg: white;
      --text-color: #333;
      --secondary-text: #666;
      --border-color: #e0e0e0;
    }
    
    [data-theme="dark"] {
      --bg-gradient-start: #1a1a2e;
      --bg-gradient-end: #16213e;
      --card-bg: #2d2d2d;
      --text-color: #e0e0e0;
      --secondary-text: #aaa;
      --border-color: #404040;
    }
    
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: linear-gradient(135deg, var(--bg-gradient-start) 0%, var(--bg-gradient-end) 100%);
      min-height: 100vh;
      padding: 40px 20px;
      transition: background 0.3s ease;
    }
    
    .vote-container {
      max-width: 800px;
      margin: 0 auto;
    }
    
    /* 헤더 카드 */
    .poll-header-card {
      background: var(--card-bg);
      border-radius: 30px;
      padding: 40px;
      box-shadow: 0 20px 60px rgba(0,0,0,0.3);
      margin-bottom: 30px;
      text-align: center;
    }
    
    .poll-badges {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      justify-content: center;
      margin-bottom: 20px;
    }
    
    .poll-badge {
      padding: 6px 15px;
      border-radius: 20px;
      font-size: 0.85rem;
      font-weight: 600;
    }
    
    .badge-category {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
    }
    
    .badge-tag {
      background: var(--border-color);
      color: var(--text-color);
    }
    
    [data-theme="dark"] .badge-tag {
      background: #404040;
    }
    
    .poll-title {
      font-size: 2.5rem;
      font-weight: 800;
      color: var(--text-color);
      margin-bottom: 15px;
      line-height: 1.3;
    }
    
    .poll-description {
      font-size: 1.2rem;
      color: var(--secondary-text);
      line-height: 1.6;
    }
    
    /* 투표 옵션 */
    .vote-card {
      background: var(--card-bg);
      border-radius: 20px;
      padding: 40px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.2);
    }
    
    .vote-instruction {
      text-align: center;
      color: var(--secondary-text);
      margin-bottom: 30px;
      font-size: 0.95rem;
    }
    
    .options-grid {
      display: grid;
      gap: 15px;
      margin-bottom: 30px;
    }
    
    .option-card {
      background: var(--card-bg);
      border: 3px solid var(--border-color);
      border-radius: 20px;
      padding: 30px;
      cursor: pointer;
      transition: all 0.3s ease;
      position: relative;
      overflow: hidden;
    }
    
    .option-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 10px 30px rgba(102, 126, 234, 0.3);
      border-color: #667eea;
    }
    
    .option-card.selected {
      border-color: #667eea;
      background: linear-gradient(135deg, rgba(102, 126, 234, 0.1) 0%, rgba(118, 75, 162, 0.1) 100%);
      transform: scale(1.02);
    }
    
    [data-theme="dark"] .option-card.selected {
      background: linear-gradient(135deg, rgba(102, 126, 234, 0.2) 0%, rgba(118, 75, 162, 0.2) 100%);
    }
    
    .option-text {
      font-size: 1.5rem;
      font-weight: 700;
      color: var(--text-color);
      text-align: center;
      margin-bottom: 15px;
    }
    
    .option-progress {
      height: 35px;
      background: var(--border-color);
      border-radius: 50px;
      overflow: hidden;
      position: relative;
    }
    
    .progress-bar {
      height: 100%;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      font-weight: 700;
      font-size: 0.95rem;
      transition: width 0.6s ease;
    }
    
    /* 선택 알림 */
    .selected-alert {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
      padding: 15px 25px;
      border-radius: 15px;
      text-align: center;
      margin-bottom: 20px;
      font-weight: 600;
      box-shadow: 0 4px 15px rgba(102, 126, 234, 0.3);
    }
    
    /* 투표 버튼 */
    .vote-button {
      width: 100%;
      padding: 18px;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
      border: none;
      border-radius: 50px;
      font-size: 1.2rem;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.3s ease;
      box-shadow: 0 8px 25px rgba(102, 126, 234, 0.4);
    }
    
    .vote-button:hover:not(:disabled) {
      transform: translateY(-3px);
      box-shadow: 0 12px 35px rgba(102, 126, 234, 0.5);
    }
    
    .vote-button:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }
    
    /* 결과 보기 링크 */
    .result-link {
      display: block;
      text-align: center;
      margin-top: 20px;
      color: var(--text-color);
      text-decoration: none;
      font-weight: 600;
      transition: all 0.3s ease;
    }
    
    .result-link:hover {
      color: #667eea;
      transform: translateY(-2px);
    }
    
    /* 반응형 */
    @media (max-width: 768px) {
      .poll-title {
        font-size: 2rem;
      }
      
      .poll-description {
        font-size: 1rem;
      }
      
      .option-text {
        font-size: 1.2rem;
      }
      
      .vote-card {
        padding: 25px;
      }
    }
  </style>
</head>
<body>
  <!-- 홈 버튼 -->
  <a href="/" class="home-button">
    <span class="home-icon">🏠</span>
    <span>홈</span>
  </a>

  <!-- 다크모드 토글 버튼 -->
  <div class="dark-mode-toggle">
    <button class="toggle-btn" onclick="toggleDarkMode()">
      <span class="toggle-icon" id="themeIcon">🌙</span>
      <span id="themeText">다크</span>
    </button>
  </div>

  <!-- 메인 콘텐츠 -->
  <div class="vote-container">
    <!-- 헤더 -->
    <div class="poll-header-card">
      <!-- 배지 -->
      <div class="poll-badges">
        <% if (poll.category) { %>
          <span class="poll-badge badge-category"><%= poll.category %></span>
        <% } %>
        <% if (poll.tags && poll.tags.length > 0) { %>
          <% poll.tags.forEach(tag => { %>
            <span class="poll-badge badge-tag">#<%= tag %></span>
          <% }); %>
        <% } %>
      </div>
      
      <!-- 제목 -->
      <h1 class="poll-title"><%= poll.title %></h1>
      
      <!-- 설명 -->
      <% if (poll.description) { %>
        <p class="poll-description"><%= poll.description %></p>
      <% } %>
    </div>

    <!-- 투표 카드 -->
    <div class="vote-card">
      <p class="vote-instruction">
        💡 원하는 옵션을 <strong>클릭</strong>하여 선택하고 투표하세요<br>
        <strong>더블클릭</strong>으로 바로 투표할 수 있습니다
      </p>
      
      <form id="vote-form" data-poll-id="<%= poll._id %>">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" id="csrf-token">
        <!-- 선택 알림 (숨김 상태) -->
        <div class="selected-alert d-none" id="selected-alert">
          선택: <span id="selected-option-text"></span>
        </div>
        
        <!-- 옵션 목록 -->
        <div class="options-grid">
          <% 
            const totalVotes = poll.options.reduce((sum, opt) => sum + opt.votes, 0);
            poll.options.forEach(option => { 
              const percentage = totalVotes > 0 ? ((option.votes / totalVotes) * 100).toFixed(1) : 0;
          %>
            <div class="option-card" data-option-id="<%= option._id %>">
              <h3 class="option-text card-title"><%= option.text %></h3>
              <div class="option-progress">
                <div class="progress-bar" style="width: <%= percentage %>%">
                  <%= option.votes %>표 (<%= percentage %>%)
                </div>
              </div>
            </div>
          <% }); %>
        </div>
        
        <input type="hidden" id="option-id-input" name="optionId">
        
        <button type="submit" class="vote-button" id="vote-btn" disabled>
          🗳️ 투표하기
        </button>
      </form>
      
      <a href="/polls/<%= poll._id %>/result" class="result-link">
        📊 결과만 보기
      </a>
    </div>
  </div>

  <!-- 공지사항 모달 -->
  <div class="modal fade" id="noticeModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">📢 투표 안내</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <h6>투표 방법</h6>
          <ul>
            <li>원하는 옵션을 <strong>클릭</strong>하면 선택됩니다</li>
            <li>같은 옵션을 <strong>더블클릭</strong>하면 바로 투표됩니다</li>
            <li>한 번만 투표가 가능합니다 (IP 기반 중복 방지)</li>
          </ul>
          <div class="alert alert-info mb-0">
            실시간으로 투표 결과가 업데이트됩니다! 📊
          </div>
          
          <div class="form-check mt-3">
            <input class="form-check-input" type="checkbox" id="dontShowToday">
            <label class="form-check-label" for="dontShowToday">
              오늘 하루 보지 않기
            </label>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-primary" data-bs-dismiss="modal">확인</button>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/socket.io/socket.io.js"></script>
  <script src="/js/touchpad-poll.js"></script>
  
  <script>
    // 다크모드 함수들
    function initDarkMode() {
      const savedTheme = localStorage.getItem('theme') || 'light';
      document.documentElement.setAttribute('data-theme', savedTheme);
      updateThemeIcon(savedTheme);
    }

    function toggleDarkMode() {
      const currentTheme = document.documentElement.getAttribute('data-theme');
      const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
      
      document.documentElement.setAttribute('data-theme', newTheme);
      localStorage.setItem('theme', newTheme);
      updateThemeIcon(newTheme);
    }

    function updateThemeIcon(theme) {
      const icon = document.getElementById('themeIcon');
      const text = document.getElementById('themeText');
      
      if (icon && text) {
        if (theme === 'dark') {
          icon.textContent = '☀️';
          text.textContent = '라이트';
        } else {
          icon.textContent = '🌙';
          text.textContent = '다크';
        }
      }
    }

    // 즉시 다크모드 초기화
    initDarkMode();

    // 공지사항 모달
    window.addEventListener('DOMContentLoaded', () => {
      const hideNotice = localStorage.getItem('hideNoticeUntil');
      const now = new Date().getTime();

      if (!hideNotice || now > parseInt(hideNotice)) {
        const noticeModal = new bootstrap.Modal(document.getElementById('noticeModal'));
        noticeModal.show();

        document.getElementById('noticeModal').addEventListener('hidden.bs.modal', () => {
          const dontShow = document.getElementById('dontShowToday').checked;
          if (dontShow) {
            const tomorrow = now + (24 * 60 * 60 * 1000);
            localStorage.setItem('hideNoticeUntil', tomorrow.toString());
          }
        });
      }
    });
  </script>
</body>
</html>