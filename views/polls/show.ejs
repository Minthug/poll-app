<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= poll.title %> | 여론조사</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/touchpad-poll.css">
  
  <style>
    :root {
      --card-bg: white;
      --text-color: #212529;
      --modal-bg: white;
    }
    
    [data-theme="dark"] {
      --card-bg: #2d2d2d;
      --text-color: #e0e0e0;
      --modal-bg: #2d2d2d;
    }
    
    [data-theme="dark"] body {
      background-color: #1a1a1a;
    }
    
    [data-theme="dark"] .card {
      background-color: var(--card-bg);
      color: var(--text-color);
      border-color: #404040;
    }
    
    [data-theme="dark"] .option-card {
      background-color: #3a3a3a;
      border-color: #505050;
    }
    
    [data-theme="dark"] .option-card:hover {
      background-color: #454545;
    }
    
    [data-theme="dark"] .progress {
      background-color: #404040;
    }
    
    [data-theme="dark"] .modal-content {
      background-color: var(--modal-bg);
      color: var(--text-color);
      border-color: #404040;
    }
    
    [data-theme="dark"] .modal-header {
      border-bottom-color: #404040;
    }
    
    [data-theme="dark"] .modal-footer {
      border-top-color: #404040;
    }
    
    [data-theme="dark"] .btn-close {
      filter: invert(1);
    }
    
    .dark-mode-toggle {
      position: fixed;
      top: 20px;
      right: 20px;
      z-index: 1050;
    }
    
    .toggle-btn {
      background-color: var(--card-bg);
      border: 2px solid #dee2e6;
      border-radius: 50px;
      padding: 8px 15px;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 8px;
      box-shadow: 0 2px 5px rgba(0,0,0,0.2);
      color: var(--text-color);
      transition: all 0.3s ease;
    }
    
    [data-theme="dark"] .toggle-btn {
      border-color: #404040;
    }
    
    .toggle-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 4px 8px rgba(0,0,0,0.3);
    }
    
    .toggle-icon {
      font-size: 20px;
    }
  </style>
</head>
<body>
  <!-- 다크모드 토글 버튼 -->
  <div class="dark-mode-toggle">
    <button class="toggle-btn" onclick="toggleDarkMode()">
      <span class="toggle-icon" id="themeIcon">🌙</span>
      <span id="themeText">다크</span>
    </button>
  </div>

  <!-- 공지사항 모달 -->
  <div class="modal fade" id="noticeModal" tabindex="-1" aria-labelledby="noticeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="noticeModalLabel">📢 공지사항</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <h6>투표 방법 안내</h6>
          <ul>
            <li>원하는 옵션을 <strong>한 번 클릭</strong>하면 선택됩니다</li>
            <li>같은 옵션을 <strong>더블클릭</strong>하면 바로 투표됩니다</li>
            <li>한 번만 투표가 가능합니다 (IP 기반 중복 방지)</li>
          </ul>
          <div class="alert alert-info mb-0">
            실시간으로 투표 결과가 업데이트됩니다! 📊
          </div>
          
          <!-- 체크박스 추가-->
          <div class="form-check mt-3">
            <input class="form-check-input" type="checkbox" id="dontShowToday">
            <label class="form-check-label" for="dontShowToday">
              오늘 하루 보지 않기
            </label>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">닫기</button>
          <button type="button" class="btn btn-primary" data-bs-dismiss="modal">확인</button>
        </div>
      </div>
    </div>
  </div>

  <!-- 메인 컨텐츠 -->
  <div class="container mt-4">
    <div class="card shadow">
      <div class="card-header">
        <h1 class="h3 mb-0"><%= poll.title %></h1>
        <% if (poll.description) { %>
          <p class="text-muted mb-0"><%= poll.description %></p>
        <% } %>
      </div>
      
      <div class="card-body">
        <form id="vote-form" data-poll-id="<%= poll._id %>">
          <!-- 간단한 옵션 목록으로 변경 -->
          <div class="mb-4">
            <p class="mb-3">아래 옵션 중 하나를 선택하여 투표하세요:</p>
            <div class="row row-cols-1 row-cols-md-2 g-3">
              <% poll.options.forEach(option => { %>
                <div class="col">
                  <div class="option-card card h-100" data-option-id="<%= option._id %>">
                    <div class="card-body">
                      <h5 class="card-title text-center mb-3"><%= option.text %></h5>
                      
                      <div class="progress" style="height: 25px;">
                        <div class="progress-bar bg-gradient" 
                             role="progressbar" 
                             style="width: <%= 
                               (() => {
                                 const totalVotes = poll.options.reduce((sum, opt) => sum + opt.votes, 0);
                                 return totalVotes > 0 ? ((option.votes / totalVotes) * 100).toFixed(1) : 0;
                               })()
                             %>%"
                             aria-valuenow="<%= option.votes %>" 
                             aria-valuemin="0" 
                             aria-valuemax="100">
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              <% }); %>
            </div>
          </div>
         
          <div class="selected-option mb-3">
            <small class="text-muted">원하는 옵션을 선택하면 강조 표시됩니다. 더블클릭으로 바로 투표할 수 있습니다.</small>
            <div class="alert alert-primary mt-2 d-none">
              선택: <span id="selected-option-text"></span>
            </div>
          </div>
          
          <input type="hidden" id="option-id-input" name="optionId">
          <button type="submit" class="btn btn-primary" disabled>투표하기</button>
        </form>
        
        <div id="results-container" class="results-container d-none">
          <h4 class="mb-3">투표 결과</h4>
          <div id="results"></div>
          <p id="total-votes" class="mt-3 text-muted"></p>
          <div class="mt-3">
            <button id="back-to-vote" class="btn btn-outline-secondary">다시 투표하기</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- JavaScript 파일들 (맨 마지막에 위치) -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/socket.io/socket.io.js"></script>
  <script src="/js/touchpad-poll.js"></script>
  
  <!-- 모달 자동 띄우기 -->
  <script>
    // 다크모드 함수들 (맨 위에 배치)
    function initDarkMode() {
      const savedTheme = localStorage.getItem('theme') || 'light';
      document.documentElement.setAttribute('data-theme', savedTheme);
      updateThemeIcon(savedTheme);
    }

    function toggleDarkMode() {
      const currentTheme = document.documentElement.getAttribute('data-theme');
      const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
      
      document.documentElement.setAttribute('data-theme', newTheme);
      localStorage.setItem('theme', newTheme);
      updateThemeIcon(newTheme);
    }

    function updateThemeIcon(theme) {
      const icon = document.getElementById('themeIcon');
      const text = document.getElementById('themeText');
      
      if (icon && text) {
        if (theme === 'dark') {
          icon.textContent = '☀️';
          text.textContent = '라이트';
        } else {
          icon.textContent = '🌙';
          text.textContent = '다크';
        }
      }
    }

    // 즉시 다크모드 초기화
    initDarkMode();

    // 페이지 로드 시 모달 표시
    window.addEventListener('DOMContentLoaded', () => {
      const hideNotice = localStorage.getItem('hideNoticeUntil');
      const now = new Date().getTime();

      //저장된 시간이 없거나 지났으면 모달 표시
      if (!hideNotice || now > parseInt(hideNotice)) {
        const noticeModal = new bootstrap.Modal(document.getElementById('noticeModal'));
        noticeModal.show();

        //모달이 닫힐 때 체크박스 확인
        document.getElementById('noticeModal').addEventListener('hidden.bs.modal', () => {
          const dontShow = document.getElementById('dontShowToday').checked;
          if (dontShow) {
            // 24시간 후 timestamp 저장
            const tomorrow = now + (24 * 60 * 60 * 1000);
            localStorage.setItem('hideNoticeUntil', tomorrow.toString());
            console.log('공지사항을 24시간 동안 숨깁니다');
          }
        });
      } else {
        console.log('공지사항이 숨겨진 상태입니다. 다음 표시 시간:', new Date(parseInt(hideNotice)));
      }
    });
  </script>
</body>
</html>