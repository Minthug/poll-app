<!-- 메인 콘텐츠만 -->
<div class="container">
  <!-- 페이지 헤더 -->
  <div class="page-header">
    <h1 class="page-title">📊 여론조사 목록</h1>
    <p class="page-subtitle">진행 중인 모든 여론조사를 확인하고 투표하세요</p>
    <a href="/polls/new" class="create-btn">
      <span>➕</span>
      <span>새 여론조사 만들기</span>
    </a>
  </div>

  <!-- 카테고리 필터 -->
  <div class="category-filter">
    <h3 class="filter-title">🏷️ 카테고리</h3>
    <div class="category-buttons">
      <a href="/polls" class="category-btn <%= !category ? 'active' : '' %>">전체</a>
      <a href="/polls?category=일반" class="category-btn <%= category === '일반' ? 'active' : '' %>">일반</a>
      <a href="/polls?category=정치" class="category-btn <%= category === '정치' ? 'active' : '' %>">정치</a>
      <a href="/polls?category=경제" class="category-btn <%= category === '경제' ? 'active' : '' %>">경제</a>
      <a href="/polls?category=사회" class="category-btn <%= category === '사회' ? 'active' : '' %>">사회</a>
      <a href="/polls?category=문화" class="category-btn <%= category === '문화' ? 'active' : '' %>">문화</a>
      <a href="/polls?category=스포츠" class="category-btn <%= category === '스포츠' ? 'active' : '' %>">스포츠</a>
      <a href="/polls?category=게임" class="category-btn <%= category === '게임' ? 'active' : '' %>">게임</a>
      <a href="/polls?category=음식" class="category-btn <%= category === '음식' ? 'active' : '' %>">음식</a>
      <a href="/polls?category=기타" class="category-btn <%= category === '기타' ? 'active' : '' %>">기타</a>
    </div>
  </div>

  <!-- 여론조사 목록 -->
  <% if (polls && polls.length > 0) { %>
    <div class="polls-grid">
      <% polls.forEach(poll => { 
        const totalVotes = poll.options.reduce((sum, opt) => sum + opt.votes, 0);
      %>
        <a href="/polls/<%= poll._id %>" class="poll-card">
          <div class="poll-badges">
            <% if (poll.category) { %>
              <span class="poll-badge badge-category"><%= poll.category %></span>
            <% } %>
            <% if (poll.tags && poll.tags.length > 0) { %>
              <% poll.tags.slice(0, 3).forEach(tag => { %>
                <span class="poll-badge badge-tag">#<%= tag %></span>
              <% }); %>
            <% } %>
          </div>
          
          <h2 class="poll-card-title"><%= poll.title %></h2>
          
          <% if (poll.description) { %>
            <p class="poll-card-description"><%= poll.description %></p>
          <% } %>
          
          <div class="poll-card-meta">
            <div class="meta-item">
              <span>👥</span>
              <span><%= totalVotes %>명 참여</span>
            </div>
            <div class="meta-item">
              <span>📋</span>
              <span><%= poll.options.length %>개 선택지</span>
            </div>
            <div class="meta-item">
              <span>📅</span>
              <span><%= new Date(poll.createdAt).toLocaleDateString('ko-KR', { month: 'numeric', day: 'numeric' }) %></span>
            </div>
          </div>
        </a>
      <% }); %>
    </div>
  <% } else { %>
    <!-- 빈 상태 -->
    <div class="empty-state">
      <div class="empty-icon">📭</div>
      <h2 class="empty-title">아직 여론조사가 없습니다</h2>
      <p class="empty-subtitle">첫 번째 여론조사를 만들어보세요!</p>
      <a href="/polls/new" class="create-btn">
        <span>➕</span>
        <span>여론조사 만들기</span>
      </a>
    </div>
  <% } %>
</div>

<!-- 이 페이지만의 스타일 -->
<style>
  .container {
    max-width: 1200px;
    margin: 0 auto;
  }
  
  /* 헤더 */
  .page-header {
    background: var(--card-bg);
    border-radius: 30px;
    padding: 40px;
    box-shadow: 0 20px 60px rgba(0,0,0,0.3);
    margin-bottom: 30px;
    text-align: center;
  }
  
  .page-title {
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--text-color);
    margin-bottom: 15px;
  }
  
  .page-subtitle {
    font-size: 1.1rem;
    color: var(--secondary-text);
    margin-bottom: 25px;
  }
  
  .create-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 15px 35px;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    border: none;
    border-radius: 50px;
    font-size: 1.1rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.3s ease;
    text-decoration: none;
    box-shadow: 0 8px 25px rgba(102, 126, 234, 0.4);
  }
  
  .create-btn:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 35px rgba(102, 126, 234, 0.5);
    color: white;
  }
  
  /* 카테고리 필터 */
  .category-filter {
    background: var(--card-bg);
    border-radius: 20px;
    padding: 25px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.2);
    margin-bottom: 30px;
  }
  
  .filter-title {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--text-color);
    margin-bottom: 15px;
  }
  
  .category-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  
  .category-btn {
    padding: 10px 20px;
    border: 2px solid var(--border-color);
    background: transparent;
    color: var(--text-color);
    border-radius: 50px;
    cursor: pointer;
    transition: all 0.3s ease;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
  }
  
  .category-btn:hover {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    border-color: transparent;
  }
  
  .category-btn.active {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    border-color: transparent;
  }
  
  /* 여론조사 카드 그리드 */
  .polls-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
    gap: 25px;
    margin-bottom: 30px;
  }
  
  .poll-card {
    background: var(--card-bg);
    border-radius: 20px;
    padding: 30px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.2);
    transition: all 0.3s ease;
    cursor: pointer;
    text-decoration: none;
    display: block;
  }
  
  .poll-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 15px 40px rgba(0,0,0,0.3);
  }
  
  .poll-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 15px;
  }
  
  .poll-badge {
    padding: 6px 15px;
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 600;
  }
  
  .badge-category {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
  }
  
  .badge-tag {
    background: var(--border-color);
    color: var(--text-color);
  }
  
  [data-theme="dark"] .badge-tag {
    background: #404040;
  }
  
  .poll-card-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-color);
    margin-bottom: 12px;
    line-height: 1.3;
  }
  
  .poll-card-description {
    color: var(--secondary-text);
    margin-bottom: 20px;
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  .poll-card-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 15px;
    border-top: 2px solid var(--border-color);
    font-size: 0.9rem;
    color: var(--secondary-text);
  }
  
  .meta-item {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  
  /* 빈 상태 */
  .empty-state {
    background: var(--card-bg);
    border-radius: 20px;
    padding: 60px 40px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.2);
    text-align: center;
  }
  
  .empty-icon {
    font-size: 4rem;
    margin-bottom: 20px;
  }
  
  .empty-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-color);
    margin-bottom: 10px;
  }
  
  .empty-subtitle {
    color: var(--secondary-text);
    margin-bottom: 25px;
  }
  
  /* 반응형 */
  @media (max-width: 768px) {
    .page-title {
      font-size: 2rem;
    }
    
    .polls-grid {
      grid-template-columns: 1fr;
    }
    
    .category-buttons {
      justify-content: center;
    }
  }
</style>