<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>여론조사 목록</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="/css/style.css">
  
  <style>
    :root {
      --bg-gradient-start: #667eea;
      --bg-gradient-end: #764ba2;
      --card-bg: white;
      --text-color: #333;
      --secondary-text: #666;
      --border-color: #e0e0e0;
    }
    
    [data-theme="dark"] {
      --bg-gradient-start: #1a1a2e;
      --bg-gradient-end: #16213e;
      --card-bg: #2d2d2d;
      --text-color: #e0e0e0;
      --secondary-text: #aaa;
      --border-color: #404040;
    }
    
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: linear-gradient(135deg, var(--bg-gradient-start) 0%, var(--bg-gradient-end) 100%);
      min-height: 100vh;
      padding: 40px 20px;
      transition: background 0.3s ease;
    }
    
    .polls-container {
      max-width: 900px;
      margin: 0 auto;
    }
    
    /* 헤더 섹션 */
    .page-header {
      text-align: center;
      background: var(--card-bg);
      border-radius: 30px;
      padding: 40px 30px;
      box-shadow: 0 20px 60px rgba(0,0,0,0.3);
      margin-bottom: 30px;
    }
    
    .page-title {
      font-size: 2.5rem;
      font-weight: 800;
      color: var(--text-color);
      margin-bottom: 15px;
    }
    
    .page-subtitle {
      font-size: 1.1rem;
      color: var(--secondary-text);
      margin-bottom: 25px;
    }
    
    /* 카테고리 필터 */
    .category-filters {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      justify-content: center;
      margin-top: 25px;
    }
    
    .category-btn {
      padding: 8px 20px;
      border: 2px solid var(--border-color);
      background: transparent;
      color: var(--text-color);
      border-radius: 50px;
      cursor: pointer;
      transition: all 0.3s ease;
      font-size: 0.95rem;
      font-weight: 600;
      text-decoration: none;
    }
    
    .category-btn:hover {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
      border-color: transparent;
      transform: translateY(-2px);
    }
    
    .category-btn.active {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
      border-color: transparent;
    }
    
    /* 여론조사 카드 */
    .polls-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 20px;
      margin-top: 30px;
    }
    
    .poll-card {
      background: var(--card-bg);
      border-radius: 20px;
      padding: 30px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.2);
      transition: all 0.3s ease;
      cursor: pointer;
      text-decoration: none;
      color: var(--text-color);
      display: block;
    }
    
    .poll-card:hover {
      transform: translateY(-8px);
      box-shadow: 0 15px 40px rgba(0,0,0,0.3);
      color: var(--text-color);
    }
    
    .poll-header {
      margin-bottom: 15px;
    }
    
    .poll-badges {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 15px;
    }
    
    .poll-badge {
      padding: 5px 12px;
      border-radius: 20px;
      font-size: 0.85rem;
      font-weight: 600;
    }
    
    .badge-category {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
    }
    
    .badge-tag {
      background: var(--border-color);
      color: var(--text-color);
    }
    
    [data-theme="dark"] .badge-tag {
      background: #404040;
    }
    
    .poll-title {
      font-size: 1.4rem;
      font-weight: 700;
      color: var(--text-color);
      margin-bottom: 10px;
      line-height: 1.3;
    }
    
    .poll-description {
      font-size: 0.95rem;
      color: var(--secondary-text);
      line-height: 1.6;
      margin-bottom: 20px;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    
    .poll-meta {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-top: 15px;
      border-top: 1px solid var(--border-color);
      font-size: 0.9rem;
      color: var(--secondary-text);
    }
    
    .poll-stats {
      display: flex;
      gap: 15px;
    }
    
    .poll-date {
      font-size: 0.85rem;
    }
    
    /* 빈 상태 */
    .empty-state {
      text-align: center;
      background: var(--card-bg);
      border-radius: 20px;
      padding: 60px 40px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.2);
    }
    
    .empty-icon {
      font-size: 4rem;
      margin-bottom: 20px;
    }
    
    .empty-title {
      font-size: 1.5rem;
      font-weight: 700;
      color: var(--text-color);
      margin-bottom: 10px;
    }
    
    .empty-desc {
      color: var(--secondary-text);
      margin-bottom: 30px;
    }
    
    .create-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 15px 35px;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
      border: none;
      border-radius: 50px;
      font-size: 1.1rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.3s ease;
      text-decoration: none;
      box-shadow: 0 8px 25px rgba(102, 126, 234, 0.4);
    }
    
    .create-btn:hover {
      transform: translateY(-3px);
      box-shadow: 0 12px 35px rgba(102, 126, 234, 0.5);
      color: white;
    }
    
    /* 반응형 */
    @media (max-width: 768px) {
      .page-title {
        font-size: 2rem;
      }
      
      .polls-grid {
        grid-template-columns: 1fr;
      }
      
      .category-filters {
        flex-direction: column;
      }
      
      .category-btn {
        width: 100%;
      }
    }
  </style>
</head>
<body>
  <!-- 홈 버튼 -->
  <a href="/" class="home-button">
    <span class="home-icon">🏠</span>
    <span>홈</span>
  </a>

  <!-- 다크모드 토글 버튼 -->
  <div class="dark-mode-toggle">
    <button class="toggle-btn" onclick="toggleDarkMode()">
      <span class="toggle-icon" id="themeIcon">🌙</span>
      <span id="themeText">다크</span>
    </button>
  </div>

  <!-- 메인 콘텐츠 -->
  <div class="polls-container">
    <!-- 페이지 헤더 -->
    <div class="page-header">
      <h1 class="page-title">📊 여론조사 목록</h1>
      <p class="page-subtitle">진행 중인 모든 여론조사를 확인하고 투표하세요</p>
      
      <!-- 새 여론조사 만들기 버튼 -->
      <a href="/polls/new" class="create-btn">
        <span>➕</span>
        <span>새 여론조사 만들기</span>
      </a>
      
      <!-- 카테고리 필터 -->
      <div class="category-filters">
        <a href="/polls" class="category-btn <%= !category ? 'active' : '' %>">전체</a>
        <a href="/polls?category=일반" class="category-btn <%= category === '일반' ? 'active' : '' %>">일반</a>
        <a href="/polls?category=정치" class="category-btn <%= category === '정치' ? 'active' : '' %>">정치</a>
        <a href="/polls?category=경제" class="category-btn <%= category === '경제' ? 'active' : '' %>">경제</a>
        <a href="/polls?category=사회" class="category-btn <%= category === '사회' ? 'active' : '' %>">사회</a>
        <a href="/polls?category=문화" class="category-btn <%= category === '문화' ? 'active' : '' %>">문화</a>
        <a href="/polls?category=스포츠" class="category-btn <%= category === '스포츠' ? 'active' : '' %>">스포츠</a>
        <a href="/polls?category=게임" class="category-btn <%= category === '게임' ? 'active' : '' %>">게임</a>
        <a href="/polls?category=음식" class="category-btn <%= category === '음식' ? 'active' : '' %>">음식</a>
        <a href="/polls?category=기타" class="category-btn <%= category === '기타' ? 'active' : '' %>">기타</a>
      </div>
    </div>

    <!-- 여론조사 목록 -->
    <% if (polls && polls.length > 0) { %>
      <div class="polls-grid">
        <% polls.forEach(poll => { %>
          <a href="/polls/<%= poll._id %>" class="poll-card">
            <!-- 배지 -->
            <div class="poll-badges">
              <% if (poll.category) { %>
                <span class="poll-badge badge-category"><%= poll.category %></span>
              <% } %>
              <% if (poll.tags && poll.tags.length > 0) { %>
                <% poll.tags.slice(0, 2).forEach(tag => { %>
                  <span class="poll-badge badge-tag">#<%= tag %></span>
                <% }); %>
              <% } %>
            </div>
            
            <!-- 제목 -->
            <h3 class="poll-title"><%= poll.title %></h3>
            
            <!-- 설명 -->
            <% if (poll.description) { %>
              <p class="poll-description"><%= poll.description %></p>
            <% } else { %>
              <p class="poll-description">설명이 없습니다</p>
            <% } %>
            
            <!-- 메타 정보 -->
            <div class="poll-meta">
              <div class="poll-stats">
                <span>👥 <%= poll.options.reduce((sum, opt) => sum + opt.votes, 0) %>명 참여</span>
                <span>📝 <%= poll.options.length %>개 선택지</span>
              </div>
              <div class="poll-date">
                <%= new Date(poll.createdAt).toLocaleDateString('ko-KR', { month: 'short', day: 'numeric' }) %>
              </div>
            </div>
          </a>
        <% }); %>
      </div>
    <% } else { %>
      <!-- 빈 상태 -->
      <div class="empty-state">
        <div class="empty-icon">📭</div>
        <h2 class="empty-title">아직 여론조사가 없습니다</h2>
        <p class="empty-desc">첫 번째 여론조사를 만들어보세요!</p>
        <a href="/polls/new" class="create-btn">
          <span>➕</span>
          <span>새 여론조사 만들기</span>
        </a>
      </div>
    <% } %>
  </div>

  <% if (user) { %>
  <!-- 로그인한 경우 -->
  <div class="user-info">
    <span>👤 <strong><%= user.username %></strong>님 환영합니다!</span>
    <a href="/auth/logout" class="btn-logout">로그아웃</a>
  </div>
<% } else { %>
  <!-- 비로그인 -->
  <div class="auth-buttons">
    <a href="/auth/login" class="btn-auth">로그인</a>
    <a href="/auth/register" class="btn-auth primary">회원가입</a>
  </div>
<% } %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  
  <script>
    // 다크모드 함수들
    function initDarkMode() {
      const savedTheme = localStorage.getItem('theme') || 'light';
      document.documentElement.setAttribute('data-theme', savedTheme);
      updateThemeIcon(savedTheme);
    }

    function toggleDarkMode() {
      const currentTheme = document.documentElement.getAttribute('data-theme');
      const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
      
      document.documentElement.setAttribute('data-theme', newTheme);
      localStorage.setItem('theme', newTheme);
      updateThemeIcon(newTheme);
    }

    function updateThemeIcon(theme) {
      const icon = document.getElementById('themeIcon');
      const text = document.getElementById('themeText');
      
      if (icon && text) {
        if (theme === 'dark') {
          icon.textContent = '☀️';
          text.textContent = '라이트';
        } else {
          icon.textContent = '🌙';
          text.textContent = '다크';
        }
      }
    }

    // 즉시 다크모드 초기화
    initDarkMode();
  </script>
</body>
</html>