<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>여론조사 목록</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="/css/style.css">
  
  <style>
    :root {
      --body-bg: #f8f9fa;
      --card-bg: white;
      --text-color: #212529;
      --border-color: #dee2e6;
    }
    
    [data-theme="dark"] {
      --body-bg: #1a1a1a;
      --card-bg: #2d2d2d;
      --text-color: #e0e0e0;
      --border-color: #404040;
    }
    
    body {
      background-color: var(--body-bg);
      color: var(--text-color);
      transition: all 0.3s ease;
    }
    
    .card {
      background-color: var(--card-bg);
      color: var(--text-color);
      border-color: var(--border-color);
      transition: all 0.3s ease;
    }
    
    [data-theme="dark"] .card:hover {
      background-color: #3a3a3a;
    }
    
    [data-theme="dark"] .text-muted {
      color: #aaa !important;
    }
    
    .dark-mode-toggle {
      position: fixed;
      top: 20px;
      right: 20px;
      z-index: 1050;
    }
    
    .toggle-btn {
      background-color: var(--card-bg);
      border: 2px solid var(--border-color);
      border-radius: 50px;
      padding: 8px 15px;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 8px;
      box-shadow: 0 2px 5px rgba(0,0,0,0.2);
      color: var(--text-color);
      transition: all 0.3s ease;
    }
    
    .toggle-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 4px 8px rgba(0,0,0,0.3);
    }
    
    .toggle-icon {
      font-size: 20px;
    }

    .btn-group .btn {
      margin-bottom: 5px;
    }
  </style>
</head>
<body>
  <!-- 다크모드 토글 버튼 -->
  <div class="dark-mode-toggle">
    <button class="toggle-btn" onclick="toggleDarkMode()">
      <span class="toggle-icon" id="themeIcon">🌙</span>
      <span id="themeText">다크</span>
    </button>
  </div>

  <div class="container mt-4">
    <div class="row mb-4">
      <div class="col-md-8">
        <h1>여론조사 목록</h1>
      </div>
      <div class="col-md-4 text-end">
        <a href="/polls/new" class="btn btn-primary">새 여론조사 만들기</a>
      </div>
    </div>

    <!-- 카테고리 필터 -->
    <div class="mb-4">
      <div class="btn-group flex-wrap" role="group">
        <a href="/polls" class="btn btn-outline-primary <%= typeof category === 'undefined' || !category ? 'active' : '' %>">전체</a>
        <a href="/polls?category=일반" class="btn btn-outline-primary <%= category === '일반' ? 'active' : '' %>">일반</a>
        <a href="/polls?category=정치" class="btn btn-outline-primary <%= category === '정치' ? 'active' : '' %>">정치</a>
        <a href="/polls?category=경제" class="btn btn-outline-primary <%= category === '경제' ? 'active' : '' %>">경제</a>
        <a href="/polls?category=사회" class="btn btn-outline-primary <%= category === '사회' ? 'active' : '' %>">사회</a>
        <a href="/polls?category=문화" class="btn btn-outline-primary <%= category === '문화' ? 'active' : '' %>">문화</a>
        <a href="/polls?category=스포츠" class="btn btn-outline-primary <%= category === '스포츠' ? 'active' : '' %>">스포츠</a>
        <a href="/polls?category=게임" class="btn btn-outline-primary <%= category === '게임' ? 'active' : '' %>">게임</a>
        <a href="/polls?category=음식" class="btn btn-outline-primary <%= category === '음식' ? 'active' : '' %>">음식</a>
        <a href="/polls?category=기타" class="btn btn-outline-primary <%= category === '기타' ? 'active' : '' %>">기타</a>
      </div>
    </div>
    
    <% if (polls && polls.length > 0) { %>
      <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        <% polls.forEach(poll => { %>
          <div class="col">
            <div class="card h-100 shadow-sm">
              <div class="card-body">
                <!-- 카테고리 및 태그 배지 -->
                <div class="mb-2">
                  <span class="badge bg-primary"><%= poll.category || '일반' %></span>
                  <% if (poll.tags && poll.tags.length > 0) { %>
                    <% poll.tags.forEach(tag => { %>
                      <span class="badge bg-secondary"><%= tag %></span>
                    <% }); %>
                  <% } %>
                </div>
                
                <h5 class="card-title"><%= poll.title %></h5>
                <% if (poll.description) { %>
                  <p class="card-text text-muted"><%= poll.description %></p>
                <% } %>
                <p class="card-text">
                  <small class="text-muted">
                    옵션 <%= poll.options.length %>개 | 총 <%= poll.options.reduce((sum, opt) => sum + opt.votes, 0) %> 투표
                  </small>
                </p>
              </div>
              <div class="card-footer bg-transparent">
                <a href="/polls/<%= poll._id %>" class="btn btn-outline-primary w-100">투표하기</a>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="alert alert-info">
        아직 생성된 여론조사가 없습니다. 첫 번째 여론조사를 만들어보세요!
      </div>
    <% } %>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  
  <script>
    // 다크모드 함수들
    function initDarkMode() {
      const savedTheme = localStorage.getItem('theme') || 'light';
      document.documentElement.setAttribute('data-theme', savedTheme);
      updateThemeIcon(savedTheme);
    }

    function toggleDarkMode() {
      const currentTheme = document.documentElement.getAttribute('data-theme');
      const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
      
      document.documentElement.setAttribute('data-theme', newTheme);
      localStorage.setItem('theme', newTheme);
      updateThemeIcon(newTheme);
    }

    function updateThemeIcon(theme) {
      const icon = document.getElementById('themeIcon');
      const text = document.getElementById('themeText');
      
      if (icon && text) {
        if (theme === 'dark') {
          icon.textContent = '☀️';
          text.textContent = '라이트';
        } else {
          icon.textContent = '🌙';
          text.textContent = '다크';
        }
      }
    }

    // 즉시 다크모드 초기화
    initDarkMode();
  </script>
</body>
</html>