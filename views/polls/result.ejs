<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= poll.title %> - 투표 결과</title>
  <script src="/socket.io/socket.io.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    
    :root {
      --bg-gradient-start: #667eea;
      --bg-gradient-end: #764ba2;
      --card-bg: white;
      --text-color: #333;
      --secondary-bg: #f8f9fa;
      --border-color: #dee2e6;
    }
    
    [data-theme="dark"] {
      --bg-gradient-start: #1a1a2e;
      --bg-gradient-end: #16213e;
      --card-bg: #2d2d2d;
      --text-color: #e0e0e0;
      --secondary-bg: #3a3a3a;
      --border-color: #404040;
    }
    
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: linear-gradient(135deg, var(--bg-gradient-start) 0%, var(--bg-gradient-end) 100%);
      min-height: 100vh;
      padding: 20px;
      transition: background 0.3s ease;
    }

    .alert-banner {
      background: linear-gradient(135deg, #ffeaa7 0%, #fdcb6e 100%);
      color: #2d3436;
      padding: 15px 20px;
      border-radius: 10px;
      margin-bottom: 20px;
      box-shadow: 0 4px 6px rgba(0,0,0,0.1);
      display: flex;
      align-items: center;
      gap: 15px;
      animation: slideDown 0.5s ease-out;
    }
    .alert-banner-icon {
      font-size: 24px;
    }
    .alert-banner-content {
      flex: 1;
    }
    .alert-banner-title {
      font-weight: bold;
      margin-bottom: 5px;
    }
    .alert-banner-date {
      font-size: 14px;
      opacity: 0.8;
    }
    @keyframes slideDown {
      from {
        transform: translateY(-20px);
        opacity: 0;
      }
      to {
        transform: translateY(0);
        opacity: 1;
      }
    }
    
    .container {
      max-width: 1200px;
      margin: 0 auto;
      background: var(--card-bg);
      border-radius: 20px;
      box-shadow: 0 20px 60px rgba(0,0,0,0.3);
      overflow: hidden;
      transition: background-color 0.3s ease;
    }
    .header {
      background: linear-gradient(135deg, var(--bg-gradient-start) 0%, var(--bg-gradient-end) 100%);
      color: white;
      padding: 30px;
      text-align: center;
    }
    .header h1 {
      font-size: 28px;
      margin-bottom: 10px;
    }
    .header p {
      opacity: 0.9;
      font-size: 16px;
    }
    .content {
      padding: 40px;
    }
    .stats {
      display: flex;
      justify-content: space-around;
      margin-bottom: 40px;
      padding: 20px;
      background: var(--secondary-bg);
      border-radius: 10px;
      transition: background-color 0.3s ease;
    }
    .stat-item {
      text-align: center;
    }
    .stat-number {
      font-size: 32px;
      font-weight: bold;
      color: #667eea;
    }
    .stat-label {
      color: #666;
      font-size: 14px;
      margin-top: 5px;
    }
    
    [data-theme="dark"] .stat-label {
      color: #aaa;
    }
    
    .charts-wrapper {
      display: grid;
      grid-template-columns: 2fr 1fr;
      gap: 30px;
      margin-bottom: 40px;
      align-items: start;
    }
    .chart-container {
      position: relative;
      background: var(--secondary-bg);
      padding: 20px;
      border-radius: 10px;
      transition: background-color 0.3s ease;
    }
    .chart-container.main-chart {
      height: 400px;
    }
    .chart-container.location-chart {
      height: 300px;
    }
    .chart-title {
      text-align: center;
      font-weight: bold;
      color: var(--text-color);
      margin-bottom: 15px;
      font-size: 18px;
    }
    .chart-title.location-title {
      font-size: 16px;
      color: #666;
    }
    
    [data-theme="dark"] .chart-title.location-title {
      color: #aaa;
    }
    
    @media (max-width: 768px) {
      .charts-wrapper {
        grid-template-columns: 1fr;
      }
    }
    
    .options-list {
      margin-top: 30px;
    }
    .options-list h2 {
      color: var(--text-color);
    }
    .option-item {
      background: var(--secondary-bg);
      padding: 15px 20px;
      margin-bottom: 15px;
      border-radius: 10px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      transition: all 0.3s ease;
    }
    .option-item:hover {
      transform: translateX(5px);
      background: var(--border-color);
    }
    .option-name {
      font-weight: 500;
      color: var(--text-color);
      display: flex;
      align-items: center;
    }
    .color-dot {
      display: inline-block;
      width: 20px;
      height: 20px;
      border-radius: 50%;
      margin-right: 10px;
    }
    .option-stats {
      display: flex;
      align-items: center;
      gap: 15px;
    }
    .option-votes {
      font-size: 18px;
      font-weight: bold;
      color: #667eea;
    }
    .option-percentage {
      color: #666;
      font-size: 14px;
    }
    
    [data-theme="dark"] .option-percentage {
      color: #aaa;
    }
    
    .action-buttons {
      display: flex;
      gap: 10px;
      justify-content: center;
      margin-top: 30px;
    }
    .btn {
      padding: 12px 30px;
      color: white;
      text-decoration: none;
      border-radius: 25px;
      transition: all 0.3s;
      border: none;
      cursor: pointer;
      font-size: 16px;
      display: inline-block;
    }
    .btn-primary {
      background: #667eea;
    }
    .btn-primary:hover {
      background: #5568d3;
      transform: translateY(-2px);
      box-shadow: 0 5px 15px rgba(102, 126, 234, 0.4);
    }
    .btn-secondary {
      background: #6c757d;
    }
    .btn-secondary:hover {
      background: #5a6268;
    }
    .live-indicator {
      display: inline-block;
      width: 10px;
      height: 10px;
      background: #22c55e;
      border-radius: 50%;
      animation: pulse 2s infinite;
      margin-right: 8px;
    }
    @keyframes pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.5; }
    }
    
    /* 다크모드 토글 버튼 */
    .dark-mode-toggle {
      position: fixed;
      top: 20px;
      right: 20px;
      z-index: 1050;
    }
    
    .toggle-btn {
      background-color: var(--card-bg);
      border: 2px solid var(--border-color);
      border-radius: 50px;
      padding: 8px 15px;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 8px;
      box-shadow: 0 2px 5px rgba(0,0,0,0.2);
      color: var(--text-color);
      transition: all 0.3s ease;
    }
    
    .toggle-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 4px 8px rgba(0,0,0,0.3);
    }
    
    .toggle-icon {
      font-size: 20px;
    }
  </style>
</head>
<body>
  <!-- 다크모드 토글 버튼 -->
  <div class="dark-mode-toggle">
    <button class="toggle-btn" onclick="toggleDarkMode()">
      <span class="toggle-icon" id="themeIcon">🌙</span>
      <span id="themeText">다크</span>
    </button>
  </div>

  <% if (typeof alreadyVoted !== 'undefined' && alreadyVoted) { %>
    <div class="container" style="margin-bottom: 20px;">
      <div class="alert-banner">
        <div class="alert-banner-icon">✅</div>
        <div class="alert-banner-content">
          <div class="alert-banner-title">이미 투표하신 여론조사입니다</div>
          <div class="alert-banner-date">
            투표 생성일: <%= new Date(poll.createdAt).toLocaleDateString('ko-KR', { 
              year: 'numeric', 
              month: 'long', 
              day: 'numeric',
              weekday: 'long'
            }) %>
          </div>
        </div>
      </div>
    </div>
  <% } %>

  <div class="container">
    <div class="header">
      <h1><%= poll.title %></h1>
      <% if (poll.description) { %>
        <p style="font-size: 1.1rem; line-height: 1.6; margin-top: 15px;"><%= poll.description %></p>
      <% } %>
      
      <!-- 카테고리/태그 추가 -->
      <% if (poll.category || (poll.tags && poll.tags.length > 0)) { %>
        <div style="margin-top: 15px;">
          <% if (poll.category) { %>
            <span style="background: rgba(255,255,255,0.2); padding: 5px 15px; border-radius: 20px; margin-right: 8px; font-size: 0.9rem;">
              <%= poll.category %>
            </span>
          <% } %>
          <% if (poll.tags && poll.tags.length > 0) { %>
            <% poll.tags.forEach(tag => { %>
              <span style="background: rgba(255,255,255,0.15); padding: 5px 12px; border-radius: 20px; margin-right: 5px; font-size: 0.85rem;">
                #<%= tag %>
              </span>
            <% }); %>
          <% } %>
        </div>
      <% } %>
    </div>

    <div class="content">
      <div class="stats">
        <div class="stat-item">
          <div class="stat-number" id="total-votes"><%= poll.options.reduce((sum, opt) => sum + opt.votes, 0) %></div>
          <div class="stat-label">총 투표수</div>
        </div>
        <div class="stat-item">
          <div class="stat-number"><%= poll.options.length %></div>
          <div class="stat-label">선택지 수</div>
        </div>
        <div class="stat-item">
          <div class="stat-label">
            <span class="live-indicator"></span>
            실시간 업데이트
          </div>
        </div>
      </div>

      <div class="charts-wrapper">
        <div class="chart-container main-chart">
          <div class="chart-title">📊 투표 결과</div>
          <canvas id="pollChart"></canvas>
        </div>

        <div class="chart-container location-chart">
          <div class="chart-title location-title">🗺️ 지역별 투표</div>
          <canvas id="locationChart"></canvas>
        </div>
      </div>

      <div class="options-list">
        <h2 style="margin-bottom: 20px;">상세 결과</h2>
        <% 
          const totalVotes = poll.options.reduce((sum, opt) => sum + opt.votes, 0);
          const colors = [
            'rgba(102, 126, 234, 0.8)',
            'rgba(118, 75, 162, 0.8)',
            'rgba(237, 100, 166, 0.8)',
            'rgba(255, 154, 158, 0.8)',
            'rgba(250, 208, 196, 0.8)',
            'rgba(155, 93, 229, 0.8)',
            'rgba(237, 187, 153, 0.8)',
            'rgba(34, 197, 94, 0.8)'
          ];
        %>
        <% poll.options.forEach((option, index) => { %>
          <div class="option-item" data-option-id="<%= option._id %>">
            <div class="option-name">
              <span class="color-dot" style="background: <%= colors[index % colors.length] %>;"></span>
              <%= option.text %>
            </div>
            <div class="option-stats">
              <span class="option-votes"><%= option.votes %>표</span>
              <span class="option-percentage">
                <%= totalVotes > 0 ? ((option.votes / totalVotes) * 100).toFixed(1) : 0 %>%
              </span>
            </div>
          </div>
        <% }); %>
      </div>

      <div class="action-buttons">
        <a href="/polls/<%= poll._id %>" class="btn btn-primary">투표하러 가기</a>
        <a href="/polls" class="btn btn-secondary">목록으로</a>
      </div>
    </div>
  </div>

  <script>
    // 다크모드 함수들 (맨 위에 배치)
    function initDarkMode() {
      const savedTheme = localStorage.getItem('theme') || 'light';
      document.documentElement.setAttribute('data-theme', savedTheme);
      updateThemeIcon(savedTheme);
    }

    function toggleDarkMode() {
      const currentTheme = document.documentElement.getAttribute('data-theme');
      const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
      
      document.documentElement.setAttribute('data-theme', newTheme);
      localStorage.setItem('theme', newTheme);
      updateThemeIcon(newTheme);
    }

    function updateThemeIcon(theme) {
      const icon = document.getElementById('themeIcon');
      const text = document.getElementById('themeText');
      
      if (icon && text) {
        if (theme === 'dark') {
          icon.textContent = '☀️';
          text.textContent = '라이트';
        } else {
          icon.textContent = '🌙';
          text.textContent = '다크';
        }
      }
    }

    // 즉시 다크모드 초기화
    initDarkMode();

    const pollId = '<%= poll._id %>';
    const socket = io();

    const colors = [
      'rgba(102, 126, 234, 0.8)',
      'rgba(118, 75, 162, 0.8)',
      'rgba(237, 100, 166, 0.8)',
      'rgba(255, 154, 158, 0.8)',
      'rgba(250, 208, 196, 0.8)',
      'rgba(155, 93, 229, 0.8)',
      'rgba(237, 187, 153, 0.8)',
      'rgba(34, 197, 94, 0.8)'
    ];

    const locationColors = [
      'rgba(50, 50, 50, 0.8)',
      'rgba(100, 100, 100, 0.8)',
      'rgba(150, 150, 150, 0.8)',
      'rgba(180, 180, 180, 0.8)',
      'rgba(210, 210, 210, 0.8)',
      'rgba(70, 70, 70, 0.8)',
      'rgba(120, 120, 120, 0.8)',
      'rgba(160, 160, 160, 0.8)'
    ];

    const ctx = document.getElementById('pollChart').getContext('2d');
    let pollChart = new Chart(ctx, {
      type: 'pie',
      data: {
        labels: [
          <% poll.options.forEach((option, index) => { %>
            '<%= option.text %>'<%= index < poll.options.length - 1 ? ',' : '' %>
          <% }); %>
        ],
        datasets: [{
          data: [
            <% poll.options.forEach((option, index) => { %>
              <%= option.votes %><%= index < poll.options.length - 1 ? ',' : '' %>
            <% }); %>
          ],
          backgroundColor: colors,
          borderColor: 'white',
          borderWidth: 2
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: {
            position: 'bottom',
            labels: {
              padding: 15,
              font: {
                size: 12
              }
            }
          },
          tooltip: {
            callbacks: {
              label: function(context) {
                const label = context.label || '';
                const value = context.parsed || 0;
                const total = context.dataset.data.reduce((a, b) => a + b, 0);
                const percentage = total > 0 ? ((value / total) * 100).toFixed(1) : 0;
                return label + ': ' + value + '표 (' + percentage + '%)';
              }
            }
          }
        }
      }
    });

    const locationCtx = document.getElementById('locationChart').getContext('2d');
    
    let locationChart = new Chart(locationCtx, {
      type: 'pie',
      data: {
        labels: [
          <% if (locationStats && locationStats.length > 0) { %>
            <% locationStats.forEach((stat, index) => { %>
              '<%= stat._id || "알 수 없음" %>'<%= index < locationStats.length - 1 ? ',' : '' %>
            <% }); %>
          <% } else { %>
            '투표 데이터 없음'
          <% } %>
        ],
        datasets: [{
          data: [
            <% if (locationStats && locationStats.length > 0) { %>
              <% locationStats.forEach((stat, index) => { %>
                <%= stat.count %><%= index < locationStats.length - 1 ? ',' : '' %>
              <% }); %>
            <% } else { %>
              0
            <% } %>
          ],
          backgroundColor: locationColors,
          borderColor: 'white',
          borderWidth: 2
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: {
            position: 'bottom',
            labels: {
              padding: 10,
              font: {
                size: 11
              }
            }
          },
          tooltip: {
            callbacks: {
              label: function(context) {
                const label = context.label || '';
                const value = context.parsed || 0;
                const total = context.dataset.data.reduce((a, b) => a + b, 0);
                const percentage = total > 0 ? ((value / total) * 100).toFixed(1) : 0;
                return label + ': ' + value + '명 (' + percentage + '%)';
              }
            }
          }
        }
      }
    });

    socket.on('vote-update', (data) => {
      if (data.pollId === pollId) {
        console.log('투표 업데이트 수신:', data);
        
        pollChart.data.datasets[0].data = data.poll.options.map(opt => opt.votes);
        pollChart.update('active');

        const totalVotes = data.poll.options.reduce((sum, opt) => sum + opt.votes, 0);
        document.getElementById('total-votes').textContent = totalVotes;

        data.poll.options.forEach(option => {
          const optionElement = document.querySelector('[data-option-id="' + option._id + '"]');
          if (optionElement) {
            const percentage = totalVotes > 0 ? ((option.votes / totalVotes) * 100).toFixed(1) : 0;
            optionElement.querySelector('.option-votes').textContent = option.votes + '표';
            optionElement.querySelector('.option-percentage').textContent = percentage + '%';
          }
        });
      }
    });

    socket.on('connect', () => {
      console.log('Socket.IO 연결됨');
    });

    socket.on('disconnect', () => {
      console.log('Socket.IO 연결 종료');
    });
  </script>
</body>
</html>