  /* 차트 섹션 */
  .charts-section {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 30px;
    margin-bottom: 30px;
  }
  
  .chart-card {
    background: var(--card-bg);
    border-radius: 20px;
    padding: 30px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.2);
  }
  
  .chart-title {
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--text-color);
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  
  .chart-container {
    position: relative;
    height: 400px;
  }
  
  .location-chart-container {
    position: relative;
    height: 300px;
  }
  
  /* 상세 결과 */
  .details-card {
    background: var(--card-bg);
    border-radius: 20px;
    padding: 30px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.2);
    margin-bottom: 30px;
  }
  
  .section-title {
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--text-color);
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  
  .option-result-item {
    background: var(--border-color);
    padding: 20px 25px;
    margin-bottom: 15px;
    border-radius: 15px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    transition: all 0.3s ease;
  }
  
  [data-theme="dark"] .option-result-item {
    background: #3a3a3a;
  }
  
  .option-result-item:hover {
    transform: translateX(5px);
    box-shadow: 0 5px 15px rgba(102, 126, 234, 0.2);
  }
  
  .option-info {
    display: flex;
    align-items: center;
    gap: 15px;
  }
  
  .option-rank {
    font-size: 1.5rem;
    font-weight: 800;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    min-width: 40px;
  }
  
  .option-name {
    font-weight: 700;
    color: var(--text-color);
    font-size: 1.1rem;
  }
  
  .option-stats {
    display: flex;
    align-items: center;
    gap: 20px;
  }
  
  .option-votes {
    font-size: 1.3rem;
    font-weight: 700;
    color: #667eea;
  }
  
  .option-percentage {
    color: var(--secondary-text);
    font-weight: 600;
  }
  
  /* 액션 버튼 */
  .action-buttons {
    display: flex;
    gap: 15px;
    justify-content: center;
    flex-wrap: wrap;
  }
  
  .action-btn {
    padding: 15px 35px;
    border: none;
    border-radius: 50px;
    font-size: 1.05rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  
  .btn-primary-action {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    box-shadow: 0 8px 25px rgba(102, 126, 234, 0.4);
  }
  
  .btn-primary-action:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 35px rgba(102, 126, 234, 0.5);
    color: white;
  }
  
  .btn-secondary-action {
    background: transparent;
    color: var(--text-color);
    border: 2px solid var(--border-color);
  }
  
  .btn-secondary-action:hover {
    background: var(--border-color);
    transform: translateY(-3px);
    color: var(--text-color);
  }
  
  /* 반응형 */
  @media (max-width: 768px) {
    .poll-title {
      font-size: 2rem;
    }
    
    .charts-section {
      grid-template-columns: 1fr;
    }
    
    .action-buttons {
      flex-direction: column;
    }
    
    .action-btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>

<!-- Socket.io와 Chart.js 필요 -->
<script src="/socket.io/socket.io.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

<script>
  // 차트 데이터
  const pollId = '<%= poll._id %>';
  const socket = io();

  const colors = [
    'rgba(102, 126, 234, 0.8)',
    'rgba(118, 75, 162, 0.8)',
    'rgba(237, 100, 166, 0.8)',
    'rgba(255, 154, 158, 0.8)',
    'rgba(250, 208, 196, 0.8)',
    'rgba(155, 93, 229, 0.8)',
    'rgba(237, 187, 153, 0.8)',
    'rgba(34, 197, 94, 0.8)'
  ];

  const locationColors = [
    'rgba(50, 50, 50, 0.8)',
    'rgba(100, 100, 100, 0.8)',
    'rgba(150, 150, 150, 0.8)',
    'rgba(180, 180, 180, 0.8)',
    'rgba(210, 210, 210, 0.8)',
    'rgba(70, 70, 70, 0.8)',
    'rgba(120, 120, 120, 0.8)',
    'rgba(160, 160, 160, 0.8)'
  ];

  // 메인 차트
  const ctx = document.getElementById('pollChart').getContext('2d');
  let pollChart = new Chart(ctx, {
    type: 'pie',
    data: {
      labels: [
        <% poll.options.forEach((option, index) => { %>
          '<%= option.text %>'<%= index < poll.options.length - 1 ? ',' : '' %>
        <% }); %>
      ],
      datasets: [{
        data: [
          <% poll.options.forEach((option, index) => { %>
            <%= option.votes %><%= index < poll.options.length - 1 ? ',' : '' %>
          <% }); %>
        ],
        backgroundColor: colors,
        borderColor: 'white',
        borderWidth: 2
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: {
          position: 'bottom',
          labels: {
            padding: 15,
            font: { size: 12 },
            color: getComputedStyle(document.documentElement).getPropertyValue('--text-color')
          }
        },
        tooltip: {
          callbacks: {
            label: function(context) {
              const label = context.label || '';
              const value = context.parsed || 0;
              const total = context.dataset.data.reduce((a, b) => a + b, 0);
              const percentage = total > 0 ? ((value / total) * 100).toFixed(1) : 0;
              return label + ': ' + value + '표 (' + percentage + '%)';
            }
          }
        }
      }
    }
  });

  // 지역 차트
  const locationCtx = document.getElementById('locationChart').getContext('2d');
  let locationChart = new Chart(locationCtx, {
    type: 'pie',
    data: {
      labels: [
        <% if (locationStats && locationStats.length > 0) { %>
          <% locationStats.forEach((stat, index) => { %>
            '<%= stat._id || "알 수 없음" %>'<%= index < locationStats.length - 1 ? ',' : '' %>
          <% }); %>
        <% } else { %>
          '투표 데이터 없음'
        <% } %>
      ],
      datasets: [{
        data: [
          <% if (locationStats && locationStats.length > 0) { %>
            <% locationStats.forEach((stat, index) => { %>
              <%= stat.count %><%= index < locationStats.length - 1 ? ',' : '' %>
            <% }); %>
          <% } else { %>
            0
          <% } %>
        ],
        backgroundColor: locationColors,
        borderColor: 'white',
        borderWidth: 2
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: {
          position: 'bottom',
          labels: {
            padding: 10,
            font: { size: 11 },
            color: getComputedStyle(document.documentElement).getPropertyValue('--text-color')
          }
        }
      }
    }
  });

  // Socket.io 실시간 업데이트
  socket.on('vote-update', (data) => {
    if (data.pollId === pollId) {
      console.log('투표 업데이트 수신:', data);
      
      pollChart.data.datasets[0].data = data.poll.options.map(opt => opt.votes);
      pollChart.update('active');

      const totalVotes = data.poll.options.reduce((sum, opt) => sum + opt.votes, 0);
      document.getElementById('total-votes').textContent = totalVotes;

      data.poll.options.forEach(option => {
        const optionElement = document.querySelector('[data-option-id="' + option._id + '"]');
        if (optionElement) {
          const percentage = totalVotes > 0 ? ((option.votes / totalVotes) * 100).toFixed(1) : 0;
          optionElement.querySelector('.option-votes').textContent = option.votes + '표';
          optionElement.querySelector('.option-percentage').textContent = percentage + '%';
        }
      });
    }
  });
</script>