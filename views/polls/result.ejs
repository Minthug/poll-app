<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= poll.title %> - 투표 결과</title>
  <script src="/socket.io/socket.io.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
  
  <style>
    :root {
      --bg-gradient-start: #667eea;
      --bg-gradient-end: #764ba2;
      --card-bg: white;
      --text-color: #333;
      --secondary-text: #666;
      --border-color: #e0e0e0;
    }
    
    [data-theme="dark"] {
      --bg-gradient-start: #1a1a2e;
      --bg-gradient-end: #16213e;
      --card-bg: #2d2d2d;
      --text-color: #e0e0e0;
      --secondary-text: #aaa;
      --border-color: #404040;
    }
    
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: linear-gradient(135deg, var(--bg-gradient-start) 0%, var(--bg-gradient-end) 100%);
      min-height: 100vh;
      padding: 40px 20px;
      transition: background 0.3s ease;
    }
    
    .result-container {
      max-width: 1000px;
      margin: 0 auto;
    }
    
    /* 알림 배너 */
    .alert-banner {
      background: linear-gradient(135deg, #ffeaa7 0%, #fdcb6e 100%);
      color: #2d3436;
      padding: 20px 25px;
      border-radius: 20px;
      margin-bottom: 30px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.2);
      display: flex;
      align-items: center;
      gap: 15px;
      animation: slideDown 0.5s ease-out;
    }
    
    .alert-banner-icon {
      font-size: 28px;
    }
    
    .alert-banner-content {
      flex: 1;
    }
    
    .alert-banner-title {
      font-weight: 700;
      font-size: 1.1rem;
      margin-bottom: 5px;
    }
    
    @keyframes slideDown {
      from {
        transform: translateY(-20px);
        opacity: 0;
      }
      to {
        transform: translateY(0);
        opacity: 1;
      }
    }
    
    /* 헤더 카드 */
    .result-header-card {
      background: var(--card-bg);
      border-radius: 30px;
      padding: 40px;
      box-shadow: 0 20px 60px rgba(0,0,0,0.3);
      margin-bottom: 30px;
      text-align: center;
    }
    
    .poll-badges {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      justify-content: center;
      margin-bottom: 20px;
    }
    
    .poll-badge {
      padding: 6px 15px;
      border-radius: 20px;
      font-size: 0.85rem;
      font-weight: 600;
    }
    
    .badge-category {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
    }
    
    .badge-tag {
      background: var(--border-color);
      color: var(--text-color);
    }
    
    [data-theme="dark"] .badge-tag {
      background: #404040;
    }
    
    .poll-title {
      font-size: 2.5rem;
      font-weight: 800;
      color: var(--text-color);
      margin-bottom: 15px;
      line-height: 1.3;
    }
    
    .poll-description {
      font-size: 1.2rem;
      color: var(--secondary-text);
      line-height: 1.6;
    }
    
    /* 통계 카드 */
    .stats-card {
      background: var(--card-bg);
      border-radius: 20px;
      padding: 30px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.2);
      margin-bottom: 30px;
    }
    
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 20px;
      text-align: center;
    }
    
    .stat-item {
      padding: 20px;
      background: var(--border-color);
      border-radius: 15px;
      transition: all 0.3s ease;
    }
    
    [data-theme="dark"] .stat-item {
      background: #3a3a3a;
    }
    
    .stat-item:hover {
      transform: translateY(-5px);
      box-shadow: 0 8px 20px rgba(102, 126, 234, 0.3);
    }
    
    .stat-number {
      font-size: 2.5rem;
      font-weight: 800;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      margin-bottom: 8px;
    }
    
    .stat-label {
      color: var(--secondary-text);
      font-size: 0.95rem;
      font-weight: 600;
    }
    
    .live-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 15px;
      background: #22c55e;
      color: white;
      border-radius: 20px;
      font-weight: 600;
      font-size: 0.9rem;
    }
    
    .live-dot {
      width: 8px;
      height: 8px;
      background: white;
      border-radius: 50%;
      animation: pulse 2s infinite;
    }
    
    @keyframes pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.5; }
    }
    
    /* 차트 섹션 */
    .charts-section {
      display: grid;
      grid-template-columns: 2fr 1fr;
      gap: 30px;
      margin-bottom: 30px;
    }
    
    .chart-card {
      background: var(--card-bg);
      border-radius: 20px;
      padding: 30px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.2);
    }
    
    .chart-title {
      font-size: 1.3rem;
      font-weight: 700;
      color: var(--text-color);
      margin-bottom: 20px;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    
    .chart-container {
      position: relative;
      height: 400px;
    }
    
    .location-chart-container {
      position: relative;
      height: 300px;
    }
    
    /* 상세 결과 */
    .details-card {
      background: var(--card-bg);
      border-radius: 20px;
      padding: 30px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.2);
      margin-bottom: 30px;
    }
    
    .section-title {
      font-size: 1.3rem;
      font-weight: 700;
      color: var(--text-color);
      margin-bottom: 20px;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    
    .option-result-item {
      background: var(--border-color);
      padding: 20px 25px;
      margin-bottom: 15px;
      border-radius: 15px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      transition: all 0.3s ease;
    }
    
    [data-theme="dark"] .option-result-item {
      background: #3a3a3a;
    }
    
    .option-result-item:hover {
      transform: translateX(5px);
      box-shadow: 0 5px 15px rgba(102, 126, 234, 0.2);
    }
    
    .option-info {
      display: flex;
      align-items: center;
      gap: 15px;
    }
    
    .option-rank {
      font-size: 1.5rem;
      font-weight: 800;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      min-width: 40px;
    }
    
    .option-name {
      font-weight: 700;
      color: var(--text-color);
      font-size: 1.1rem;
    }
    
    .option-stats {
      display: flex;
      align-items: center;
      gap: 20px;
    }
    
    .option-votes {
      font-size: 1.3rem;
      font-weight: 700;
      color: #667eea;
    }
    
    .option-percentage {
      color: var(--secondary-text);
      font-weight: 600;
    }
    
    /* 액션 버튼 */
    .action-buttons {
      display: flex;
      gap: 15px;
      justify-content: center;
      flex-wrap: wrap;
    }
    
    .action-btn {
      padding: 15px 35px;
      border: none;
      border-radius: 50px;
      font-size: 1.05rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.3s ease;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 10px;
    }
    
    .btn-primary-action {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
      box-shadow: 0 8px 25px rgba(102, 126, 234, 0.4);
    }
    
    .btn-primary-action:hover {
      transform: translateY(-3px);
      box-shadow: 0 12px 35px rgba(102, 126, 234, 0.5);
      color: white;
    }
    
    .btn-secondary-action {
      background: transparent;
      color: var(--text-color);
      border: 2px solid var(--border-color);
    }
    
    .btn-secondary-action:hover {
      background: var(--border-color);
      transform: translateY(-3px);
      color: var(--text-color);
    }
    
    /* 반응형 */
    @media (max-width: 768px) {
      .poll-title {
        font-size: 2rem;
      }
      
      .charts-section {
        grid-template-columns: 1fr;
      }
      
      .action-buttons {
        flex-direction: column;
      }
      
      .action-btn {
        width: 100%;
        justify-content: center;
      }
    }

    /* 홈 버튼과 다크모드 토글 */
.home-button {
    position: fixed;
    top: 20px;
    left: 20px;
    z-index: 1040;
    background-color: var(--card-bg);
    border: 2px solid var(--border-color);
    border-radius: 50px;
    padding: 10px 20px;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 8px;
    box-shadow: 0 2px 5px rgba(0,0,0,0.2);
    color: var(--text-color);
    text-decoration: none;
    transition: all 0.3s ease;
    font-weight: 500;
}

.home-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 8px rgba(0,0,0,0.3);
    color: var(--text-color);
}

.home-icon {
    font-size: 20px;
}

.dark-mode-toggle {
    position: fixed;
    top: 20px;
    right: 20px;
    z-index: 1050;
}

.toggle-btn {
    background-color: var(--card-bg);
    border: 2px solid var(--border-color);
    border-radius: 50px;
    padding: 10px 20px;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 8px;
    box-shadow: 0 2px 5px rgba(0,0,0,0.2);
    color: var(--text-color);
    transition: all 0.3s ease;
}

.toggle-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 8px rgba(0,0,0,0.3);
}

.toggle-icon {
    font-size: 20px;
}
  </style>
</head>
<body>
  <!-- 홈 버튼 -->
  <a href="/" class="home-button">
    <span class="home-icon">🏠</span>
    <span>홈</span>
  </a>

  <!-- 다크모드 토글 버튼 -->
  <div class="dark-mode-toggle">
    <button class="toggle-btn" onclick="toggleDarkMode()">
      <span class="toggle-icon" id="themeIcon">🌙</span>
      <span id="themeText">다크</span>
    </button>
  </div>

  <!-- 알림 배너 -->
  <div class="result-container">
    <% if (typeof alreadyVoted !== 'undefined' && alreadyVoted) { %>
      <div class="alert-banner">
        <div class="alert-banner-icon">✅</div>
        <div class="alert-banner-content">
          <div class="alert-banner-title">이미 투표하셨습니다</div>
          <div>투표해 주셔서 감사합니다!</div>
        </div>
      </div>
    <% } %>
    
    <% if (typeof ended !== 'undefined' && ended) { %>
      <div class="alert-banner">
        <div class="alert-banner-icon">⏰</div>
        <div class="alert-banner-content">
          <div class="alert-banner-title">투표가 종료되었습니다</div>
          <div>최종 결과를 확인하세요</div>
        </div>
      </div>
    <% } %>

    <!-- 헤더 -->
    <div class="result-header-card">
      <div class="poll-badges">
        <% if (poll.category) { %>
          <span class="poll-badge badge-category"><%= poll.category %></span>
        <% } %>
        <% if (poll.tags && poll.tags.length > 0) { %>
          <% poll.tags.forEach(tag => { %>
            <span class="poll-badge badge-tag">#<%= tag %></span>
          <% }); %>
        <% } %>
      </div>
      
      <h1 class="poll-title"><%= poll.title %></h1>
      
      <% if (poll.description) { %>
        <p class="poll-description"><%= poll.description %></p>
      <% } %>
    </div>

    <!-- 통계 -->
    <div class="stats-card">
      <div class="stats-grid">
        <div class="stat-item">
          <div class="stat-number" id="total-votes">
            <%= poll.options.reduce((sum, opt) => sum + opt.votes, 0) %>
          </div>
          <div class="stat-label">총 투표수</div>
        </div>
        
        <div class="stat-item">
          <div class="stat-number"><%= poll.options.length %></div>
          <div class="stat-label">선택지 수</div>
        </div>
        
        <div class="stat-item">
          <div class="stat-number">
            <%= new Date(poll.createdAt).toLocaleDateString('ko-KR', { month: 'numeric', day: 'numeric' }) %>
          </div>
          <div class="stat-label">생성일</div>
        </div>
        
        <div class="stat-item">
          <span class="live-badge">
            <span class="live-dot"></span>
            <span>실시간</span>
          </span>
          <div class="stat-label" style="margin-top: 10px;">자동 업데이트</div>
        </div>
      </div>
    </div>

    <!-- 차트 -->
    <div class="charts-section">
      <div class="chart-card">
        <h3 class="chart-title">
          <span>📊</span>
          <span>투표 결과</span>
        </h3>
        <div class="chart-container">
          <canvas id="pollChart"></canvas>
        </div>
      </div>

      <div class="chart-card">
        <h3 class="chart-title">
          <span>🗺️</span>
          <span>지역별 분포</span>
        </h3>
        <div class="location-chart-container">
          <canvas id="locationChart"></canvas>
        </div>
      </div>
    </div>

    <!-- 상세 결과 -->
    <div class="details-card">
      <h3 class="section-title">
        <span>📋</span>
        <span>상세 결과</span>
      </h3>
      
      <% 
        const totalVotes = poll.options.reduce((sum, opt) => sum + opt.votes, 0);
        const sortedOptions = [...poll.options].sort((a, b) => b.votes - a.votes);
        sortedOptions.forEach((option, index) => { 
          const percentage = totalVotes > 0 ? ((option.votes / totalVotes) * 100).toFixed(1) : 0;
      %>
        <div class="option-result-item" data-option-id="<%= option._id %>">
          <div class="option-info">
            <div class="option-rank">#<%= index + 1 %></div>
            <div class="option-name"><%= option.text %></div>
          </div>
          <div class="option-stats">
            <span class="option-votes"><%= option.votes %>표</span>
            <span class="option-percentage"><%= percentage %>%</span>
          </div>
        </div>
      <% }); %>
    </div>

    <!-- 액션 버튼 -->
    <div class="stats-card">
      <div class="action-buttons">
        <a href="/polls/<%= poll._id %>" class="action-btn btn-primary-action">
          <span>🗳️</span>
          <span>투표하러 가기</span>
        </a>
        <a href="/polls" class="action-btn btn-secondary-action">
          <span>📋</span>
          <span>목록으로</span>
        </a>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  
  <script>
    // 다크모드 함수들
    function initDarkMode() {
      const savedTheme = localStorage.getItem('theme') || 'light';
      document.documentElement.setAttribute('data-theme', savedTheme);
      updateThemeIcon(savedTheme);
    }

    function toggleDarkMode() {
      const currentTheme = document.documentElement.getAttribute('data-theme');
      const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
      
      document.documentElement.setAttribute('data-theme', newTheme);
      localStorage.setItem('theme', newTheme);
      updateThemeIcon(newTheme);
    }

    function updateThemeIcon(theme) {
      const icon = document.getElementById('themeIcon');
      const text = document.getElementById('themeText');
      
      if (icon && text) {
        if (theme === 'dark') {
          icon.textContent = '☀️';
          text.textContent = '라이트';
        } else {
          icon.textContent = '🌙';
          text.textContent = '다크';
        }
      }
    }

    // 즉시 다크모드 초기화
    initDarkMode();

    // 차트 데이터
    const pollId = '<%= poll._id %>';
    const socket = io();

    const colors = [
      'rgba(102, 126, 234, 0.8)',
      'rgba(118, 75, 162, 0.8)',
      'rgba(237, 100, 166, 0.8)',
      'rgba(255, 154, 158, 0.8)',
      'rgba(250, 208, 196, 0.8)',
      'rgba(155, 93, 229, 0.8)',
      'rgba(237, 187, 153, 0.8)',
      'rgba(34, 197, 94, 0.8)'
    ];

    const locationColors = [
      'rgba(50, 50, 50, 0.8)',
      'rgba(100, 100, 100, 0.8)',
      'rgba(150, 150, 150, 0.8)',
      'rgba(180, 180, 180, 0.8)',
      'rgba(210, 210, 210, 0.8)',
      'rgba(70, 70, 70, 0.8)',
      'rgba(120, 120, 120, 0.8)',
      'rgba(160, 160, 160, 0.8)'
    ];

    // 메인 차트
    const ctx = document.getElementById('pollChart').getContext('2d');
    let pollChart = new Chart(ctx, {
      type: 'pie',
      data: {
        labels: [
          <% poll.options.forEach((option, index) => { %>
            '<%= option.text %>'<%= index < poll.options.length - 1 ? ',' : '' %>
          <% }); %>
        ],
        datasets: [{
          data: [
            <% poll.options.forEach((option, index) => { %>
              <%= option.votes %><%= index < poll.options.length - 1 ? ',' : '' %>
            <% }); %>
          ],
          backgroundColor: colors,
          borderColor: 'white',
          borderWidth: 2
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: {
            position: 'bottom',
            labels: {
              padding: 15,
              font: { size: 12 },
              color: getComputedStyle(document.documentElement).getPropertyValue('--text-color')
            }
          },
          tooltip: {
            callbacks: {
              label: function(context) {
                const label = context.label || '';
                const value = context.parsed || 0;
                const total = context.dataset.data.reduce((a, b) => a + b, 0);
                const percentage = total > 0 ? ((value / total) * 100).toFixed(1) : 0;
                return label + ': ' + value + '표 (' + percentage + '%)';
              }
            }
          }
        }
      }
    });

    // 지역 차트
    const locationCtx = document.getElementById('locationChart').getContext('2d');
    let locationChart = new Chart(locationCtx, {
      type: 'pie',
      data: {
        labels: [
          <% if (locationStats && locationStats.length > 0) { %>
            <% locationStats.forEach((stat, index) => { %>
              '<%= stat._id || "알 수 없음" %>'<%= index < locationStats.length - 1 ? ',' : '' %>
            <% }); %>
          <% } else { %>
            '투표 데이터 없음'
          <% } %>
        ],
        datasets: [{
          data: [
            <% if (locationStats && locationStats.length > 0) { %>
              <% locationStats.forEach((stat, index) => { %>
                <%= stat.count %><%= index < locationStats.length - 1 ? ',' : '' %>
              <% }); %>
            <% } else { %>
              0
            <% } %>
          ],
          backgroundColor: locationColors,
          borderColor: 'white',
          borderWidth: 2
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: {
            position: 'bottom',
            labels: {
              padding: 10,
              font: { size: 11 },
              color: getComputedStyle(document.documentElement).getPropertyValue('--text-color')
            }
          }
        }
      }
    });

    // Socket.io 실시간 업데이트
    socket.on('vote-update', (data) => {
      if (data.pollId === pollId) {
        console.log('투표 업데이트 수신:', data);
        
        pollChart.data.datasets[0].data = data.poll.options.map(opt => opt.votes);
        pollChart.update('active');

        const totalVotes = data.poll.options.reduce((sum, opt) => sum + opt.votes, 0);
        document.getElementById('total-votes').textContent = totalVotes;

        data.poll.options.forEach(option => {
          const optionElement = document.querySelector('[data-option-id="' + option._id + '"]');
          if (optionElement) {
            const percentage = totalVotes > 0 ? ((option.votes / totalVotes) * 100).toFixed(1) : 0;
            optionElement.querySelector('.option-votes').textContent = option.votes + '표';
            optionElement.querySelector('.option-percentage').textContent = percentage + '%';
          }
        });
      }
    });
  </script>
</body>
</html>