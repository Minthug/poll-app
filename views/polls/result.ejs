  const locationColors = [
    'rgba(50, 50, 50, 0.8)',
    'rgba(100, 100, 100, 0.8)',
    'rgba(150, 150, 150, 0.8)',
    'rgba(180, 180, 180, 0.8)',
    'rgba(210, 210, 210, 0.8)',
    'rgba(70, 70, 70, 0.8)',
    'rgba(120, 120, 120, 0.8)',
    'rgba(160, 160, 160, 0.8)'
  ];

  // 메인 차트
  const ctx = document.getElementById('pollChart').getContext('2d');
  let pollChart = new Chart(ctx, {
    type: 'pie',
    data: {
      labels: [
        <% poll.options.forEach((option, index) => { %>
          '<%= option.text %>'<%= index < poll.options.length - 1 ? ',' : '' %>
        <% }); %>
      ],
      datasets: [{
        data: [
          <% poll.options.forEach((option, index) => { %>
            <%= option.votes %><%= index < poll.options.length - 1 ? ',' : '' %>
          <% }); %>
        ],
        backgroundColor: colors,
        borderColor: 'white',
        borderWidth: 2
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: {
          position: 'bottom',
          labels: {
            padding: 15,
            font: { size: 12 },
            color: getComputedStyle(document.documentElement).getPropertyValue('--text-color')
          }
        },
        tooltip: {
          callbacks: {
            label: function(context) {
              const label = context.label || '';
              const value = context.parsed || 0;
              const total = context.dataset.data.reduce((a, b) => a + b, 0);
              const percentage = total > 0 ? ((value / total) * 100).toFixed(1) : 0;
              return label + ': ' + value + '표 (' + percentage + '%)';
            }
          }
        }
      }
    }
  });

  // 지역 차트
  const locationCtx = document.getElementById('locationChart').getContext('2d');
  let locationChart = new Chart(locationCtx, {
    type: 'pie',
    data: {
      labels: [
        <% if (locationStats && locationStats.length > 0) { %>
          <% locationStats.forEach((stat, index) => { %>
            '<%= stat._id || "알 수 없음" %>'<%= index < locationStats.length - 1 ? ',' : '' %>
          <% }); %>
        <% } else { %>
          '투표 데이터 없음'
        <% } %>
      ],
      datasets: [{
        data: [
          <% if (locationStats && locationStats.length > 0) { %>
            <% locationStats.forEach((stat, index) => { %>
              <%= stat.count %><%= index < locationStats.length - 1 ? ',' : '' %>
            <% }); %>
          <% } else { %>
            0
          <% } %>
        ],
        backgroundColor: locationColors,
        borderColor: 'white',
        borderWidth: 2
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: {
          position: 'bottom',
          labels: {
            padding: 10,
            font: { size: 11 },
            color: getComputedStyle(document.documentElement).getPropertyValue('--text-color')
          }
        }
      }
    }
  });

  // ========================================
  // 1. 공유 링크 복사
  // ========================================
  function copyShareLink() {
    const shareUrl = window.location.origin + '/polls/<%= poll._id %>';
    
    navigator.clipboard.writeText(shareUrl).then(() => {
      showToast('✅ 링크가 클립보드에 복사되었습니다!');
    }).catch(err => {
      // 폴백: 구식 방법
      const textArea = document.createElement('textarea');
      textArea.value = shareUrl;
      document.body.appendChild(textArea);
      textArea.select();
      document.execCommand('copy');
      document.body.removeChild(textArea);
      showToast('✅ 링크가 복사되었습니다!');
    });
  }

  // ========================================
  // 2. QR코드 관련 변수 및 함수 (새로 추가!)
  // ========================================
  let currentQRCanvas = null;
  let qrCodeInstance = null;

  function showQRCode() {
  console.log('🔍 showQRCode 시작');
  
  const modal = document.getElementById('qrModal');
  const qrContainer = document.getElementById('qrcode');
  
  console.log('modal:', modal);
  console.log('qrContainer:', qrContainer);
  
  if (!modal) {
    console.error('❌ qrModal을 찾을 수 없습니다');
    alert('QR 모달을 찾을 수 없습니다. 페이지를 새로고침해주세요.');
    return;
  }
  
  if (!qrContainer) {
    console.error('❌ qrcode 컨테이너를 찾을 수 없습니다');
    alert('QR 컨테이너를 찾을 수 없습니다. 페이지를 새로고침해주세요.');
    return;
  }
  
  const pollUrl = window.location.origin + '/polls/<%= poll._id %>';
  console.log('📍 URL:', pollUrl);
  
  // 기존 내용 초기화
  qrContainer.innerHTML = '';
  
  try {
    // QR코드 생성
    new QRCode(qrContainer, {
      text: pollUrl,
      width: 300,
      height: 300,
      colorDark: '#000000',
      colorLight: '#ffffff',
      correctLevel: QRCode.correctLevel.H
    });
    
    console.log('✅ QR코드 생성 시작');
    
    // 약간의 딜레이 후 모달 표시
    setTimeout(() => {
      // Canvas 또는 Image 찾기
      currentQRCanvas = qrContainer.querySelector('canvas') || qrContainer.querySelector('img');
      
      console.log('currentQRCanvas:', currentQRCanvas);
      console.log('qrContainer.innerHTML:', qrContainer.innerHTML);
      
      if (currentQRCanvas) {
        modal.style.display = 'flex';
        showToast('✅ QR코드가 생성되었습니다!');
      } else {
        console.error('❌ Canvas/Image를 찾을 수 없음');
        alert('QR코드 생성에 실패했습니다. 새로고침 후 다시 시도해주세요.');
      }
    }, 200); // 200ms로 약간 늘림
    
  } catch (error) {
    console.error('❌ QR코드 생성 오류:', error);
    alert('QR코드 생성 중 오류: ' + error.message);
  }
}

  // QR코드 모달 닫기
  function closeQRModal() {
    const modal = document.getElementById('qrModal');
    modal.style.display = 'none';
  }

  // QR코드 다운로드
  function downloadQRCode() {
    if (!currentQRCanvas) {
      showToast('❌ QR코드를 먼저 생성해주세요');
      return;
    }
    
    currentQRCanvas.toBlob((blob) => {
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.download = 'poll-qr-<%= poll._id %>-' + Date.now() + '.png';
      link.href = url;
      link.click();
      URL.revokeObjectURL(url);
      
      showToast('✅ QR코드가 다운로드되었습니다!');
    });
  }

  // QR코드 인쇄
  function printQRCode() {
    if (!currentQRCanvas) {
      showToast('❌ QR코드를 먼저 생성해주세요');
      return;
    }
    
    const printWindow = window.open('', '', 'width=600,height=800');
    const pollTitle = '<%= poll.title.replace(/'/g, "\\'") %>';
    const qrImage = currentQRCanvas.toDataURL();
    const pollUrl = window.location.origin + '/polls/<%= poll._id %>';
    
    printWindow.document.write(`
      <!DOCTYPE html>
      <html>
      <head>
        <title>투표 QR코드 - ${pollTitle}</title>
        <style>
          body {
            font-family: 'Pretendard', -apple-system, sans-serif;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            margin: 0;
            padding: 40px;
          }
          .print-container {
            text-align: center;
            max-width: 500px;
          }
          h1 {
            font-size: 2rem;
            margin-bottom: 20px;
            color: #333;
          }
          .qr-image {
            margin: 30px 0;
            padding: 20px;
            background: white;
            border: 2px solid #ddd;
            border-radius: 15px;
          }
          img {
            display: block;
            margin: 0 auto;
          }
          .url {
            font-size: 0.9rem;
            color: #666;
            margin-top: 20px;
            word-break: break-all;
          }
          .instructions {
            margin-top: 30px;
            padding: 20px;
            background: #f5f5f5;
            border-radius: 10px;
            text-align: left;
          }
          .instructions h3 {
            margin-top: 0;
            color: #333;
          }
          .instructions ol {
            padding-left: 20px;
          }
          .instructions li {
            margin: 10px 0;
            color: #555;
          }
          @media print {
            body {
              padding: 0;
            }
          }
        </style>
      </head>
      <body>
        <div class="print-container">
          <h1>${pollTitle}</h1>
          <p>스마트폰으로 QR코드를 스캔하여 투표에 참여하세요</p>
          
          <div class="qr-image">
            <img src="${qrImage}" width="300" height="300" />
          </div>
          
          <div class="url">
            ${pollUrl}
          </div>
          
          <div class="instructions">
            <h3>📱 참여 방법</h3>
            <ol>
              <li>스마트폰 카메라 앱을 실행하세요</li>
              <li>위의 QR코드를 스캔하세요</li>
              <li>링크를 클릭하여 투표 페이지로 이동하세요</li>
              <li>원하는 항목에 투표하세요</li>
            </ol>
          </div>
        </div>
        <script>
          window.onload = function() {
            setTimeout(function() {
              window.print();
            }, 500);
          };
        <\/script>
      </body>
      </html>
    `);
    
    printWindow.document.close();
    showToast('🖨️ 인쇄 창이 열렸습니다!');
  }

  // ESC 키로 모달 닫기
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeQRModal();
    }
  });

  // ========================================
  // 3. 이미지로 저장
  // ========================================
  async function downloadAsImage() {
    showToast('📸 이미지 생성 중...');
    
    try {
      const resultContainer = document.querySelector('.result-container');
      
      // html2canvas로 캡처
      const canvas = await html2canvas(resultContainer, {
        backgroundColor: getComputedStyle(document.documentElement)
          .getPropertyValue('--bg-color'),
        scale: 2, // 고해상도
        logging: false,
        useCORS: true
      });
      
      // 이미지로 변환
      canvas.toBlob((blob) => {
        const url = URL.createObjectURL(blob);
        const link = document.createElement('a');
        link.download = 'poll-result-<%= poll._id %>-' + Date.now() + '.png';
        link.href = url;
        link.click();
        URL.revokeObjectURL(url);
        
        showToast('✅ 이미지가 다운로드되었습니다!');
      });
      
    } catch (error) {
      console.error('이미지 생성 오류:', error);
      showToast('❌ 이미지 생성 중 오류가 발생했습니다');
    }
  }

  // ========================================
  // 토스트 알림 표시
  // ========================================
  function showToast(message) {
    // 기존 토스트 제거
    const existingToast = document.querySelector('.toast');
    if (existingToast) {
      existingToast.remove();
    }
    
    // 새 토스트 생성
    const toast = document.createElement('div');
    toast.className = 'toast';
    toast.innerHTML = `
      <span style="font-size: 1.5rem;">📢</span>
      <span style="font-weight: 600;">${message}</span>
    `;
    
    document.body.appendChild(toast);
    
    // 3초 후 제거
    setTimeout(() => {
      toast.classList.add('fade-out');
      setTimeout(() => {
        toast.remove();
      }, 300);
    }, 3000);
  }

  // ========================================
  // Socket.io 실시간 업데이트
  // ========================================
  socket.on('vote-update', (data) => {
    if (data.pollId === pollId) {
      console.log('투표 업데이트 수신:', data);
      
      pollChart.data.datasets[0].data = data.poll.options.map(opt => opt.votes);
      pollChart.update('active');

      const totalVotes = data.poll.options.reduce((sum, opt) => sum + opt.votes, 0);
      document.getElementById('total-votes').textContent = totalVotes;

      data.poll.options.forEach(option => {
        const optionElement = document.querySelector('[data-option-id="' + option._id + '"]');
        if (optionElement) {
          const percentage = totalVotes > 0 ? ((option.votes / totalVotes) * 100).toFixed(1) : 0;
          optionElement.querySelector('.option-votes').textContent = option.votes + '표';
          optionElement.querySelector('.option-percentage').textContent = percentage + '%';
        }
      });
    }
  });
</script>