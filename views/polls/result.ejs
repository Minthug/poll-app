<!-- 메인 콘텐츠만 -->
<div class="result-container">
  <!-- 알림 배너 -->
  <% if (typeof alreadyVoted !== 'undefined' && alreadyVoted) { %>
    <div class="alert-banner">
      <div class="alert-banner-icon">✅</div>
      <div class="alert-banner-content">
        <div class="alert-banner-title">이미 투표하셨습니다</div>
        <div>투표해 주셔서 감사합니다!</div>
      </div>
    </div>
  <% } %>
  
  <% if (typeof ended !== 'undefined' && ended) { %>
    <div class="alert-banner">
      <div class="alert-banner-icon">⏰</div>
      <div class="alert-banner-content">
        <div class="alert-banner-title">투표가 종료되었습니다</div>
        <div>최종 결과를 확인하세요</div>
      </div>
    </div>
  <% } %>

  <!-- 헤더 -->
  <div class="result-header-card">
    <div class="poll-badges">
      <% if (poll.category) { %>
        <span class="poll-badge badge-category"><%= poll.category %></span>
      <% } %>
      <% if (poll.tags && poll.tags.length > 0) { %>
        <% poll.tags.forEach(tag => { %>
          <span class="poll-badge badge-tag">#<%= tag %></span>
        <% }); %>
      <% } %>
    </div>
    
    <h1 class="poll-title"><%= poll.title %></h1>
    
    <% if (poll.description) { %>
      <p class="poll-description"><%= poll.description %></p>
    <% } %>
  </div>

  <!-- 통계 -->
  <div class="stats-card">
    <div class="stats-grid">
      <div class="stat-item">
        <div class="stat-number" id="total-votes">
          <%= poll.options.reduce((sum, opt) => sum + opt.votes, 0) %>
        </div>
        <div class="stat-label">총 투표수</div>
      </div>
      
      <div class="stat-item">
        <div class="stat-number"><%= poll.options.length %></div>
        <div class="stat-label">선택지 수</div>
      </div>
      
      <div class="stat-item">
        <div class="stat-number">
          <%= new Date(poll.createdAt).toLocaleDateString('ko-KR', { month: 'numeric', day: 'numeric' }) %>
        </div>
        <div class="stat-label">생성일</div>
      </div>
      
      <div class="stat-item">
        <span class="live-badge">
          <span class="live-dot"></span>
          <span>실시간</span>
        </span>
        <div class="stat-label" style="margin-top: 10px;">자동 업데이트</div>
      </div>
    </div>
  </div>

  <!-- 차트 -->
  <div class="charts-section">
    <div class="chart-card">
      <h3 class="chart-title">
        <span>📊</span>
        <span>투표 결과</span>
      </h3>
      <div class="chart-container">
        <canvas id="pollChart"></canvas>
      </div>
    </div>

    <div class="chart-card">
      <h3 class="chart-title">
        <span>🗺️</span>
        <span>지역별 분포</span>
      </h3>
      <div class="location-chart-container">
        <canvas id="locationChart"></canvas>
      </div>
    </div>
  </div>

  <!-- 상세 결과 -->
  <div class="details-card">
    <h3 class="section-title">
      <span>📋</span>
      <span>상세 결과</span>
    </h3>
    
    <% 
      const totalVotes = poll.options.reduce((sum, opt) => sum + opt.votes, 0);
      const sortedOptions = [...poll.options].sort((a, b) => b.votes - a.votes);
      sortedOptions.forEach((option, index) => { 
        const percentage = totalVotes > 0 ? ((option.votes / totalVotes) * 100).toFixed(1) : 0;
    %>
      <div class="option-result-item" data-option-id="<%= option._id %>">
        <div class="option-info">
          <div class="option-rank">#<%= index + 1 %></div>
          <div class="option-name"><%= option.text %></div>
        </div>
        <div class="option-stats">
          <span class="option-votes"><%= option.votes %>표</span>
          <span class="option-percentage"><%= percentage %>%</span>
        </div>
      </div>
    <% }); %>
  </div>

  <!-- ========================================
       공유 및 내보내기 버튼 (새로 추가)
       ======================================== -->
  <div class="stats-card">
    <h3 class="section-title">
      <span>📤</span>
      <span>결과 공유 및 내보내기</span>
    </h3>
    
    <div class="export-buttons">
      <!-- 1. 공유 URL -->
      <button class="export-btn btn-share" onclick="copyShareLink()">
        <span class="export-icon">🔗</span>
        <div>
          <div class="export-title">투표 공유하기</div>
          <div class="export-desc">링크 복사</div>
        </div>
      </button>
      
      <!-- 2. 이미지 저장 -->
      <button class="export-btn btn-image" onclick="downloadAsImage()">
        <span class="export-icon">📸</span>
        <div>
          <div class="export-title">이미지로 저장</div>
          <div class="export-desc">SNS 공유용</div>
        </div>
      </button>
      
      <!-- QR코드 -->
       <button class="export-btn btn-qr" onclick="showQRCode()">
        <span class="export-icon">📱</span>
        <div>
          <div class="export-title">QR코드 생성</div>
          <div class="export-desc">오프라인 홍보용</div>
        </div>
       </button>

      <!-- 4. CSV 다운로드 -->
      <a href="/polls/<%= poll._id %>/export-csv" class="export-btn btn-csv">
        <span class="export-icon">📊</span>
        <div>
          <div class="export-title">데이터 다운로드</div>
          <div class="export-desc">CSV 파일</div>
        </div>
      </a>
    </div>
  </div>

  <!-- 액션 버튼 -->
  <div class="stats-card">
    <div class="action-buttons">
      <a href="/polls/<%= poll._id %>" class="action-btn btn-primary-action">
        <span>🗳️</span>
        <span>투표하러 가기</span>
      </a>
      <a href="/polls" class="action-btn btn-secondary-action">
        <span>📋</span>
        <span>목록으로</span>
      </a>
    </div>
  </div>
</div>

<!-- ========================================
     QR코드 모달 (새로 추가)
     ======================================== -->
<div id="qrModal" class="qr-modal" style="display: none;">
  <div class="qr-modal-overlay" onclick="closeQRModal()"></div>
  <div class="qr-modal-content">
    <button class="qr-close-btn" onclick="closeQRModal()">x</button>
    <h2 class="qr-modal-title">투표 QR코드</h2>
    <p class="qr-modal-suntitle">스마트폰으로 스캔하여 투표하세요</p>

    <div class="qr-code-container">
      <div id="qrcode"></div>
    </div>

    <div class="qr-url">
      <%= poll.title %>
    </div>

    <div class="qr-actions">
      <button class="qr-action-btn" onclick="downloadQRCode()">
        <span>💾</span>
        <span>QR코드 다운로드</span>
      </button>
      <button class="qr-action-btn" onclick="printQRCode()">
        <span>🖨️</span>
        <span>인쇄하기</span>
      </button>
    </div>
  </div>
</div>

