<!-- 메인 콘텐츠만 -->
<div class="result-container">
  <!-- 알림 배너 -->
  <% if (typeof alreadyVoted !== 'undefined' && alreadyVoted) { %>
    <div class="alert-banner">
      <div class="alert-banner-icon">✅</div>
      <div class="alert-banner-content">
        <div class="alert-banner-title">이미 투표하셨습니다</div>
        <div>투표해 주셔서 감사합니다!</div>
      </div>
    </div>
  <% } %>
  
  <% if (typeof ended !== 'undefined' && ended) { %>
    <div class="alert-banner">
      <div class="alert-banner-icon">⏰</div>
      <div class="alert-banner-content">
        <div class="alert-banner-title">투표가 종료되었습니다</div>
        <div>최종 결과를 확인하세요</div>
      </div>
    </div>
  <% } %>

  <!-- 헤더 -->
  <div class="result-header-card">
    <div class="poll-badges">
      <% if (poll.category) { %>
        <span class="poll-badge badge-category"><%= poll.category %></span>
      <% } %>
      <% if (poll.tags && poll.tags.length > 0) { %>
        <% poll.tags.forEach(tag => { %>
          <span class="poll-badge badge-tag">#<%= tag %></span>
        <% }); %>
      <% } %>
    </div>
    
    <h1 class="poll-title"><%= poll.title %></h1>
    
    <% if (poll.description) { %>
      <p class="poll-description"><%= poll.description %></p>
    <% } %>
  </div>

  <!-- 통계 -->
  <div class="stats-card">
    <div class="stats-grid">
      <div class="stat-item">
        <div class="stat-number" id="total-votes">
          <%= poll.options.reduce((sum, opt) => sum + opt.votes, 0) %>
        </div>
        <div class="stat-label">총 투표수</div>
      </div>
      
      <div class="stat-item">
        <div class="stat-number"><%= poll.options.length %></div>
        <div class="stat-label">선택지 수</div>
      </div>
      
      <div class="stat-item">
        <div class="stat-number">
          <%= new Date(poll.createdAt).toLocaleDateString('ko-KR', { month: 'numeric', day: 'numeric' }) %>
        </div>
        <div class="stat-label">생성일</div>
      </div>
      
      <div class="stat-item">
        <span class="live-badge">
          <span class="live-dot"></span>
          <span>실시간</span>
        </span>
        <div class="stat-label" style="margin-top: 10px;">자동 업데이트</div>
      </div>
    </div>
  </div>

  <!-- 차트 -->
  <div class="charts-section">
    <div class="chart-card">
      <h3 class="chart-title">
        <span>📊</span>
        <span>투표 결과</span>
      </h3>
      <div class="chart-container">
        <canvas id="pollChart"></canvas>
      </div>
    </div>

    <div class="chart-card">
      <h3 class="chart-title">
        <span>🗺️</span>
        <span>지역별 분포</span>
      </h3>
      <div class="location-chart-container">
        <canvas id="locationChart"></canvas>
      </div>
    </div>
  </div>

  <!-- 상세 결과 -->
  <div class="details-card">
    <h3 class="section-title">
      <span>📋</span>
      <span>상세 결과</span>
    </h3>
    
    <% 
      const totalVotes = poll.options.reduce((sum, opt) => sum + opt.votes, 0);
      const sortedOptions = [...poll.options].sort((a, b) => b.votes - a.votes);
      sortedOptions.forEach((option, index) => { 
        const percentage = totalVotes > 0 ? ((option.votes / totalVotes) * 100).toFixed(1) : 0;
    %>
      <div class="option-result-item" data-option-id="<%= option._id %>">
        <div class="option-info">
          <div class="option-rank">#<%= index + 1 %></div>
          <div class="option-name"><%= option.text %></div>
        </div>
        <div class="option-stats">
          <span class="option-votes"><%= option.votes %>표</span>
          <span class="option-percentage"><%= percentage %>%</span>
        </div>
      </div>
    <% }); %>
  </div>

  <!-- 액션 버튼 -->
  <div class="stats-card">
    <div class="action-buttons">
      <a href="/polls/<%= poll._id %>" class="action-btn btn-primary-action">
        <span>🗳️</span>
        <span>투표하러 가기</span>
      </a>
      <a href="/polls" class="action-btn btn-secondary-action">
        <span>📋</span>
        <span>목록으로</span>
      </a>
    </div>
  </div>
</div>

<!-- 이 페이지만의 스타일 -->
<style>
  .result-container {
    max-width: 1000px;
    margin: 0 auto;
  }
  
  /* 알림 배너 */
  .alert-banner {
    background: linear-gradient(135deg, #ffeaa7 0%, #fdcb6e 100%);
    color: #2d3436;
    padding: 20px 25px;
    border-radius: 20px;
    margin-bottom: 30px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.2);
    display: flex;
    align-items: center;
    gap: 15px;
    animation: slideDown 0.5s ease-out;
  }
  
  .alert-banner-icon {
    font-size: 28px;
  }
  
  .alert-banner-content {
    flex: 1;
  }
  
  .alert-banner-title {
    font-weight: 700;
    font-size: 1.1rem;
    margin-bottom: 5px;
  }
  
  @keyframes slideDown {
    from {
      transform: translateY(-20px);
      opacity: 0;
    }
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }
  
  /* 헤더 카드 */
  .result-header-card {
    background: var(--card-bg);
    border-radius: 30px;
    padding: 40px;
    box-shadow: 0 20px 60px rgba(0,0,0,0.3);
    margin-bottom: 30px;
    text-align: center;
  }
  
  .poll-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: center;
    margin-bottom: 20px;
  }
  
  .poll-badge {
    padding: 6px 15px;
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 600;
  }
  
  .badge-category {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
  }
  
  .badge-tag {
    background: var(--border-color);
    color: var(--text-color);
  }
  
  [data-theme="dark"] .badge-tag {
    background: #404040;
  }
  
  .poll-title {
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--text-color);
    margin-bottom: 15px;
    line-height: 1.3;
  }
  
  .poll-description {
    font-size: 1.2rem;
    color: var(--secondary-text);
    line-height: 1.6;
  }
  
  /* 통계 카드 */
  .stats-card {
    background: var(--card-bg);
    border-radius: 20px;
    padding: 30px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.2);
    margin-bottom: 30px;
  }
  
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 20px;
    text-align: center;
  }
  
  .stat-item {
    padding: 20px;
    background: var(--border-color);
    border-radius: 15px;
    transition: all 0.3s ease;
  }
  
  [data-theme="dark"] .stat-item {
    background: #3a3a3a;
  }
  
  .stat-item:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 20px rgba(102, 126, 234, 0.3);
  }
  
  .stat-number {
    font-size: 2.5rem;
    font-weight: 800;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 8px;
  }
  
  .stat-label {
    color: var(--secondary-text);
    font-size: 0.95rem;
    font-weight: 600;
  }
  
  .live-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 15px;
    background: #22c55e;
    color: white;
    border-radius: 20px;
    font-weight: 600;
    font-size: 0.9rem;
  }
  
  .live-dot {
    width: 8px;
    height: 8px;
    background: white;
    border-radius: 50%;
    animation: pulse 2s infinite;
  }
  
  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
