  .qr-action-btn {
    padding: 15px 25px;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    border: none;
    border-radius: 50px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }
  
  .qr-action-btn:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 20px rgba(102, 126, 234, 0.4);
  }
  
  /* 토스트 */
  .toast {
    position: fixed;
    bottom: 30px;
    right: 30px;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    padding: 18px 25px;
    border-radius: 15px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.4);
    display: flex;
    align-items: center;
    gap: 12px;
    z-index: 10000;
    animation: slideInRight 0.3s ease;
  }
  
  .toast.fade-out {
    animation: slideOutRight 0.3s ease;
  }
  
  @keyframes slideInRight {
    from {
      transform: translateX(400px);
      opacity: 0;
    }
    to {
      transform: translateX(0);
      opacity: 1;
    }
  }
  
  @keyframes slideOutRight {
    from {
      transform: translateX(0);
      opacity: 1;
    }
    to {
      transform: translateX(400px);
      opacity: 0;
    }
  }
  
  /* 액션 버튼 */
  .action-buttons {
    display: flex;
    gap: 15px;
    justify-content: center;
    flex-wrap: wrap;
  }
  
  .action-btn {
    padding: 15px 35px;
    border: none;
    border-radius: 50px;
    font-size: 1.05rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  
  .btn-primary-action {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    box-shadow: 0 8px 25px rgba(102, 126, 234, 0.4);
  }
  
  .btn-primary-action:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 35px rgba(102, 126, 234, 0.5);
    color: white;
  }
  
  .btn-secondary-action {
    background: transparent;
    color: var(--text-color);
    border: 2px solid var(--border-color);
  }
  
  .btn-secondary-action:hover {
    background: var(--border-color);
    transform: translateY(-3px);
    color: var(--text-color);
  }

  .vote-breakdown {
    display: flex;
    gap: 20px;
    margin-top: 8px;
    font-size: 0.9rem;
    color: var(--secondary-text);
}

.member-votes {
    color: #667eea;
    font-weight: 600;
}

.anonymous-votes {
    color: #999;
}
  
  /* 반응형 */
  @media (max-width: 768px) {
    .poll-title {
      font-size: 2rem;
    }
    
    .charts-section {
      grid-template-columns: 1fr;
    }
    
    .export-buttons {
      grid-template-columns: 1fr 1fr;
    }
    
    .embed-buttons {
      grid-template-columns: 1fr;
    }
    
    .qr-modal-content {
      padding: 30px;
    }
    
    .qr-actions {
      grid-template-columns: 1fr;
    }
    
    .action-buttons {
      flex-direction: column;
    }
    
    .action-btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>

<!-- 라이브러리 -->
<script src="/socket.io/socket.io.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>

<script>
  const pollId = '<%= poll._id %>';
  const socket = io();

  const colors = [
    'rgba(102, 126, 234, 0.8)',
    'rgba(118, 75, 162, 0.8)',
    'rgba(237, 100, 166, 0.8)',
    'rgba(255, 154, 158, 0.8)',
    'rgba(250, 208, 196, 0.8)',
    'rgba(155, 93, 229, 0.8)',
    'rgba(237, 187, 153, 0.8)',
    'rgba(34, 197, 94, 0.8)'
  ];

  const locationColors = [
    'rgba(50, 50, 50, 0.8)',
    'rgba(100, 100, 100, 0.8)',
    'rgba(150, 150, 150, 0.8)',
    'rgba(180, 180, 180, 0.8)',
    'rgba(210, 210, 210, 0.8)',
    'rgba(70, 70, 70, 0.8)',
    'rgba(120, 120, 120, 0.8)',
    'rgba(160, 160, 160, 0.8)'
  ];

  // 메인 차트
  const ctx = document.getElementById('pollChart').getContext('2d');
  let pollChart = new Chart(ctx, {
    type: 'pie',
    data: {
      labels: [
        <% poll.options.forEach((option, index) => { %>
          '<%= option.text %>'<%= index < poll.options.length - 1 ? ',' : '' %>
        <% }); %>
      ],
      datasets: [{
        data: [
          <% poll.options.forEach((option, index) => { %>
            <%= option.votes %><%= index < poll.options.length - 1 ? ',' : '' %>
          <% }); %>
        ],
        backgroundColor: colors,
        borderColor: 'white',
        borderWidth: 2
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: {
          position: 'bottom',
          labels: {
            padding: 15,
            font: { size: 12 },
            color: getComputedStyle(document.documentElement).getPropertyValue('--text-color')
          }
        },
        tooltip: {
          callbacks: {
            label: function(context) {
              const label = context.label || '';
              const value = context.parsed || 0;
              const total = context.dataset.data.reduce((a, b) => a + b, 0);
              const percentage = total > 0 ? ((value / total) * 100).toFixed(1) : 0;
              return label + ': ' + value + '표 (' + percentage + '%)';
            }
          }
        }
      }
    }
  });

  // 지역 차트
  const locationCtx = document.getElementById('locationChart').getContext('2d');
  let locationChart = new Chart(locationCtx, {
    type: 'pie',
    data: {
      labels: [
        <% if (locationStats && locationStats.length > 0) { %>
          <% locationStats.forEach((stat, index) => { %>
            '<%= stat._id || "알 수 없음" %>'<%= index < locationStats.length - 1 ? ',' : '' %>
          <% }); %>
        <% } else { %>
          '투표 데이터 없음'
        <% } %>
      ],
      datasets: [{
        data: [
          <% if (locationStats && locationStats.length > 0) { %>
            <% locationStats.forEach((stat, index) => { %>
              <%= stat.count %><%= index < locationStats.length - 1 ? ',' : '' %>
            <% }); %>
          <% } else { %>
            0
          <% } %>
        ],
        backgroundColor: locationColors,
        borderColor: 'white',
        borderWidth: 2
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: {
          position: 'bottom',
          labels: {
            padding: 10,
            font: { size: 11 },
            color: getComputedStyle(document.documentElement).getPropertyValue('--text-color')
          }
        }
      }
    }
  });

  // 링크 복사
  function copyShareLink() {
    const shareUrl = window.location.origin + '/polls/<%= poll._id %>';
    
    navigator.clipboard.writeText(shareUrl).then(() => {
      showToast('✅ 링크가 클립보드에 복사되었습니다!');
    }).catch(err => {
      const textArea = document.createElement('textarea');
      textArea.value = shareUrl;
      document.body.appendChild(textArea);
      textArea.select();
      document.execCommand('copy');
      document.body.removeChild(textArea);
      showToast('✅ 링크가 복사되었습니다!');
    });
  }

  // 임베드 코드 복사
  function copyEmbedCode() {
    const code = document.getElementById('embedCode').textContent;
    
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(code).then(() => {
        const button = event.target;
        const originalText = button.innerHTML;
        button.innerHTML = '✅ 복사 완료!';
        button.style.background = 'linear-gradient(135deg, #11998e 0%, #38ef7d 100%)';
        
        setTimeout(() => {
          button.innerHTML = originalText;
          button.style.background = 'linear-gradient(135deg, #667eea 0%, #764ba2 100%)';
        }, 2000);
        
        showToast('✅ 임베드 코드가 복사되었습니다!');
      }).catch(err => {
        fallbackCopyEmbed(code);
      });
    } else {
      fallbackCopyEmbed(code);
    }
  }

  function fallbackCopyEmbed(text) {
    const textarea = document.createElement('textarea');
    textarea.value = text;
    textarea.style.position = 'fixed';
    textarea.style.opacity = '0';
    document.body.appendChild(textarea);
    textarea.select();
    
    try {
      document.execCommand('copy');
      showToast('✅ 임베드 코드가 복사되었습니다!');
    } catch (err) {
      showToast('❌ 복사에 실패했습니다. 수동으로 복사해주세요.');
    }
    
    document.body.removeChild(textarea);
  }

  // QR코드
  let currentQRCanvas = null;

  function showQRCode() {
    const modal = document.getElementById('qrModal');
    const qrContainer = document.getElementById('qrcode');
    
    if (!modal || !qrContainer) {
      alert('QR 모달을 찾을 수 없습니다.');
      return;
    }
    
    const pollUrl = window.location.origin + '/polls/<%= poll._id %>';
    qrContainer.innerHTML = '';
    
    try {
      new QRCode(qrContainer, {
        text: pollUrl,
        width: 300,
        height: 300,
        colorDark: '#000000',
        colorLight: '#ffffff',
      });
      
      setTimeout(() => {
        currentQRCanvas = qrContainer.querySelector('canvas') || qrContainer.querySelector('img');
        
        if (currentQRCanvas) {
          modal.style.display = 'flex';
          showToast('✅ QR코드가 생성되었습니다!');
        }
      }, 200);
      
    } catch (error) {
      console.error('QR코드 생성 오류:', error);
      showToast('❌ QR코드 생성 중 오류가 발생했습니다');
    }
  }

  function closeQRModal() {
    document.getElementById('qrModal').style.display = 'none';
  }

  function downloadQRCode() {
    if (!currentQRCanvas) {
      showToast('❌ QR코드를 먼저 생성해주세요');
      return;
    }
    
    currentQRCanvas.toBlob((blob) => {
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.download = 'poll-qr-<%= poll._id %>.png';
      link.href = url;
      link.click();
      URL.revokeObjectURL(url);
      showToast('✅ QR코드가 다운로드되었습니다!');
    });
  }

  function printQRCode() {
    if (!currentQRCanvas) {
      showToast('❌ QR코드를 먼저 생성해주세요');
      return;
    }
    
    const printWindow = window.open('', '', 'width=600,height=800');
    const pollTitle = '<%= poll.title.replace(/'/g, "\\'") %>';
    const qrImage = currentQRCanvas.toDataURL();
    const pollUrl = window.location.origin + '/polls/<%= poll._id %>';
    
    printWindow.document.write(`
      <!DOCTYPE html>
      <html>
      <head>
        <title>투표 QR코드 - ${pollTitle}</title>
        <style>
          body {
            font-family: sans-serif;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            margin: 0;
            padding: 40px;
          }
          h1 { font-size: 2rem; margin-bottom: 20px; }
          .qr-image { margin: 30px 0; padding: 20px; background: white; border: 2px solid #ddd; border-radius: 15px; }
          img { display: block; margin: 0 auto; }
          .url { font-size: 0.9rem; color: #666; margin-top: 20px; word-break: break-all; }
        </style>
      </head>
      <body>
        <h1>${pollTitle}</h1>
        <p>스마트폰으로 QR코드를 스캔하여 투표하세요</p>
        <div class="qr-image"><img src="${qrImage}" width="300" height="300" /></div>
        <div class="url">${pollUrl}</div>
        <script>
          window.onload = function() {
            setTimeout(function() { window.print(); }, 500);
          };
        <\/script>
      </body>
      </html>
    `);
    
    printWindow.document.close();
    showToast('🖨️ 인쇄 창이 열렸습니다!');
  }

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeQRModal();
  });

  // 이미지 저장
  async function downloadAsImage() {
    showToast('📸 이미지 생성 중...');
    
    try {
      const resultContainer = document.querySelector('.result-container');
      const canvas = await html2canvas(resultContainer, {
        backgroundColor: getComputedStyle(document.documentElement).getPropertyValue('--bg-color'),
        scale: 2,
        logging: false,
        useCORS: true
      });
      
      canvas.toBlob((blob) => {
        const url = URL.createObjectURL(blob);
        const link = document.createElement('a');
        link.download = 'poll-result-<%= poll._id %>.png';
        link.href = url;
        link.click();
        URL.revokeObjectURL(url);
        showToast('✅ 이미지가 다운로드되었습니다!');
      });
      
    } catch (error) {
      console.error('이미지 생성 오류:', error);
      showToast('❌ 이미지 생성 중 오류가 발생했습니다');
    }
  }

  // 토스트
  function showToast(message) {
    const existingToast = document.querySelector('.toast');
    if (existingToast) existingToast.remove();
    
    const toast = document.createElement('div');
    toast.className = 'toast';
    toast.innerHTML = `
      <span style="font-size: 1.5rem;">📢</span>
      <span style="font-weight: 600;">${message}</span>
    `;
    
    document.body.appendChild(toast);
    
    setTimeout(() => {
      toast.classList.add('fade-out');
      setTimeout(() => toast.remove(), 300);
    }, 3000);
  }

  // 실시간 업데이트
  socket.on('vote-update', (data) => {
    if (data.pollId === pollId) {
      pollChart.data.datasets[0].data = data.poll.options.map(opt => opt.votes);
      pollChart.update('active');

      const totalVotes = data.poll.options.reduce((sum, opt) => sum + opt.votes, 0);
      document.getElementById('total-votes').textContent = totalVotes;

      data.poll.options.forEach(option => {
        const optionElement = document.querySelector('[data-option-id="' + option._id + '"]');
        if (optionElement) {
          const percentage = totalVotes > 0 ? ((option.votes / totalVotes) * 100).toFixed(1) : 0;
          optionElement.querySelector('.option-votes').textContent = option.votes + '표';
          optionElement.querySelector('.option-percentage').textContent = percentage + '%';
        }
      });
    }
  });
</script>