<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>새 여론조사 만들기</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="/css/style.css">
  
  <style>
    :root {
      --bg-gradient-start: #667eea;
      --bg-gradient-end: #764ba2;
      --card-bg: white;
      --text-color: #333;
      --secondary-text: #666;
      --border-color: #e0e0e0;
      --input-bg: #f8f9fa;
    }
    
    [data-theme="dark"] {
      --bg-gradient-start: #1a1a2e;
      --bg-gradient-end: #16213e;
      --card-bg: #2d2d2d;
      --text-color: #e0e0e0;
      --secondary-text: #aaa;
      --border-color: #404040;
      --input-bg: #3a3a3a;
    }
    
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: linear-gradient(135deg, var(--bg-gradient-start) 0%, var(--bg-gradient-end) 100%);
      min-height: 100vh;
      padding: 40px 20px;
      transition: background 0.3s ease;
    }
    
    .form-container {
      max-width: 700px;
      margin: 0 auto;
    }
    
    /* 헤더 */
    .page-header {
      text-align: center;
      background: var(--card-bg);
      border-radius: 30px;
      padding: 40px 30px;
      box-shadow: 0 20px 60px rgba(0,0,0,0.3);
      margin-bottom: 30px;
    }
    
    .page-title {
      font-size: 2.5rem;
      font-weight: 800;
      color: var(--text-color);
      margin-bottom: 10px;
    }
    
    .page-subtitle {
      font-size: 1.1rem;
      color: var(--secondary-text);
    }
    
    /* 폼 카드 */
    .form-card {
      background: var(--card-bg);
      border-radius: 20px;
      padding: 40px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.2);
    }
    
    .form-section {
      margin-bottom: 30px;
    }
    
    .form-section-title {
      font-size: 1.2rem;
      font-weight: 700;
      color: var(--text-color);
      margin-bottom: 15px;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    
    .form-label {
      font-weight: 600;
      color: var(--text-color);
      margin-bottom: 8px;
    }
    
    .form-control, .form-select {
      background: var(--input-bg);
      border: 2px solid var(--border-color);
      color: var(--text-color);
      border-radius: 12px;
      padding: 12px 15px;
      transition: all 0.3s ease;
    }
    
    .form-control:focus, .form-select:focus {
      background: var(--card-bg);
      border-color: #667eea;
      box-shadow: 0 0 0 4px rgba(102, 126, 234, 0.1);
      color: var(--text-color);
    }
    
    [data-theme="dark"] .form-control:focus,
    [data-theme="dark"] .form-select:focus {
      background: var(--input-bg);
    }
    
    /* 옵션 리스트 */
    .option-item {
      display: flex;
      gap: 10px;
      margin-bottom: 15px;
      align-items: center;
    }
    
    .option-item input {
      flex: 1;
    }
    
    .btn-remove {
      background: #dc3545;
      color: white;
      border: none;
      border-radius: 10px;
      padding: 10px 15px;
      cursor: pointer;
      transition: all 0.3s ease;
    }
    
    .btn-remove:hover {
      background: #c82333;
      transform: scale(1.05);
    }
    
    .btn-add {
      background: #28a745;
      color: white;
      border: none;
      border-radius: 12px;
      padding: 12px 24px;
      cursor: pointer;
      transition: all 0.3s ease;
      font-weight: 600;
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }
    
    .btn-add:hover {
      background: #218838;
      transform: translateY(-2px);
      box-shadow: 0 4px 12px rgba(40, 167, 69, 0.3);
    }
    
    /* 시간 버튼 */
    .time-buttons {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 10px;
    }
    
    .time-btn {
      padding: 10px 20px;
      border: 2px solid var(--border-color);
      background: transparent;
      color: var(--text-color);
      border-radius: 50px;
      cursor: pointer;
      transition: all 0.3s ease;
      font-size: 0.9rem;
      font-weight: 600;
    }
    
    .time-btn:hover {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
      border-color: transparent;
    }
    
    .time-btn.active {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
      border-color: transparent;
    }
    
    /* 제출 버튼 */
    .submit-section {
      margin-top: 40px;
      padding-top: 30px;
      border-top: 2px solid var(--border-color);
      display: flex;
      gap: 15px;
      justify-content: center;
    }
    
    .btn-submit {
      padding: 15px 50px;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
      border: none;
      border-radius: 50px;
      font-size: 1.1rem;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.3s ease;
      box-shadow: 0 8px 25px rgba(102, 126, 234, 0.4);
    }
    
    .btn-submit:hover {
      transform: translateY(-3px);
      box-shadow: 0 12px 35px rgba(102, 126, 234, 0.5);
    }
    
    .btn-cancel {
      padding: 15px 50px;
      background: transparent;
      color: var(--text-color);
      border: 2px solid var(--border-color);
      border-radius: 50px;
      font-size: 1.1rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.3s ease;
      text-decoration: none;
      display: inline-block;
    }
    
    .btn-cancel:hover {
      background: var(--border-color);
      transform: translateY(-3px);
    }
    
    /* 반응형 */
    @media (max-width: 768px) {
      .page-title {
        font-size: 2rem;
      }
      
      .form-card {
        padding: 25px;
      }
      
      .submit-section {
        flex-direction: column;
      }
      
      .btn-submit, .btn-cancel {
        width: 100%;
      }
    }
  </style>
</head>
<body>
  <!-- 홈 버튼 -->
  <a href="/" class="home-button">
    <span class="home-icon">🏠</span>
    <span>홈</span>
  </a>

  <!-- 다크모드 토글 버튼 -->
  <div class="dark-mode-toggle">
    <button class="toggle-btn" onclick="toggleDarkMode()">
      <span class="toggle-icon" id="themeIcon">🌙</span>
      <span id="themeText">다크</span>
    </button>
  </div>

  <!-- 메인 콘텐츠 -->
  <div class="form-container">
    <!-- 페이지 헤더 -->
    <div class="page-header">
      <h1 class="page-title">➕ 새 여론조사 만들기</h1>
      <p class="page-subtitle">간단한 설정으로 여론조사를 만들어보세요</p>
    </div>

    <!-- 폼 -->
    <div class="form-card">
      <form action="/polls" method="POST" id="poll-form">
        <!-- 기본 정보 -->
        <div class="form-section">
          <h3 class="form-section-title">
            <span>📝</span>
            <span>기본 정보</span>
          </h3>
          
          <div class="mb-3">
            <label for="title" class="form-label">제목 *</label>
            <input 
              type="text" 
              class="form-control" 
              id="title" 
              name="title" 
              placeholder="여론조사 제목을 입력하세요"
              required
            >
          </div>
          
          <div class="mb-3">
            <label for="description" class="form-label">설명</label>
            <textarea 
              class="form-control" 
              id="description" 
              name="description" 
              rows="3"
              placeholder="여론조사에 대한 설명을 입력하세요 (선택사항)"
            ></textarea>
          </div>
        </div>

        <!-- 카테고리 및 태그 -->
        <div class="form-section">
          <h3 class="form-section-title">
            <span>🏷️</span>
            <span>분류</span>
          </h3>
          
          <div class="mb-3">
            <label for="category" class="form-label">카테고리</label>
            <select class="form-select" id="category" name="category">
              <option value="일반">일반</option>
              <option value="정치">정치</option>
              <option value="경제">경제</option>
              <option value="사회">사회</option>
              <option value="문화">문화</option>
              <option value="스포츠">스포츠</option>
              <option value="연예">연예</option>
              <option value="기술">기술</option>
              <option value="게임">게임</option>
              <option value="음식">음식</option>
              <option value="기타">기타</option>
            </select>
          </div>
          
          <div class="mb-3">
            <label for="tags" class="form-label">태그 (최대 5개)</label>
            <input 
              type="text" 
              class="form-control" 
              id="tags" 
              name="tags" 
              placeholder="태그를 쉼표로 구분하여 입력하세요 (예: 음식, 선호도, 인기)"
            >
            <small class="text-muted">쉼표(,)로 구분하여 입력하세요</small>
          </div>
        </div>

        <!-- 투표 옵션 -->
        <div class="form-section">
          <h3 class="form-section-title">
            <span>☑️</span>
            <span>투표 옵션</span>
          </h3>
          
          <div id="options-container">
            <div class="option-item">
              <input type="text" class="form-control" name="options[]" placeholder="옵션 1" required>
            </div>
            <div class="option-item">
              <input type="text" class="form-control" name="options[]" placeholder="옵션 2" required>
            </div>
          </div>
          
          <button type="button" class="btn-add" onclick="addOption()">
            <span>➕</span>
            <span>옵션 추가</span>
          </button>
        </div>

        <!-- 투표 종료 시간 -->
        <div class="form-section">
          <h3 class="form-section-title">
            <span>⏰</span>
            <span>투표 종료 시간 (선택사항)</span>
          </h3>
          
          <div class="time-buttons">
            <button type="button" class="time-btn" onclick="setEndTime(1)">1시간</button>
            <button type="button" class="time-btn" onclick="setEndTime(6)">6시간</button>
            <button type="button" class="time-btn" onclick="setEndTime(24)">1일</button>
            <button type="button" class="time-btn" onclick="setEndTime(72)">3일</button>
            <button type="button" class="time-btn" onclick="setEndTime(168)">1주일</button>
            <button type="button" class="time-btn active" onclick="clearEndTime()">무제한</button>
          </div>
          
          <input type="hidden" id="endDate" name="endDate">
        </div>

        <!-- 제출 버튼 -->
        <div class="submit-section">
          <button type="submit" class="btn-submit">
            🚀 여론조사 만들기
          </button>
          <a href="/polls" class="btn-cancel">
            취소
          </a>
        </div>
      </form>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  
  <script>
    // 다크모드 함수들
    function initDarkMode() {
      const savedTheme = localStorage.getItem('theme') || 'light';
      document.documentElement.setAttribute('data-theme', savedTheme);
      updateThemeIcon(savedTheme);
    }

    function toggleDarkMode() {
      const currentTheme = document.documentElement.getAttribute('data-theme');
      const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
      
      document.documentElement.setAttribute('data-theme', newTheme);
      localStorage.setItem('theme', newTheme);
      updateThemeIcon(newTheme);
    }

    function updateThemeIcon(theme) {
      const icon = document.getElementById('themeIcon');
      const text = document.getElementById('themeText');
      
      if (icon && text) {
        if (theme === 'dark') {
          icon.textContent = '☀️';
          text.textContent = '라이트';
        } else {
          icon.textContent = '🌙';
          text.textContent = '다크';
        }
      }
    }

    // 즉시 다크모드 초기화
    initDarkMode();

    // 옵션 추가
    function addOption() {
      const container = document.getElementById('options-container');
      const optionCount = container.children.length + 1;
      
      if (optionCount > 10) {
        alert('최대 10개까지만 추가할 수 있습니다');
        return;
      }
      
      const div = document.createElement('div');
      div.className = 'option-item';
      div.innerHTML = `
        <input type="text" class="form-control" name="options[]" placeholder="옵션 ${optionCount}" required>
        <button type="button" class="btn-remove" onclick="removeOption(this)">
          🗑️
        </button>
      `;
      
      container.appendChild(div);
    }

    // 옵션 제거
    function removeOption(button) {
      const container = document.getElementById('options-container');
      if (container.children.length <= 2) {
        alert('최소 2개의 옵션이 필요합니다');
        return;
      }
      button.parentElement.remove();
    }

    // 종료 시간 설정
    function setEndTime(hours) {
      const endDate = new Date();
      endDate.setHours(endDate.getHours() + hours);
      document.getElementById('endDate').value = endDate.toISOString();
      
      // 모든 버튼에서 active 제거
      document.querySelectorAll('.time-btn').forEach(btn => btn.classList.remove('active'));
      
      // 클릭한 버튼에 active 추가
      event.target.classList.add('active');
    }

    function clearEndTime() {
      document.getElementById('endDate').value = '';
      
      // 모든 버튼에서 active 제거
      document.querySelectorAll('.time-btn').forEach(btn => btn.classList.remove('active'));
      
      // 무제한 버튼에 active 추가
      event.target.classList.add('active');
    }
  </script>
</body>
</html>