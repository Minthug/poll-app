<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>새 여론조사 만들기</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="/css/style.css">
  
  <style>
    :root {
      --body-bg: #f8f9fa;
      --card-bg: white;
      --text-color: #212529;
      --border-color: #dee2e6;
      --input-bg: white;
      --input-border: #ced4da;
    }
    
    [data-theme="dark"] {
      --body-bg: #1a1a1a;
      --card-bg: #2d2d2d;
      --text-color: #e0e0e0;
      --border-color: #404040;
      --input-bg: #3a3a3a;
      --input-border: #505050;
    }
    
    body {
      background-color: var(--body-bg);
      color: var(--text-color);
      transition: all 0.3s ease;
    }
    
    .card {
      background-color: var(--card-bg);
      color: var(--text-color);
      border-color: var(--border-color);
      transition: all 0.3s ease;
    }
    
    .form-control, .form-control:focus, .form-select, .form-select:focus {
      background-color: var(--input-bg);
      color: var(--text-color);
      border-color: var(--input-border);
    }
    
    .form-label {
      color: var(--text-color);
    }
    
    [data-theme="dark"] .card-header {
      background-color: #0d6efd !important;
      border-bottom-color: #404040;
    }
    
    .dark-mode-toggle {
      position: fixed;
      top: 20px;
      right: 20px;
      z-index: 1050;
    }
    
    .toggle-btn {
      background-color: var(--card-bg);
      border: 2px solid var(--border-color);
      border-radius: 50px;
      padding: 8px 15px;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 8px;
      box-shadow: 0 2px 5px rgba(0,0,0,0.2);
      color: var(--text-color);
      transition: all 0.3s ease;
    }
    
    .toggle-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 4px 8px rgba(0,0,0,0.3);
    }
    
    .toggle-icon {
      font-size: 20px;
    }

    .preset-btn {
      margin-right: 5px;
      margin-bottom: 5px;
    }
  </style>
</head>
<body>
  <!-- 다크모드 토글 버튼 -->
  <div class="dark-mode-toggle">
    <button class="toggle-btn" onclick="toggleDarkMode()">
      <span class="toggle-icon" id="themeIcon">🌙</span>
      <span id="themeText">다크</span>
    </button>
  </div>

  <div class="container mt-4">
    <div class="card shadow">
      <div class="card-header bg-primary text-white">
        <h1 class="h3 mb-0">새 여론조사 만들기</h1>
      </div>
      
      <div class="card-body">
        <form action="/polls" method="POST">
          <div class="mb-3">
            <label for="title" class="form-label">제목</label>
            <input type="text" class="form-control" id="title" name="title" required>
          </div>
          
          <div class="mb-3">
            <label for="description" class="form-label">설명 (선택사항)</label>
            <textarea class="form-control" id="description" name="description" rows="3"></textarea>
          </div>

          <!-- 투표 종료 시간 설정 -->
           <div class="mb-3">
            <label class="form-label">투표 종료 시간 (선택사항)</label>
            <div class="d-flex flex-wrap gap-2">
              <button type="button" class="btn btn-outline-secondary" onclick="setEndTime(1)">1시간 후</button>
              <button type="button" class="btn btn-outline-secondary" onclick="setEndTime(6)">6시간 후</button>
              <button type="button" class="btn btn-outline-secondary" onclick="setEndTime(24)">1일 후</button>
              <button type="button" class="btn btn-outline-secondary" onclick="setEndTime(72)">3일 후</button>
              <button type="button" class="btn btn-outline-secondary" onclick="setEndTime(168)">1주일 후</button>
              <button type="button" class="btn btn-outline-danger" onclick="clearEndTime()">무제한</button>
            </div>
            <input type="hidden" id="endDate" name="endDate">
            <small class="text-muted d-block mt-2">
              <span id="endTimeDisplay">종료 시간이 설정되지 않았습니다 (무제한)</span>
            </small>
          </div>
          
          <div class="mb-3">
            <label class="form-label">투표 옵션</label>
            <div id="options-container">
              <div class="input-group mb-2">
                <input type="text" class="form-control" name="options[]" placeholder="옵션 1" required>
              </div>
              <div class="input-group mb-2">
                <input type="text" class="form-control" name="options[]" placeholder="옵션 2" required>
              </div>
            </div>
            <button type="button" id="add-option" class="btn btn-sm btn-outline-secondary mt-2">옵션 추가</button>
          </div>
          
          <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">여론조사 생성</button>
            <a href="/polls" class="btn btn-outline-secondary">취소</a>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  
  <script>
    // 다크모드 함수들 (맨 위에 배치)
    function initDarkMode() {
      const savedTheme = localStorage.getItem('theme') || 'light';
      document.documentElement.setAttribute('data-theme', savedTheme);
      updateThemeIcon(savedTheme);
    }

    function toggleDarkMode() {
      const currentTheme = document.documentElement.getAttribute('data-theme');
      const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
      
      document.documentElement.setAttribute('data-theme', newTheme);
      localStorage.setItem('theme', newTheme);
      updateThemeIcon(newTheme);
    }

    function updateThemeIcon(theme) {
      const icon = document.getElementById('themeIcon');
      const text = document.getElementById('themeText');
      
      if (icon && text) {
        if (theme === 'dark') {
          icon.textContent = '☀️';
          text.textContent = '라이트';
        } else {
          icon.textContent = '🌙';
          text.textContent = '다크';
        }
      }
    }

    // 종료 시간 설정 함수
    function setEndTime(hours) {
      const now = new Date();
      now.setHours(now.getHours() + hours);
      
      // datetime-local 형식으로 변환 (YYYY-MM-DDTHH:MM)
      const year = now.getFullYear();
      const month = String(now.getMonth() + 1).padStart(2, '0');
      const day = String(now.getDate()).padStart(2, '0');
      const hour = String(now.getHours()).padStart(2, '0');
      const minute = String(now.getMinutes()).padStart(2, '0');
      
      const formatted = `${year}-${month}-${day}T${hour}:${minute}`;
      document.getElementById('endDate').value = formatted;

      const displayDate = `${year}년 ${month}월 ${day}일 ${hour}시 ${minute}분`;
      document.getElementById('endTimeDisplay').textContent = `종료 시간: ${displayDate}`;

      document.querySelectorAll('.btn-outline-secondary, .btn-outline-danger').forEach(btn => {
        btn.classList.remove('active');
      });
      event.target.classList.add('active');
    }

    function clearEndTime() {
      document.getElementById('endDate').value = '';
      document.getElementById('endTimeDisplay').textContent = '종료 시간이 설정되지 않았습니다 (무제한)';
    
      // 선택한 버튼 강조
      document.querySelectorAll('.btn-outline-secondary, .btn-outline-danger').forEach(btn => {
        btn.classList.remove('active');
      });
      event.target.classList.add('active');
    }

    // 즉시 다크모드 초기화
    initDarkMode();

    // 옵션 추가 기능
    document.addEventListener('DOMContentLoaded', () => {
      const optionsContainer = document.getElementById('options-container');
      const addOptionBtn = document.getElementById('add-option');
      
      addOptionBtn.addEventListener('click', () => {
        const newOption = document.createElement('div');
        newOption.className = 'input-group mb-2';
        
        const count = optionsContainer.children.length + 1;
        
        newOption.innerHTML = `
          <input type="text" class="form-control" name="options[]" placeholder="옵션 ${count}" required>
          <button class="btn btn-outline-danger" type="button" onclick="this.parentNode.remove()">삭제</button>
        `;
        
        optionsContainer.appendChild(newOption);
      });
    });
  </script>
</body>
</html>