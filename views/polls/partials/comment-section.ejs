<!-- ========================================
     댓글 섹션
     ======================================== -->
<div class="card mt-4">
  <div class="card-header d-flex justify-content-between align-items-center">
    <h5 class="mb-0"> 💬 댓글 <span class="badge bg-secondary" id="commentCountBadge"><%= poll.commentCount || 0 %></span>
    </h5>
  </div>

  <div class="card-body">
    <!-- 댓글 작성 폼 -->
     <div class="mb-4">
      <form id="commentForm">
        <div class="mb-3">
          <textarea class="form-control" id="commentContent" rows="3" placeholder="댓글을 입력하세요. . . (최대 1000자)"
          maxlength="1000" required></textarea>
          <small class="text-mutd">
            <span id="charCount">0</span> / 1000자
          </small>
        </div>

        <div class="d-flex justify-content-between align-items-center">
          <div class="form-check" id="annoymousCheckContainer" style="display: none;">
            <input class="form-check-input" type="checkbox" id="commentAnonymous">
            <label class="form-check-label" for="commentAnonymous">익명으로 작성</label>
          </div>

          <div id="loginPrompt">
            <small class="text-muted">로그인하지 않은 경우 자동으로 익명으로 작성됩니다</small>
          </div>
          <button type="submit" class="btn btn-primary">댓글 작성</button>
        </div>
      </form>
     </div>

     <hr>

     <!-- 댓글 목록-->
      <div id="commentList">
        <div class="text-center py-4">
          <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">로딩 중...</span>
          </div>
        </div>
      </div>

      <!-- 더 보기 버튼-->
       <div class="text-center mt-3" id="loadMoreContainer" style="display: none;">
        <button class="btn btn-outline-secondary" id="loadMoreBtn">더보기</button>
    </div>
  </div>
</div>

<style>
    /*댓글*/
.comment-item {
  padding: 15px;
  border-bottom: 1px solid #e9ecef;
  transition: background-color 0.2s;
}

.comment-item:hover {
  background-color: #f8f9fa;
}

.comment-item:last-child {
  border-bottom: none;
}

.comment-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8px;
}

.comment-author {
  font-weight: 600;
  color: #333;
}

.comment-author.anonymous {
  color: #6c757d;
}

.comment-author.creator {
  color: #0d6efd;
}

.creator-badge {
  font-size: 0.75rem;
  margin-left: 5px;
  padding: 2px 6px;
}

.comment-content {
  color: #495057;
  white-space: pre-wrap;
  word-break: break-word;
}

.comment-meta {
  font-size: 0.875rem;
  color: #6c757d;
}

.comment-actions {
  display: flex;
  gap: 10px;
}

.comment-actions button {
  font-size: 0.875rem;
  padding: 2px 8px;
}

</style>