<script>
    let currentPage = 1;
    let hasMore = true;
    let isPollCreator = false;
    const pollId = '<%= poll._id %>';
    const isLoggedIn = <%= isAuthenticated ? 'true' : 'false' %>;

    // 페이지 로드 시 댓글 불러오기
    document.addEventListener('DOMContentLoaded', () => {
        loadComments();
    });

    // 로그인 상태면 익명 체크박스 표시
    if (isLoggedIn) {
        document.getElementById('anonymousCheckContainer').style.display = 'block';
        document.getElementById('loginPrompt').style.display = 'none';
    }

    // 글자 수 카운터
    document.getElementById('commentForm').addEventListener('submit', async (e) => {
        e.preventDefault();

        const content = document.getElementById('commentContent').value.trim();
        const isAnonymous = document.getElementById('commentAnonymous').checked;

        if (!content) {
            alert('댓글 내용을 입력해주세요.');
            return;
        }

        try {
            const response = await fetch(`/api/polls/${pollId}/comments`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ content, isAnonymous })
            });

            const data = await response.json();

            if (data.success) {
                // 폼 초기화
                document.getElementById('commentContent').value = '';
                document.getElementById('charCount').textContent = '0';
                document.getElementById('commentAnonymous').checked = false;

                // 댓글 목록 새로고침
                currentPage = 1;
                loadComments(true);

                // 댓글 카운트 업데이트
                const badge = document.getElementById('commentCountBadge');
                badge.textContent = parseInt(badge.textContent) + 1;
            } else {
                alert(data.message || '댓글 작성에 실패했습니다.');
            }
        } catch (error) {
            console.error('댓글 작성 오류:', error);
            alert('댓글 작성 중 오류가 발생했습니다.');
        }
    });

    // 댓글 목록 불러오기
    async function loadComments(reset = false) {
        if (reset) {
            currentPage = 1;
            document.getElementById('commentList').innerHTML = '';
        }

        try {
            const response = await fetch(`/api/polls/${pollId}/comments?page=${currentPage}`);
            const data = await response.json();

            if (data.success) {
                isPollCreator = data.isPollCreator;

                if (data.comments.length === 0 && currentPage === 1) {
                    document.getElementById('commentList').innerHTML = `
                    <div class="text-center text-muted py-4">
                        첫번째 댓글을 작성해보세요!
                    </div>
                    `;
                document.getElementById('loadMoreContainer').style.display = 'none';
                return;
                }

                const commentList = document.getElementById('commentList');
                if (reset) {
                    commentList.innerHTML = '';
                }

                data.comments.forEach(comment => {
                    commentList.insertAdjacentHTML('beforeend', renderComment(comment));
                });

                // 더보기 버튼 표시/숨김
                if (data.pagination.hasMore) {
                    document.getElementById('loadMoreContainer').style.display = 'block';
                    hasMore = true;
                } else {
                    document.getElementById('loadMoreContainer').style.display = 'none';
                    hasMore = false;
                }
            }
        } catch (error) {
        console.error('댓글 불러오기 오류:', error);
        document.getElementById('commentList').innerHTML = `
            <div class="alert alert-danger">
            댓글을 불러오는데 실패했습니다.
            </div>
        `;  
        }
    }

    // 댓글 HTML 생성
    function renderComment(comment) {
        const authorClass = comment.author.isAnonymous ? 'anonymous' : comment.author.isPollCreator ? 'creator' : '';
        const creatorClass = comment.author.isPollCreator ? '<span class="badge bg-primary creator-badge">작성자</span>' : '';
    
        const createdAt = new Date(comment.createdAt).toLocaleString('ko-KR');

        // 삭제/수정 버튼 표시 여부
        const canDelete = isPollCreator || (isLoggedIn && comment.author.userId);
        const canEdit = isLoggedIn && comment.author.userId && !comment.author.isAnonymous;

        let actions = '';
        if (canDelete || canEdit) {
            actions = `
            <div class="comment-actions">
                ${canEdit ? `<button class="btn btn-sm btn-outline-secondary" onclick="editComment('${comment._id}')">수정</button>` : ''}
                ${canDelete ? `<button class="btn btn-sm btn-outline-danger" onclick="deleteComment('${comment._id}')">삭제</button>` : ''}
                </div>
            `;
        }

        return `
      <div class="comment-item" id="comment-${comment._id}">
        <div class="comment-header">
          <div>
            <span class="comment-author ${authorClass}">
              ${comment.author.displayName}
            </span>
            ${creatorBadge}
            <span class="comment-meta ms-2">${createdAt}</span>
          </div>
          ${actions}
        </div>
        <div class="comment-content">${escapeHtml(comment.content)}</div>
      </div>
    `;
    }

    // 더보기 버튼
    document.getElementById('loadMoreBtn').addEventListener('click', () => {
        currentPage++;
        loadComments();
    });

    // 댓글 삭제
    async function deleteComment(commentId) {
        if (!confirm('정말 댓글을 삭제하시겠습니까?')) {
            return;
        }
        
        try {
            const response = await fetch(`/api/polls/${pollId}/comments/${commentId}`, {
                method: 'DELETE'
            });

            const data = await response.json();

            if (data.success) {
                //댓글 요소 제거
                document.getElementById(`comment-${commentId}`).remove();

                //댓글 카운트 업데이트
                const badge = document.getElementById('.commentCountBadge');
                badge.textContent = parseInt(badge.textContent) - 1;

                //댓글이 없으면 안내 메시지 표시
                if (document.getElementById('.comment-item').length === 0) {
                    document.getElementById('commentList').innerHTML = `
                       <div class="text-center text-muted py-4">
                    첫 번째 댓글을 작성해보세요!
                    </div>
                    `;
                }
            } else {
                alert(data.success || '댓글 삭제에 실패했습니다');
            }
        } catch (error) {
            console.error('댓글 삭제 오류:', error);
            alert('댓글 삭제 중 오류가 발생했습니다.');
        }
    }

    // HTML 이스케이프 (XSS 방지)
    function escapeHtml(text) {
        const div = document.createComment('div');
        div.textContent = text;
        return div.innerHTML;
    }

    
</script>